---
const year = new Date().getFullYear();

const socialLinks = {
  instagram: 'https://www.instagram.com/salt_and_sun_tours/',
  facebook: 'https://www.facebook.com/share/1QJ556S6SA/?mibextid=wwXIfr',
  tiktok: 'https://www.tiktok.com/@salt.and.sun.tours?_r=1&_t=ZS-9AJ9PtZkNfg',
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">
        <svg class="site-footer__mark" viewBox="0 0 40 40" aria-hidden="true">
          <defs>
            <clipPath id="footer-mark-clip">
              <circle cx="20" cy="20" r="19" />
            </clipPath>
          </defs>
          <g clip-path="url(#footer-mark-clip)">
            <rect x="0" y="0" width="40" height="20" fill="#d1754a" />
            <!-- Reflection lines: same tapering-chord mark as the header
                 (src/components/Header.astro) — kept in sync by hand
                 since this is a second, standalone copy of the SVG. -->
            <rect x="1.11" y="22" width="37.79" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="1.54" y="24.5" width="36.92" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="2.34" y="27" width="35.33" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="3.55" y="29.5" width="32.91" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="5.27" y="32" width="29.46" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="7.72" y="34.5" width="24.56" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="11.51" y="37" width="16.97" height="1.3" rx="0.65" fill="#8b6762" />
          </g>
        </svg>
        Salt and Sun Tours
      </p>
      <p class="site-footer__tagline">Where Life and Light Meet Adventure</p>

      <ul class="site-footer__social">
        <li>
          <a
            class="site-footer__social-link site-footer__social-link--instagram"
            href={socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salt and Sun Tours on Instagram"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.914-.0564 1.2775-.0689 1.6882-.0626 4.947.0062 3.2586.0206 3.6671.0825 4.9473.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.295 1.6361.4961 2.9134.552 1.2773.056 1.6884.069 4.9462.0627 3.2578-.0062 3.668-.0207 4.9478-.0814 1.28-.0607 2.147-.2652 2.9098-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6898.063-4.948-.0063-3.2583-.021-3.6668-.0817-4.9465-.0607-1.2797-.264-2.1487-.5633-2.9117-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.236-.005 11.977.0014 8.718.0076 8.31.0215 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6442-.079-4.848-.007-3.2037.0053-3.583.0607-4.848.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4188-.4217.8184-.6814 1.3783-.9003.423-.1651 1.0575-.3614 2.227-.4171 1.2655-.06 1.6447-.072 4.848-.079 3.2033-.007 3.5835.005 4.8495.0608 1.169.0508 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3787.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.645.0796 4.848.0058 3.203-.0055 3.5834-.061 4.848-.051 1.17-.245 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6448.072-4.8493.079-3.2045.007-3.5825-.006-4.848-.0608M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.173 6.1493 3.4026-.0065 6.157-2.7701 6.1506-6.1733-.0065-3.4032-2.771-6.1565-6.174-6.1498-3.403.0067-6.156 2.771-6.1496 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A3.9996 3.9996 0 0 1 8 12.0077" />
            </svg>
          </a>
        </li>
        <li>
          <a
            class="site-footer__social-link site-footer__social-link--facebook"
            href={socialLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salt and Sun Tours on Facebook"
          >
            <svg viewBox="0 0 320 512" fill="currentColor" aria-hidden="true">
              <path d="M80 299.3l0 212.7 116 0 0-212.7 86.5 0 18-97.8-104.5 0 0-34.6c0-51.7 20.3-71.5 72.7-71.5 16.3 0 29.4 .4 37 1.2l0-88.7C291.4 4 256.4 0 236.2 0 129.3 0 80 50.5 80 159.4l0 42.1-66 0 0 97.8 66 0z" />
            </svg>
          </a>
        </li>
        <li>
          <a
            class="site-footer__social-link site-footer__social-link--tiktok"
            href={socialLinks.tiktok}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salt and Sun Tours on TikTok"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z" />
            </svg>
          </a>
        </li>
      </ul>

      <img
        class="site-footer__badge"
        src="/images/namibia-tourism-board-badge.png"
        alt="Namibia Tourism Board — Registered"
        loading="lazy"
        decoding="async"
        width="72"
        height="72"
      />
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/tours">Tours</a></li>
        <li><a href="/adventures">Adventures</a></li>
        <li><a href="/journeys">Journeys</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/booking">Booking</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <p>
        <a href="tel:+264818242282">+264 81 824 2282</a><br />
        <a href="tel:+264817540940">+264 81 754 0940</a>
      </p>
      <p><a href="mailto:bookings@saltandsuntours.com.na">bookings@saltandsuntours.com.na</a></p>
      <p>1st Street East, Walvis Bay, Namibia</p>
      <p>&copy; {year} Salt and Sun Tours. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Dusk gradient: terracotta brightening to ochre at the logo/nav
       columns, then dimming into the brand doc's "Driftwood Ink" dark
       brown-black by the contact column — not a return to the old flat
       charcoal, but a deliberate dark anchor instead of fading to white.
       --color-text (dark) covers the brand/nav columns over the warm
       stops; .site-footer__meta overrides back to light text for the
       dark stop it sits on (see below). */
    background: linear-gradient(
      135deg,
      var(--color-terracotta-600) 0%,
      var(--color-ochre-400) 42%,
      #4a3b33 72%,
      #3a2f29 100%
    );
    color: var(--color-text);
    margin-top: 0;
  }

  .site-footer__inner {
    /* Wider than the site's standard .container so the brand name sits
       closer to the page's true left edge — the usual spot for a
       footer's company name/logo — instead of inheriting the main
       content column's wider centering margin. */
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: var(--space-md);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .site-footer__logo {
    /* Same wordmark treatment as .site-header__logo — the Besley serif
       from the brand refresh concept, not the sitewide display font, plus
       the same refined sun mark so the footer's lockup matches the
       header's rather than falling back to plain text. */
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: "Besley", Georgia, "Times New Roman", serif;
    font-weight: 600;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__mark {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .site-footer__tagline {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  /* Matches the footer's own palette rather than each app's brand colors
     — a single consistent tone (the same one the logo/tagline/nav use
     in this column) instead of three different badge colors competing
     with the rest of the brand column. */
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid rgba(58, 35, 28, 0.3);
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social a:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  /* height-only, not a fixed square: the Facebook glyph's own viewBox
     isn't square (it's just the bare "f" mark, no circle backing), so
     constraining both axes would squash it — letting width track the
     viewBox's own aspect ratio keeps every glyph undistorted. */
  .site-footer__social svg {
    width: auto;
    height: 1.1rem;
  }

  .site-footer__badge {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    margin-top: var(--space-md);
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  /* Same display font as the header's nav links — previously these
     inherited the plain body font, so the footer's nav read as a
     different typographic voice from the rest of the site's navigation. */
  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .site-footer__nav a:hover {
    color: var(--color-accent-strong);
  }

  .site-footer__meta {
    /* This column lands on the gradient's dark Driftwood Ink end, so it
       overrides back to light-on-dark rather than inheriting the dark
       text the brand/nav columns use over the warm stops. */
    font-size: var(--fs-sm);
    color: var(--color-sand-200);
  }

  .site-footer__meta p {
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__meta a {
    text-decoration: none;
    color: var(--color-text-on-dark);
  }

  .site-footer__meta a:hover {
    color: var(--color-ochre-400);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
