---
const year = new Date().getFullYear();

// TODO(Jana): no real Facebook URL exists anywhere in the site's content
// or config yet — swap this placeholder string for the real profile URL
// once you have it. Nothing else needs to change.
const socialLinks = {
  instagram: 'https://www.instagram.com/salt_and_sun_tours/',
  facebook: '#',
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">
        <svg class="site-footer__mark" viewBox="0 0 40 40" aria-hidden="true">
          <defs>
            <clipPath id="footer-mark-clip">
              <circle cx="20" cy="20" r="19" />
            </clipPath>
          </defs>
          <g clip-path="url(#footer-mark-clip)">
            <rect x="0" y="0" width="40" height="20" fill="#d1754a" />
            <!-- Reflection lines: same tapering-chord mark as the header
                 (src/components/Header.astro) — kept in sync by hand
                 since this is a second, standalone copy of the SVG. -->
            <rect x="1.11" y="22" width="37.79" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="1.54" y="24.5" width="36.92" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="2.34" y="27" width="35.33" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="3.55" y="29.5" width="32.91" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="5.27" y="32" width="29.46" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="7.72" y="34.5" width="24.56" height="1.3" rx="0.65" fill="#8b6762" />
            <rect x="11.51" y="37" width="16.97" height="1.3" rx="0.65" fill="#8b6762" />
          </g>
        </svg>
        Salt and Sun Tours
      </p>
      <p class="site-footer__tagline">Where Life and Light Meet Adventure</p>

      <ul class="site-footer__social">
        <li>
          <a
            href={socialLinks.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salt and Sun Tours on Instagram"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a
            href={socialLinks.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Salt and Sun Tours on Facebook"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M14.5 21v-7.5h2.5l.4-3H14.5V8.4c0-.87.24-1.46 1.5-1.46h1.6V4.35C17.3 4.24 16.35 4 15.25 4c-2.3 0-3.87 1.4-3.87 3.97V10.5H9v3h2.38V21z" />
            </svg>
          </a>
        </li>
      </ul>

      <img
        class="site-footer__badge"
        src="/images/namibia-tourism-board-badge.png"
        alt="Namibia Tourism Board — Registered"
        loading="lazy"
        decoding="async"
        width="72"
        height="72"
      />
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/tours">Tours</a></li>
        <li><a href="/adventures">Adventures</a></li>
        <li><a href="/journeys">Journeys</a></li>
        <li><a href="/gallery">Gallery</a></li>
        <li><a href="/booking">Booking</a></li>
        <li><a href="/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <p>
        <a href="tel:+264817540940">+264 81 754 0940</a><br />
        <a href="tel:+264818242282">+264 81 824 2282</a>
      </p>
      <p><a href="mailto:bookings@saltandsuntours.com.na">bookings@saltandsuntours.com.na</a></p>
      <p>1st Street East, Walvis Bay, Namibia</p>
      <p>&copy; {year} Salt and Sun Tours. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Orange-to-white brand gradient, richest over the logo in the top
       left and settling to plain sand by the nav/contact columns — keeps
       the bulk of the footer's text on a near-white base for contrast
       rather than washing the whole bar in saturated orange. */
    background: linear-gradient(
      135deg,
      var(--color-terracotta-500) 0%,
      var(--color-ochre-400) 26%,
      var(--color-sand-50) 62%
    );
    color: var(--color-text);
    margin-top: 0;
  }

  .site-footer__inner {
    /* Wider than the site's standard .container so the brand name sits
       closer to the page's true left edge — the usual spot for a
       footer's company name/logo — instead of inheriting the main
       content column's wider centering margin. */
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: var(--space-md);
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .site-footer__logo {
    /* Same wordmark treatment as .site-header__logo — the Besley serif
       from the brand refresh concept, not the sitewide display font, plus
       the same refined sun mark so the footer's lockup matches the
       header's rather than falling back to plain text. */
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: "Besley", Georgia, "Times New Roman", serif;
    font-weight: 600;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__mark {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .site-footer__tagline {
    color: var(--color-text-muted);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid rgba(58, 35, 28, 0.3);
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social a:hover {
    color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .site-footer__social svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .site-footer__badge {
    display: block;
    width: 4.5rem;
    height: 4.5rem;
    margin-top: var(--space-md);
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  /* Same display font as the header's nav links — previously these
     inherited the plain body font, so the footer's nav read as a
     different typographic voice from the rest of the site's navigation. */
  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-text);
    font-size: var(--fs-sm);
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .site-footer__nav a:hover {
    color: var(--color-accent-strong);
  }

  .site-footer__meta {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }

  .site-footer__meta p {
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__meta a {
    text-decoration: none;
    color: var(--color-text);
  }

  .site-footer__meta a:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
