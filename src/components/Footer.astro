---
const year = new Date().getFullYear();

const bgImageUrl =
  'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600';
const bgImageCredit = { name: 'Arthur Souquet', username: 'arthursouquet' };
---

<footer class="site-footer" style={`--footer-image: url(${bgImageUrl});`}>
  <div class="site-footer__bg" aria-hidden="true"></div>

  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Salt &amp; Sun Tours</p>
      <p class="site-footer__tagline">Wildlife, desert, and coast — one Namibian story.</p>
    </div>

    <svg
      class="site-footer__divider"
      viewBox="0 0 1200 40"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path d="M0 30 Q 100 6, 200 24 T 400 20 T 600 28 T 800 14 T 1000 26 T 1200 18" />
    </svg>

    <div class="site-footer__columns">
      <nav class="site-footer__nav" aria-label="Footer">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/tours">Tours</a></li>
          <li><a href="/booking">Booking</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <div class="site-footer__meta">
        <p>
          <a href="tel:+264817540940">+264 81 754 0940</a><br />
          <a href="tel:+264818242282">+264 81 824 2282</a>
        </p>
        <p><a href="mailto:bookings@saltandsuntours.com.na">bookings@saltandsuntours.com.na</a></p>
        <p>1st Street East, Walvis Bay, Namibia</p>
        <p>&copy; {year} Salt &amp; Sun Tours. All rights reserved.</p>
      </div>
    </div>

    <p class="site-footer__credit">
      Photo:{' '}
      <a
        href={`https://unsplash.com/@${bgImageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {bgImageCredit.name}
      </a>{' '}
      /{' '}
      <a
        href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
        target="_blank"
        rel="noopener noreferrer"
      >
        Unsplash
      </a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    color: var(--color-text-on-dark);
    margin-top: var(--space-2xl);
    overflow: hidden;
  }

  .site-footer__bg {
    position: absolute;
    inset: 0;
    background-image: var(--footer-image, none);
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-900);
  }

  .site-footer__bg::before {
    /* Heavily darkened so the photo reads as texture/mood rather than a
       competing image — the page "returning to the wild" at the very
       bottom, echoing the hero panels without fighting the footer copy. */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.55) 0%,
      rgba(31, 18, 14, 0.75) 100%
    );
  }

  .site-footer__inner {
    position: relative;
    z-index: 1;
    padding-block: var(--space-xl);
  }

  .site-footer__brand {
    margin-bottom: var(--space-lg);
  }

  .site-footer__logo {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__tagline {
    color: var(--color-sand-200);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .site-footer__divider {
    display: block;
    width: 100%;
    height: 28px;
    margin-bottom: var(--space-lg);
    fill: none;
    stroke: rgba(211, 162, 79, 0.45);
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  .site-footer__columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-sand-100);
    font-size: var(--fs-sm);
  }

  .site-footer__nav a:hover {
    color: var(--color-ochre-400);
  }

  .site-footer__meta {
    font-size: var(--fs-sm);
    color: var(--color-sand-200);
  }

  .site-footer__meta p {
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__meta a {
    text-decoration: none;
  }

  .site-footer__meta a:hover {
    color: var(--color-ochre-400);
    text-decoration: underline;
  }

  .site-footer__credit {
    margin: var(--space-lg) 0 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.5);
  }

  .site-footer__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer__credit a:hover {
    color: var(--color-text-on-dark);
  }

  @media (max-width: 640px) {
    .site-footer__columns {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
