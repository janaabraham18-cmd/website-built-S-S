---
const year = new Date().getFullYear();

// TODO(Jana): no real Instagram/Facebook URLs exist anywhere in the site's
// content or config yet — swap these two placeholder strings for the real
// profile URLs once you have them. Nothing else needs to change.
const socialLinks = {
  instagram: '#',
  facebook: '#',
};
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Salt &amp; Sun Tours</p>
      <p class="site-footer__tagline">Where Life and Light Meet Adventure</p>

      <ul class="site-footer__social">
        <li>
          <a href={socialLinks.instagram} aria-label="Salt & Sun Tours on Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4.2" />
              <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
            </svg>
          </a>
        </li>
        <li>
          <a href={socialLinks.facebook} aria-label="Salt & Sun Tours on Facebook">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <path d="M14.5 21v-7.5h2.5l.4-3H14.5V8.4c0-.87.24-1.46 1.5-1.46h1.6V4.35C17.3 4.24 16.35 4 15.25 4c-2.3 0-3.87 1.4-3.87 3.97V10.5H9v3h2.38V21z" />
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/tours">Tours</a></li>
        <li><a href="/booking">Booking</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <p>
        <a href="tel:+264817540940">+264 81 754 0940</a><br />
        <a href="tel:+264818242282">+264 81 824 2282</a>
      </p>
      <p><a href="mailto:bookings@saltandsuntours.com.na">bookings@saltandsuntours.com.na</a></p>
      <p>1st Street East, Walvis Bay, Namibia</p>
      <p>&copy; {year} Salt &amp; Sun Tours. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-earth-900);
    color: var(--color-text-on-dark);
    margin-top: var(--space-2xl);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .site-footer__logo {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__tagline {
    color: var(--color-sand-200);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    margin: var(--space-md) 0 0;
    padding: 0;
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 1px solid rgba(251, 247, 241, 0.3);
    color: var(--color-sand-100);
    transition: color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .site-footer__social a:hover {
    color: var(--color-ochre-400);
    border-color: var(--color-ochre-400);
  }

  .site-footer__social svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-sand-100);
    font-size: var(--fs-sm);
  }

  .site-footer__nav a:hover {
    color: var(--color-ochre-400);
  }

  .site-footer__meta {
    font-size: var(--fs-sm);
    color: var(--color-sand-200);
  }

  .site-footer__meta p {
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__meta a {
    text-decoration: none;
  }

  .site-footer__meta a:hover {
    color: var(--color-ochre-400);
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
