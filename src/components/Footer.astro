---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__logo">Wayfarer&nbsp;Tours</p>
      <p class="site-footer__tagline">Placeholder tagline goes here.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/booking">Booking</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>

    <div class="site-footer__meta">
      <p>hello@example.com</p>
      <p>&copy; {year} Wayfarer Tours. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-earth-900);
    color: var(--color-text-on-dark);
    margin-top: var(--space-2xl);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
  }

  .site-footer__logo {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-2xs);
  }

  .site-footer__tagline {
    color: var(--color-sand-200);
    font-size: var(--fs-sm);
    margin: 0;
  }

  .site-footer__nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .site-footer__nav a {
    text-decoration: none;
    color: var(--color-sand-100);
    font-size: var(--fs-sm);
  }

  .site-footer__nav a:hover {
    color: var(--color-ochre-400);
  }

  .site-footer__meta {
    font-size: var(--fs-sm);
    color: var(--color-sand-200);
  }

  .site-footer__meta p {
    margin: 0 0 var(--space-2xs);
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
