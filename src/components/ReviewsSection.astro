---
interface Review {
  quote: string;
  name: string;
  detail?: string;
  rating?: number;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  reviews?: Review[];
  id?: string;
}

const {
  eyebrow = 'Traveler stories',
  heading = 'What our guests say',
  reviews = [
    {
      quote:
        'Placeholder review copy describing a memorable moment from the trip. Real testimonials will replace this once collected.',
      name: 'Placeholder Name',
      detail: 'Placeholder Tour, 2025',
      rating: 5,
    },
    {
      quote:
        'Placeholder review copy focused on the guide or group experience. Swap in a real quote later.',
      name: 'Placeholder Name',
      detail: 'Placeholder Tour, 2025',
      rating: 5,
    },
    {
      quote:
        'Placeholder review copy about logistics, comfort, or value for money.',
      name: 'Placeholder Name',
      detail: 'Placeholder Tour, 2024',
      rating: 4,
    },
  ],
  id,
} = Astro.props;

function initials(name: string) {
  return name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<section id={id} class="reviews reveal">
  <div class="container">
    <div class="reviews__intro reveal-item">
      <p class="reviews__eyebrow">{eyebrow}</p>
      <h2 class="reviews__heading">{heading}</h2>
    </div>

    <ul class="reviews__track">
      {
        reviews.map((review) => (
          <li class="review-card reveal-item">
            <div class="review-card__rating" aria-label={`${review.rating ?? 5} out of 5 stars`}>
              {Array.from({ length: 5 }).map((_, i) => (
                <svg
                  class:list={['star', i < (review.rating ?? 5) && 'star--filled']}
                  viewBox="0 0 20 20"
                  aria-hidden="true"
                >
                  <path d="M10 1.5l2.6 5.6 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6L1.4 7.8l6-.7z" />
                </svg>
              ))}
            </div>

            <p class="review-card__quote">&ldquo;{review.quote}&rdquo;</p>

            <div class="review-card__author">
              <span class="review-card__avatar" aria-hidden="true">
                {initials(review.name)}
              </span>
              <div>
                <p class="review-card__name">{review.name}</p>
                {review.detail && (
                  <p class="review-card__detail">{review.detail}</p>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .reviews {
    padding-block: var(--space-2xl);
  }

  .reviews__intro {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-xl);
  }

  .reviews__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .reviews__heading {
    margin: 0;
  }

  .reviews__track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .review-card__rating {
    display: flex;
    gap: 2px;
  }

  .star {
    width: 1rem;
    height: 1rem;
    fill: var(--color-border);
  }

  .star--filled {
    fill: var(--color-accent-soft);
  }

  .review-card__quote {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-text);
    margin: 0;
    flex-grow: 1;
  }

  .review-card__author {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
  }

  .review-card__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--gradient-warm);
    color: var(--color-text-on-dark);
    font-size: var(--fs-xs);
    font-weight: 600;
  }

  .review-card__name {
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-sm);
  }

  .review-card__detail {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .reviews__track {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
