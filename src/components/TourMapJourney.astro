---
// Full-bleed hero leads straight into 7 ordinary (non-pinned) sections,
// one per tour, each fading in via the sitewide .reveal/.reveal-item
// scroll pattern as it's scrolled to — no scroll-jacking, no pinning.
// Each section shows a dominant photo beside a small "piece" of the
// Namibia map: a fixed-size crop of the exact same NamibiaMap
// coordinate system centered on that tour's pin, so the pieces are all
// consistently scaled/oriented (only panned, never rotated) and would
// line up into one real map if you set them side by side in order. A
// closing recap section shows the complete map with all 7 pins plus a
// small auto-cycling photo slideshow of the 7 tours.
import { tours } from '../data/tours';
import { mapJourney } from '../data/tourRegions';
import NamibiaMap from './NamibiaMap.astro';

const heroImage = {
  url: 'https://images.unsplash.com/photo-1489493887464-892be6d1daae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Ondrej Machart', username: 'ondrejmachart' },
  alt: 'Aerial view of the Namib desert dunes meeting the Atlantic coastline',
};

const stopsWithTours = mapJourney.map((pin) => {
  const tour = tours.find((t) => t.slug === pin.slug);
  return { pin, tour };
}).filter((s): s is { pin: typeof mapJourney[number]; tour: NonNullable<typeof s.tour> } => !!s.tour);

const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;

// Every piece crop is the same fixed size in map units — only the pan
// target (centered on each pin) changes — so scale/orientation stay
// identical across all 7 and the crops are geographically compatible
// with each other, even though only the final recap map ever actually
// shows them assembled together.
const PIECE_W = 170;
const PIECE_H = 210;
const pieceViewBox = (pin: { x: number; y: number }) =>
  `${pin.x - PIECE_W / 2} ${pin.y - PIECE_H / 2} ${PIECE_W} ${PIECE_H}`;
---

<section class="tour-hero full-bleed">
  <img class="tour-hero__bg" src={heroImage.url} alt={heroImage.alt} loading="eager" decoding="async" />
  <div class="tour-hero__scrim" aria-hidden="true"></div>

  <div class="tour-hero__content container">
    <p class="tour-hero__eyebrow">Salt &amp; Sun Tours</p>
    <h1 class="tour-hero__heading">Tours &amp; Adventures</h1>
    <p class="tour-hero__body">
      Seven signature destinations across three regions, plus every
      shorter adventure and combo deal we run out of Swakopmund and
      Walvis Bay. <a href="/contact">Contact us for current rates</a>.
    </p>
  </div>

  <p class="tour-hero__credit">
    Photo:{' '}
    <a href={creditHref(heroImage.credit.username)} target="_blank" rel="noopener noreferrer">{heroImage.credit.name}</a>{' '}
    /{' '}
    <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
  </p>

  <div class="tour-hero__scroll-cue" aria-hidden="true"><span></span></div>
</section>

<!-- Seven ordinary (non-pinned) sections, one per tour -->
{
  stopsWithTours.map(({ pin, tour }, i) => (
    <section
      class:list={['tour-reveal', 'reveal', i % 2 === 1 && 'tour-reveal--reverse']}
      id={i === 0 ? 'tour' : undefined}
    >
      <div class="container tour-reveal__grid">
        <div class="tour-reveal__photo-wrap reveal-item">
          <img
            class="tour-reveal__photo"
            src={tour.imageUrl}
            alt={tour.name}
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
          />
          {tour.imageCredit && (
            <p class="tour-reveal__credit">
              Photo:{' '}
              <a href={creditHref(tour.imageCredit.username)} target="_blank" rel="noopener noreferrer">{tour.imageCredit.name}</a>{' '}
              /{' '}
              <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
            </p>
          )}
        </div>

        <div class="tour-reveal__side reveal-item">
          <div class="tour-reveal__piece">
            <NamibiaMap pins={[pin]} activeSlug={pin.slug} viewBox={pieceViewBox(pin)} />
          </div>
          <p class="tour-reveal__region">{pin.regionLabel}</p>
          <h2 class="tour-reveal__title">{tour.name}</h2>
          <p class="tour-reveal__desc">{tour.description}</p>
          <a class="btn btn-primary" href={`/booking?tour=${tour.slug}`}>Book this tour</a>
        </div>
      </div>
    </section>
  ))
}

<!-- Closing recap: the complete map with all 7 pins, plus a small
     auto-cycling slideshow through all 7 tour photos -->
<section class="tour-recap reveal">
  <div class="container tour-recap__grid">
    <div class="tour-recap__map-wrap reveal-item">
      <NamibiaMap pins={mapJourney} />
      <p class="tour-recap__caption">Seven tours, three regions</p>
    </div>

    <div class="tour-recap__slideshow reveal-item" data-tour-slideshow>
      <div class="tour-recap__slides">
        {
          stopsWithTours.map(({ tour }, i) => (
            <figure class:list={['tour-recap__slide', i === 0 && 'is-active']} data-tour-slide={i}>
              <img src={tour.imageUrl} alt={tour.name} loading="lazy" decoding="async" />
              <figcaption>{tour.name}</figcaption>
            </figure>
          ))
        }
      </div>

      <div class="tour-recap__dots" data-tour-slideshow-dots role="tablist" aria-label="Choose a tour photo">
        {
          stopsWithTours.map(({ tour }, i) => (
            <button
              type="button"
              class:list={[i === 0 && 'is-active']}
              data-dot={i}
              aria-label={`Show ${tour.name}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Hero ---------- */
  .tour-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    color: var(--color-text-on-dark);
    overflow: hidden;
  }

  .tour-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.55) 0%,
      rgba(31, 18, 14, 0.25) 40%,
      rgba(31, 18, 14, 0.75) 100%
    );
  }

  .tour-hero__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .tour-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin-bottom: var(--space-sm);
  }

  .tour-hero__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
  }

  .tour-hero__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
    max-width: 32rem;
  }

  .tour-hero__body a {
    color: var(--color-text-on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-hero__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.65);
  }

  .tour-hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-hero__scroll-cue {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 24px;
    height: 40px;
    border: 2px solid rgba(251, 247, 241, 0.7);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .tour-hero__scroll-cue span {
    width: 3px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-sand-100);
    animation: tour-scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes tour-scroll-cue {
    0% { opacity: 1; transform: translateY(0); }
    70%, 100% { opacity: 0; transform: translateY(10px); }
  }

  /* ---------- Per-tour reveal sections ---------- */
  .tour-reveal {
    padding-block: var(--space-2xl);
  }

  .tour-reveal__grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
  }

  .tour-reveal--reverse .tour-reveal__grid {
    grid-template-columns: 1fr 1.7fr;
  }

  .tour-reveal__photo-wrap {
    position: relative;
    order: 1;
  }

  .tour-reveal--reverse .tour-reveal__photo-wrap {
    order: 2;
  }

  .tour-reveal__side {
    order: 2;
  }

  .tour-reveal--reverse .tour-reveal__side {
    order: 1;
  }

  .tour-reveal__photo {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .tour-reveal__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.85);
  }

  .tour-reveal__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Fixed-size crop of the exact same NamibiaMap coordinate system used
     everywhere else — only the pan target changes per tour, so every
     piece is scaled/oriented identically to the others. */
  .tour-reveal__piece {
    width: 100%;
    max-width: 220px;
    aspect-ratio: 170 / 210;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-sm);
  }

  .tour-reveal__region {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 var(--space-3xs);
  }

  .tour-reveal__title {
    margin: 0 0 var(--space-2xs);
  }

  .tour-reveal__desc {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-md);
  }

  @media (max-width: 768px) {
    .tour-reveal__grid,
    .tour-reveal--reverse .tour-reveal__grid {
      grid-template-columns: 1fr;
    }

    .tour-reveal__photo-wrap,
    .tour-reveal--reverse .tour-reveal__photo-wrap,
    .tour-reveal__side,
    .tour-reveal--reverse .tour-reveal__side {
      order: initial;
    }

    .tour-reveal__photo {
      aspect-ratio: 4 / 3;
    }

    .tour-reveal__piece {
      max-width: 160px;
    }
  }

  /* ---------- Closing recap ---------- */
  .tour-recap {
    padding-block: var(--space-2xl) var(--space-3xl);
    background: var(--color-bg-alt);
  }

  .tour-recap__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
  }

  .tour-recap__map-wrap {
    max-width: 380px;
    margin-inline: auto;
    width: 100%;
  }

  .tour-recap__caption {
    text-align: center;
    margin: var(--space-sm) 0 0;
    font-family: var(--font-display-italic);
    font-style: italic;
    color: var(--color-earth-700);
  }

  .tour-recap__slideshow {
    max-width: 360px;
    margin-inline: auto;
    width: 100%;
  }

  .tour-recap__slides {
    position: relative;
    aspect-ratio: 5 / 4;
  }

  .tour-recap__slide {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    transition: opacity 600ms var(--ease-out);
  }

  .tour-recap__slide.is-active {
    opacity: 1;
  }

  .tour-recap__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  .tour-recap__slide figcaption {
    position: absolute;
    left: var(--space-sm);
    bottom: var(--space-sm);
    right: var(--space-sm);
    margin: 0;
    padding: var(--space-2xs) var(--space-sm);
    background: rgba(58, 35, 28, 0.75);
    color: var(--color-text-on-dark);
    font-size: var(--fs-sm);
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  .tour-recap__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
  }

  .tour-recap__dots button {
    width: 10px;
    height: 10px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--color-accent-strong);
    background: transparent;
    cursor: pointer;
  }

  .tour-recap__dots button.is-active {
    background: var(--color-accent-strong);
  }

  @media (max-width: 768px) {
    .tour-recap__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .tour-hero__heading {
      font-size: var(--fs-2xl);
    }
  }
</style>
