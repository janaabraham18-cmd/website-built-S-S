---
// Replaces the old flat TourCard-row list for the 7 sightseeing "Tours"
// with a full-bleed hero that leads straight into a scroll-driven map
// journey — no separate generic hero block in between. Desktop pins the
// map+card panel and steps through 7 waypoints (4 in Erongo, 2 in
// Kunene, 1 in Hardap) as the visitor scrolls; under prefers-reduced-
// motion or below the 860px breakpoint (where a pinned sticky map isn't
// workable), it falls back to a stacked sequence with a small static
// cropped map thumbnail per tour instead of the interactive pinned one.
import { tours } from '../data/tours';
import { mapStops, mapJourney } from '../data/tourRegions';
import NamibiaMap from './NamibiaMap.astro';

const heroImage = {
  url: 'https://images.unsplash.com/photo-1489493887464-892be6d1daae?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Ondrej Machart', username: 'ondrejmachart' },
  alt: 'Aerial view of the Namib desert dunes meeting the Atlantic coastline',
};

const stopsWithTours = mapJourney.map((pin) => {
  const tour = tours.find((t) => t.slug === pin.slug);
  return { pin, tour };
}).filter((s): s is { pin: typeof mapJourney[number]; tour: NonNullable<typeof s.tour> } => !!s.tour);

const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;

// Mobile mini-map crop: a tight viewBox centered on that stop's zoom
// target, reusing the exact same region shapes/pins as the desktop map.
const miniViewBox = (zoom: { x: number; y: number; scale: number }) => {
  const w = 600 / zoom.scale;
  const h = 740 / zoom.scale;
  return `${zoom.x - w / 2} ${zoom.y - h / 2} ${w} ${h}`;
};
---

<section class="tour-hero full-bleed">
  <img class="tour-hero__bg" src={heroImage.url} alt={heroImage.alt} loading="eager" decoding="async" />
  <div class="tour-hero__scrim" aria-hidden="true"></div>

  <div class="tour-hero__content container">
    <p class="tour-hero__eyebrow">Salt &amp; Sun Tours</p>
    <h1 class="tour-hero__heading">Tours &amp; Adventures</h1>
    <p class="tour-hero__body">
      Seven signature destinations across three regions, plus every
      shorter adventure and combo deal we run out of Swakopmund and
      Walvis Bay. <a href="/contact">Contact us for current rates</a>.
    </p>
  </div>

  <p class="tour-hero__credit">
    Photo:{' '}
    <a href={creditHref(heroImage.credit.username)} target="_blank" rel="noopener noreferrer">{heroImage.credit.name}</a>{' '}
    /{' '}
    <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
  </p>

  <div class="tour-hero__scroll-cue" aria-hidden="true"><span></span></div>
</section>

<!-- Desktop / motion-ok: pinned interactive map journey -->
<section class="map-journey" data-map-journey id="tour">
  <div class="map-journey__pin-area">
    <div class="container map-journey__grid">
      <div class="map-journey__map-panel">
        <NamibiaMap pins={mapJourney} />
        <p class="map-journey__region-label" data-map-region-label>{mapStops[0].regionLabel}</p>
      </div>

      <div class="map-journey__card-panel">
        {
          stopsWithTours.map(({ pin, tour }, i) => (
            <article class:list={['map-journey__card', i === 0 && 'is-active']} data-map-card={pin.slug}>
              <img class="map-journey__card-img" src={tour.imageUrl} alt={tour.name} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <p class="map-journey__card-region">{pin.regionLabel}</p>
              <h2 class="map-journey__card-title">{tour.name}</h2>
              <p class="map-journey__card-desc">{tour.description}</p>
              <a class="btn btn-primary" href={`/booking?tour=${tour.slug}`}>Book this tour</a>
              {tour.imageCredit && (
                <p class="map-journey__card-credit">
                  Photo:{' '}
                  <a href={creditHref(tour.imageCredit.username)} target="_blank" rel="noopener noreferrer">{tour.imageCredit.name}</a>{' '}
                  /{' '}
                  <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <div class="map-journey__waypoints">
    {
      stopsWithTours.map(({ pin }, i) => (
        <div
          class="map-journey__waypoint"
          data-map-waypoint={i}
          data-slug={pin.slug}
          data-region-label={pin.regionLabel}
          data-zoom-x={pin.zoom.x}
          data-zoom-y={pin.zoom.y}
          data-zoom-scale={pin.zoom.scale}
        />
      ))
    }
  </div>
</section>

<!-- Mobile / reduced-motion fallback: stacked sequence, static mini-map per tour -->
<section class="map-journey-mobile" data-map-journey-mobile>
  <div class="container">
    {
      stopsWithTours.map(({ pin, tour }) => (
        <article class="map-journey-mobile__item">
          <div class="map-journey-mobile__mini-map">
            <NamibiaMap pins={[pin]} activeSlug={pin.slug} viewBox={miniViewBox(pin.zoom)} />
          </div>
          <img class="map-journey-mobile__img" src={tour.imageUrl} alt={tour.name} loading="lazy" decoding="async" />
          <p class="map-journey-mobile__region">{pin.regionLabel}</p>
          <h3 class="map-journey-mobile__title">{tour.name}</h3>
          <p class="map-journey-mobile__desc">{tour.description}</p>
          <a class="btn btn-primary" href={`/booking?tour=${tour.slug}`}>Book this tour</a>
        </article>
      ))
    }
  </div>
</section>

<style>
  /* ---------- Hero ---------- */
  .tour-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    color: var(--color-text-on-dark);
    overflow: hidden;
  }

  .tour-hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-hero__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.55) 0%,
      rgba(31, 18, 14, 0.25) 40%,
      rgba(31, 18, 14, 0.75) 100%
    );
  }

  .tour-hero__content {
    position: relative;
    z-index: 1;
    max-width: 40rem;
  }

  .tour-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin-bottom: var(--space-sm);
  }

  .tour-hero__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
  }

  .tour-hero__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
    max-width: 32rem;
  }

  .tour-hero__body a {
    color: var(--color-text-on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-hero__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.65);
  }

  .tour-hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-hero__scroll-cue {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 24px;
    height: 40px;
    border: 2px solid rgba(251, 247, 241, 0.7);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .tour-hero__scroll-cue span {
    width: 3px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-sand-100);
    animation: tour-scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes tour-scroll-cue {
    0% { opacity: 1; transform: translateY(0); }
    70%, 100% { opacity: 0; transform: translateY(10px); }
  }

  /* ---------- Map journey (desktop / motion-ok) ---------- */
  .map-journey {
    position: relative;
  }

  .map-journey__pin-area {
    height: 100vh;
    display: flex;
    align-items: center;
    background: var(--color-bg-alt);
  }

  .map-journey__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
    width: 100%;
  }

  .map-journey__map-panel {
    position: relative;
    aspect-ratio: 600 / 740;
    max-height: 78vh;
    margin-inline: auto;
    width: 100%;
    max-width: 420px;
  }

  .map-journey__region-label {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    margin: 0;
    padding: var(--space-3xs) var(--space-sm);
    background: var(--color-earth-900);
    color: var(--color-text-on-dark);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
  }

  .map-journey__card-panel {
    position: relative;
    min-height: 28rem;
  }

  .map-journey__card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms var(--ease-out);
  }

  .map-journey__card.is-active {
    opacity: 1;
    visibility: visible;
  }

  .map-journey__card-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    margin-bottom: var(--space-md);
  }

  .map-journey__card-region {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 var(--space-3xs);
  }

  .map-journey__card-title {
    margin: 0 0 var(--space-2xs);
  }

  .map-journey__card-desc {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-md);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .map-journey__card-credit {
    margin: var(--space-sm) 0 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .map-journey__card-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Waypoints carry no visual layout of their own — they're pure data
     (slug/region/zoom target) read by motion.ts. The pinned scroll
     distance comes entirely from the ScrollTrigger's own `end` value
     (computed in JS as steps × viewport height), not from these
     elements taking up document space. */
  .map-journey__waypoint {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* ---------- Mobile / reduced-motion fallback ---------- */
  .map-journey-mobile {
    display: none;
    padding-block: var(--space-2xl);
  }

  .map-journey-mobile__item {
    display: grid;
    gap: var(--space-md);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .map-journey-mobile__item:last-child {
    border-bottom: none;
  }

  .map-journey-mobile__mini-map {
    width: 96px;
    aspect-ratio: 600 / 740;
  }

  .map-journey-mobile__img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .map-journey-mobile__region {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0;
  }

  .map-journey-mobile__title {
    margin: 0;
  }

  .map-journey-mobile__desc {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-2xs);
  }

  /* Reduced-motion and narrow viewports both get the stacked fallback —
     a pinned sticky map doesn't work at phone width, and scroll-jacked
     zoom/pan isn't appropriate under reduced motion either. */
  @media (max-width: 860px), (prefers-reduced-motion: reduce) {
    .map-journey {
      display: none;
    }

    .map-journey-mobile {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .tour-hero__heading {
      font-size: var(--fs-2xl);
    }
  }
</style>
