---
// Full-bleed hero leads straight into a two-column journey: a left
// column of ordinary (non-pinned, non-sticky) sections — one per
// tour, each fading in via the sitewide .reveal/.reveal-item pattern —
// and a right-hand column holding a single map that literally grows as
// you scroll. Nothing about the map is pre-rendered as a "ghost" of the
// finished thing: each tour's piece (a small crop of the shared
// NamibiaMap coordinate system, centered on that tour's pin) only
// appears once its section scrolls into view, floating into its true
// relative position next to whichever pieces already landed, and the
// map's own container grows taller to fit. By the final section the
// map has assembled itself from everything that accumulated. Scrolling
// on to the closing slot settles that collage into one clean, unbroken
// map of the whole country with every tour pinned at once — so a
// tourist can actually read where everything is — alongside a small
// auto-cycling slideshow of all the tour photos. Below ~900px there's no
// room for two columns, so the growing map is hidden: each tour section
// shows its own small static piece inline, and the closing slot shows
// the same complete map as a plain static image.
import { tours } from '../data/tours';
import { mapJourney } from '../data/tourRegions';
import NamibiaMap from './NamibiaMap.astro';

const introBg = {
  url: 'https://images.unsplash.com/photo-1772289093080-831ca03c76e1?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'NIR HIMI', username: 'nirhimi' },
};

const stopsWithTours = mapJourney.map((pin) => {
  const tour = tours.find((t) => t.slug === pin.slug);
  return { pin, tour };
}).filter((s): s is { pin: typeof mapJourney[number]; tour: NonNullable<typeof s.tour> } => !!s.tour);

const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;

// 2-4 highlight phrases per tour, each lifted directly from that tour's
// own description in tours.ts (never invented) — a scannable recap of
// concrete things you'll see/do, distinct from the Includes line below
// it (which is about what's provided/logistics, not the experience).
const highlightsBySlug: Record<string, string[]> = {
  'etosha-tour': ['Elephants', 'Lions', 'Rhinos', 'Giraffes'],
  'sossusvlei-tour': ['Towering red sand dunes', 'Deadvlei', 'Namib Desert landscapes'],
  'skeleton-coast-tour': ['Dramatic shoreline', 'Shipwrecks', 'Seal colonies', 'Atlantic Ocean views'],
  'sandwich-harbour-full-day': ['Salt Pans', 'Namib-Naukluft Park', 'Sandwich Harbour Lagoon', 'Dune driving'],
  'spitzkoppe-tour': ['Granite rock formations', 'Ancient rock art', 'Desert landscapes'],
  'pelican-point-tour': ['Cape fur seals', 'Pelicans', 'Flamingos', 'Desert-meets-ocean views'],
  'dolphin-seal-catamaran-cruise': ['Dolphins', 'Rescue seals & pelicans', 'Whales', 'Turtles & Mola fish'],
  'moonlandscape-tour': ['Moonscape valley views', 'Lichen fields', 'Welwitschia plants'],
  'cape-cross': ['Cape fur seal colony', 'Historic post office & railway', 'Lichen fields', 'Zeila Shipwreck'],
  'living-desert-tour': ['Sidewinder snakes', 'White Lady spiders', 'Namaqua chameleons', 'Dancing lizards'],
};

// Every piece is the same fixed-size crop (in map units) of the exact
// same coordinate system NamibiaMap.astro's 14 region polygons are
// drawn against — only the pan target (centered on each pin) differs —
// so any two pieces placed at their true map-unit offsets tile
// together correctly, like a puzzle, with no separate assembly step.
const PIECE_W = 170;
const PIECE_H = 210;
const pieceViewBox = (pin: { x: number; y: number }) =>
  `${pin.x - PIECE_W / 2} ${pin.y - PIECE_H / 2} ${PIECE_W} ${PIECE_H}`;

// Pixel layout for the growing map: lay out all the piece-crops at their
// true relative map-unit positions, find the bounding box that
// encloses all of them, then scale that box to a sensible on-page
// size. This is computed once, up front — the pieces' final positions
// never change, only how many of them are visible does.
const SCALE = 1.3;
const pieceRects = stopsWithTours.map(({ pin }) => ({
  slug: pin.slug,
  left: pin.x - PIECE_W / 2,
  top: pin.y - PIECE_H / 2,
}));
const minLeft = Math.min(...pieceRects.map((r) => r.left));
const minTop = Math.min(...pieceRects.map((r) => r.top));
const maxRight = Math.max(...pieceRects.map((r) => r.left + PIECE_W));
const growthWidth = Math.round((maxRight - minLeft) * SCALE);
const pieceBoxStyle = (pin: { x: number; y: number }) => {
  const left = Math.round((pin.x - PIECE_W / 2 - minLeft) * SCALE);
  const top = Math.round((pin.y - PIECE_H / 2 - minTop) * SCALE);
  const w = Math.round(PIECE_W * SCALE);
  const h = Math.round(PIECE_H * SCALE);
  return `left:${left}px; top:${top}px; width:${w}px; height:${h}px;`;
};

// Once all pieces have landed, the collage settles into one clean,
// unbroken map of the whole country (NamibiaMap's full 0 0 751 740
// viewBox) with every tour pinned at once, so it's actually legible as
// a map rather than a scrapbook of overlapping crops — the point being
// a tourist can now see exactly where each tour sits relative to the
// others. Kept at the same width as the collage so the settle reads as
// one continuous object, just resolving into focus.
const FULL_MAP_H = Math.round(growthWidth * (740 / 751));
---

<section class="tour-intro">
  <div class="tour-intro__bg" style={`background-image:url('${introBg.url}')`} aria-hidden="true"></div>
  <div class="tour-intro__scrim" aria-hidden="true"></div>

  <p class="tour-intro__credit">
    Photo:{' '}
    <a href={creditHref(introBg.credit.username)} target="_blank" rel="noopener noreferrer">{introBg.credit.name}</a>{' '}
    /{' '}
    <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
  </p>

  <div class="tour-intro__grid container">
    <div class="tour-intro__copy">
      <p class="tour-intro__eyebrow">Salt and Sun Tours</p>
      <h1 class="tour-intro__heading">Tours &amp; Adventures</h1>
      <p class="tour-intro__body">
        Ten signature destinations across three regions, plus every
        shorter adventure and combo deal we run out of Swakopmund and
        Walvis Bay. <a href="/contact">Contact us for current rates</a>.
      </p>
      <a class="btn btn-outline tour-intro__cta" href="#tour">See where we go</a>
    </div>

    <div class="tour-intro__map">
      <div class="tour-intro__map-glow" aria-hidden="true"></div>
      <div class="tour-intro__map-frame" data-tour-intro-map>
        <NamibiaMap pins={mapJourney} />
      </div>
      <p class="tour-intro__map-caption">3 regions · 10 signature stops</p>
    </div>
  </div>

  <div class="tour-intro__scroll-cue" aria-hidden="true"><span></span></div>
</section>

<div class="tour-journey">
  <div class="tour-journey__grid">
    <div class="tour-journey__sections">
      {
        stopsWithTours.map(({ pin, tour }, i) => (
          <section
            class:list={['tour-reveal', 'reveal']}
            data-tour-section={i}
            id={i === 0 ? 'tour' : undefined}
          >
            <div class="tour-reveal__inner">
              <div class="tour-reveal__photo-wrap reveal-item">
                <img
                  class="tour-reveal__photo"
                  src={tour.imageUrl}
                  alt={tour.name}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                {tour.imageCredit && (
                  <p class="tour-reveal__credit">
                    Photo:{' '}
                    <a href={creditHref(tour.imageCredit.username)} target="_blank" rel="noopener noreferrer">{tour.imageCredit.name}</a>{' '}
                    /{' '}
                    <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                  </p>
                )}
              </div>

              <div class="tour-reveal__body reveal-item">
                <p class="tour-reveal__region">{pin.regionLabel}</p>
                <h2 class="tour-reveal__title">{tour.name}</h2>
                <p class="tour-reveal__desc">{tour.description}</p>

                {highlightsBySlug[tour.slug] && (
                  <ul class="tour-reveal__highlights">
                    {highlightsBySlug[tour.slug].map((item) => <li>{item}</li>)}
                  </ul>
                )}

                <p class="tour-reveal__quickfacts">
                  {tour.duration && <span class="tour-reveal__duration">{tour.duration}</span>}
                  <span class="tour-reveal__included">
                    <span class="tour-reveal__included-label">Includes</span> {tour.included.join(', ')}
                  </span>
                </p>

                <a class="btn btn-primary" href={`/booking?tour=${tour.slug}`}>Book this tour</a>

                {/* Mobile-only fallback: a small static piece map inline
                    with its own section, in place of the desktop growing
                    map column, which has nowhere sensible to sit below
                    the two-column breakpoint. */}
                <div class="tour-reveal__piece-mobile" aria-hidden="true">
                  <NamibiaMap pins={[pin]} activeSlug={pin.slug} viewBox={pieceViewBox(pin)} />
                </div>
              </div>
            </div>
          </section>
        ))
      }

      <!-- Closing slot: once the growing map has assembled all its pieces,
           scrolling to this slot settles it into one clean complete map
           (see setupTourMapGrowth's finalTrigger) alongside a small
           auto-cycling slideshow of all the tour photos. Lives inside the
           same left column/grid row as the tour sections (rather than
           as its own section after .tour-journey) so the map column
           beside it can keep using the same non-sticky
           margin-top-repositioning trick to end up level with it. -->
      <div class="tour-recap reveal" data-map-final>
        <h2 class="tour-recap__heading reveal-item">Ten tours, three regions</h2>
        <p class="tour-recap__lede reveal-item">
          Every tour, together on one map — see exactly where each one takes you.
        </p>

        {/* Mobile-only fallback: the desktop map column (with its
            settle-into-a-full-map moment) is hidden below the
            breakpoint, so mobile gets the same complete map as a plain
            static image instead. */}
        <div class="tour-recap__map-mobile reveal-item" aria-hidden="true">
          <NamibiaMap pins={mapJourney} />
        </div>

        <div class="tour-recap__slideshow reveal-item" data-tour-slideshow>
          <div class="tour-recap__slides">
            {
              stopsWithTours.map(({ tour }, i) => (
                <figure class:list={['tour-recap__slide', i === 0 && 'is-active']} data-tour-slide={i}>
                  <img src={tour.imageUrl} alt={tour.name} loading="lazy" decoding="async" />
                  <figcaption>{tour.name}</figcaption>
                </figure>
              ))
            }
          </div>

          <div class="tour-recap__dots" data-tour-slideshow-dots role="tablist" aria-label="Choose a tour photo">
            {
              stopsWithTours.map(({ tour }, i) => (
                <button
                  type="button"
                  class:list={[i === 0 && 'is-active']}
                  data-dot={i}
                  aria-label={`Show ${tour.name}`}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <aside class="tour-journey__map-col" aria-hidden="true">
      <div
        class="tour-map-growth"
        data-map-growth
        data-full-height={FULL_MAP_H}
        style={`width:${growthWidth}px; height:${FULL_MAP_H}px;`}
      >
        <div class="tour-map-growth__pieces" data-map-pieces>
          {
            stopsWithTours.map(({ pin }, i) => (
              <div class="tour-map-growth__piece" data-map-piece={i} style={pieceBoxStyle(pin)}>
                <NamibiaMap pins={[pin]} activeSlug={pin.slug} viewBox={pieceViewBox(pin)} />
              </div>
            ))
          }
        </div>

        <div class="tour-map-growth__full" data-map-full-layer aria-hidden="true">
          <NamibiaMap pins={mapJourney} />
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  /* ---------- Intro ---------- */
  /* The page's real centerpiece is the map that grows piece by piece
     further down, so the opening states that up front — the same
     country map, with the three regions this page actually visits
     already lit, before the journey starts — rather than a generic
     stock photo. A blurred desert-dusk photo sits behind it purely as
     ambient texture/mood (same technique as the homepage Reviews
     section's blurred background), with a dark scrim on top for text
     contrast, matching the weight the previous full-bleed hero photo
     used. */
  .tour-intro {
    position: relative;
    min-height: min(88vh, 820px);
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--color-text-on-dark);
  }

  .tour-intro__bg {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(4px);
    z-index: -2;
  }

  .tour-intro__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.6) 0%,
      rgba(31, 18, 14, 0.4) 45%,
      rgba(31, 18, 14, 0.8) 100%
    );
  }

  .tour-intro__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.65);
  }

  .tour-intro__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-intro__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    align-items: center;
    gap: var(--space-2xl);
    width: 100%;
  }

  .tour-intro__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin-bottom: var(--space-sm);
  }

  .tour-intro__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
  }

  .tour-intro__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
    max-width: 32rem;
    margin-bottom: var(--space-lg);
  }

  .tour-intro__body a {
    color: var(--color-text-on-dark);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-intro__cta {
    color: var(--color-text-on-dark);
  }

  .tour-intro__map {
    position: relative;
    text-align: center;
  }

  .tour-intro__map-glow {
    position: absolute;
    inset: -15%;
    background: radial-gradient(circle, rgba(211, 162, 79, 0.22) 0%, transparent 70%);
    z-index: 0;
  }

  .tour-intro__map-frame {
    position: relative;
    z-index: 1;
    max-width: 380px;
    aspect-ratio: 751 / 740;
    margin-inline: auto;
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.35));
  }

  .tour-intro__map-caption {
    position: relative;
    z-index: 1;
    margin: var(--space-sm) 0 0;
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-sand-100);
    opacity: 0.85;
  }

  .tour-intro__scroll-cue {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 24px;
    height: 40px;
    border: 2px solid rgba(251, 247, 241, 0.7);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .tour-intro__scroll-cue span {
    width: 3px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-sand-100);
    animation: tour-scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes tour-scroll-cue {
    0% { opacity: 1; transform: translateY(0); }
    70%, 100% { opacity: 0; transform: translateY(10px); }
  }

  @media (max-width: 760px) {
    .tour-intro {
      min-height: 0;
      padding-block: var(--space-3xl) var(--space-2xl);
    }

    .tour-intro__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      text-align: center;
    }

    .tour-intro__copy {
      order: 2;
    }

    .tour-intro__body {
      margin-inline: auto;
    }

    .tour-intro__map {
      order: 1;
    }

    .tour-intro__map-frame {
      max-width: 260px;
    }
  }

  /* ---------- Two-column journey ---------- */
  /* First band in the tours page's light-to-dark section progression
     (see tours.astro) — sits right after the hero photo, so it starts
     at the same pale tone as the page background rather than an
     abrupt jump. */
  .tour-journey {
    padding-block: var(--space-2xl);
    background: var(--color-bg);
  }

  /* Deliberately not the sitewide .container (max-width: 1180px, sized
     for reading-width paragraph text) — a section built around a photo
     that bleeds to the actual browser edge and reaches toward the
     middle of the screen needs a much wider budget than that, so this
     gets its own, considerably wider one. The map column's real content
     has a fixed pixel width (it doesn't reshape — its pieces are placed
     at fixed coordinates), so `auto` sizes that column to exactly what
     it needs and `minmax(0, 1fr)` lets the photo+text column claim
     everything left over, rather than the two fighting over fr shares
     the map's fixed width would just override anyway. */
  .tour-journey__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--space-2xl);
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .tour-journey__sections {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    min-width: 0;
  }

  /* Not sticky, not pinned — genuinely just sits in normal document
     flow, at the top of its column by default. A single fixed vertical
     position (top-anchored or centered) doesn't work here: the map's
     own assembled size stays compact (it's scaled to real geography,
     not to page length) while the tour-section stack is many times
     taller, so anywhere static leaves it stranded off-screen for most
     of the scroll. Instead, setupTourMapGrowth() nudges this column's
     margin-top once per section (at the same moment that section's
     piece is placed) so the map re-centers on whichever section just
     came into view. That's a one-shot reposition per trigger, not a
     continuous scroll-follow — still ordinary box-model layout, not
     position:fixed/sticky — but it keeps the map roughly paired with
     the reader all the way down instead of only near one spot. Its
     height is driven entirely by how many pieces have been placed.
  */
  .tour-journey__map-col {
    position: static;
  }

  .tour-map-growth {
    position: relative;
    max-width: 100%;
    margin-inline: auto;
    margin-top: 0;
    overflow: hidden;
  }

  /* Two stacked layers sharing the same box: the piece-by-piece collage
     (default hidden — see setupTourMapGrowth, which only takes over
     once full motion is confirmed) and the single clean complete map
     it eventually settles into. Without JS, or under reduced motion,
     the complete map is just shown outright — a more useful static
     fallback than a half-finished scrapbook. */
  .tour-map-growth__pieces {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform-origin: center center;
  }

  /* Same soft dusk glow as the .tour-recap card beside it (this layer
     only shows once the map has fully settled — see setupTourMapGrowth
     — so the glow arrives at the same moment as the card does). */
  .tour-map-growth__full {
    position: absolute;
    inset: 0;
    opacity: 1;
    transform-origin: center center;
    background: radial-gradient(ellipse at center, rgba(211, 162, 79, 0.16) 0%, transparent 72%);
  }

  .tour-map-growth__piece {
    position: absolute;
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  /* ---------- Per-tour reveal sections ---------- */
  /* Flex rather than grid: the photo is meant to break out past its own
     column all the way to the actual browser edge (see
     setupTourPhotoBleed in motion.ts, which measures and cancels the
     real offset via a negative margin-left — a pure-CSS vw-based
     breakout doesn't reliably reach the viewport edge from this deep a
     level of nesting, confirmed by testing it in isolation). A CSS
     grid's fr-tracks resist that kind of intentionally-oversized child
     well; flex with an explicit fixed-ish photo width and a flexible
     text column handles it predictably. */
  .tour-reveal__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    min-width: 0;
  }

  .tour-reveal__photo-wrap {
    position: relative;
    flex: 0 0 auto;
    width: min(46vw, 560px);
    min-width: 0;
  }

  .tour-reveal__body {
    flex: 1 1 0%;
    min-width: 0;
  }

  .tour-reveal__highlights {
    list-style: none;
    margin: 0 0 var(--space-md);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .tour-reveal__highlights li {
    position: relative;
    padding-left: var(--space-md);
    font-size: var(--fs-sm);
    color: var(--color-text);
  }

  .tour-reveal__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-strong);
  }

  .tour-reveal__quickfacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-md);
  }

  .tour-reveal__duration {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
    color: var(--color-accent-strong);
  }

  .tour-reveal__included-label {
    font-weight: 600;
    color: var(--color-earth-900);
  }

  .tour-reveal__photo {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .tour-reveal__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.85);
  }

  .tour-reveal__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-reveal__region {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 var(--space-3xs);
  }

  .tour-reveal__title {
    margin: 0 0 var(--space-2xs);
  }

  .tour-reveal__desc {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-md);
  }

  .tour-reveal__piece-mobile {
    display: none;
  }

  @media (max-width: 900px) {
    .tour-journey__grid {
      grid-template-columns: 1fr;
    }

    .tour-journey__map-col {
      display: none;
    }

    .tour-reveal__inner {
      flex-direction: column;
      align-items: stretch;
    }

    .tour-reveal__photo-wrap {
      width: 100%;
    }

    .tour-reveal__photo {
