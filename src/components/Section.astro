---
interface Props {
  heading?: string;
  eyebrow?: string;
  imageUrl?: string;
  align?: 'left' | 'center';
  theme?: 'light' | 'photo';
  pin?: boolean;
  id?: string;
}

const {
  heading,
  eyebrow,
  imageUrl = '',
  align = 'left',
  theme = 'light',
  pin = false,
  id,
} = Astro.props;
---

<section
  id={id}
  class:list={[
    'section',
    `section--${theme}`,
    `section--align-${align}`,
    'full-bleed',
    'reveal',
    pin && 'section--pinned',
  ]}
>
  {
    theme === 'photo' && (
      <>
        {imageUrl ? (
          <img
            class="section__bg"
            src={imageUrl}
            alt=""
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="section__bg" aria-hidden="true" />
        )}
        <div class="section__overlay" aria-hidden="true" />
      </>
    )
  }

  <div class="section__inner container">
    {eyebrow && <p class="section__eyebrow reveal-item">{eyebrow}</p>}
    {heading && <h2 class="section__heading reveal-item">{heading}</h2>}
    <div class="section__body reveal-item">
      <slot />
    </div>
  </div>
</section>

<style>
  .section {
    position: relative;
    padding-block: var(--space-2xl);
    overflow: hidden;
  }

  .section--light {
    background: transparent;
  }

  .section--photo {
    color: var(--color-text-on-dark);
    min-height: 70vh;
    display: flex;
    align-items: center;
  }

  .section__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background-image: var(--section-image, none);
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
    will-change: transform;
  }

  .section__overlay {
    position: absolute;
    inset: 0;
    background: var(--gradient-overlay-photo-strong);
  }

  /* Soft feather at the top/bottom edges of a photo section so it bleeds
     into the page background instead of cutting hard against it. */
  .section--photo::before,
  .section--photo::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: var(--space-2xl);
    pointer-events: none;
    z-index: 1;
  }

  .section--photo::before {
    top: 0;
    background: linear-gradient(to bottom, var(--color-bg) 0%, transparent 100%);
  }

  .section--photo::after {
    bottom: 0;
    background: linear-gradient(to top, var(--color-bg) 0%, transparent 100%);
  }

  .section__inner {
    position: relative;
    z-index: 2;
  }

  .section--align-center .section__inner {
    text-align: center;
    margin-inline: auto;
    max-width: var(--content-width-narrow);
  }

  .section__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .section--photo .section__eyebrow {
    color: var(--color-sand-100);
  }

  .section__heading {
    margin-bottom: var(--space-md);
  }

  .section--photo .section__heading {
    color: var(--color-text-on-dark);
  }

  .section__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: var(--content-width-narrow);
  }

  .section--align-center .section__body {
    margin-inline: auto;
  }

  .section--photo .section__body {
    color: var(--color-sand-100);
  }

  @media (max-width: 640px) {
    .section {
      padding-block: var(--space-xl);
    }
  }
</style>
