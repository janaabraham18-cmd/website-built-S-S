---
import type { Tour } from '../data/tours';
import { tourBySlug } from '../data/tours';

interface Props {
  combo: Tour;
}

const { combo } = Astro.props;
const components = (combo.pairs ?? [])
  .map((slug) => tourBySlug(slug))
  .filter((t): t is Tour => !!t);
---

<article class="combo-card">
  <div class="combo-card__pairs">
    {
      components.map((t, i) => (
        <>
          <div class="combo-card__half">
            <div class="photo-frame combo-card__photo">
              <img src={t.imageUrl} alt={t.name} loading="lazy" decoding="async" />
            </div>
            <p class="combo-card__half-name">{t.name}</p>
          </div>
          {i < components.length - 1 && (
            <span class="combo-card__plus" aria-hidden="true">+</span>
          )}
        </>
      ))
    }
  </div>

  <div class="combo-card__body">
    <p class="combo-card__tag">Two in one day{combo.duration ? ` · ${combo.duration}` : ''}</p>
    <h3 class="combo-card__name">{combo.name}</h3>
    <p class="combo-card__desc">{combo.description}</p>
    {combo.note && <p class="combo-card__note">{combo.note}</p>}
    <p class="combo-card__included">
      <span class="combo-card__included-label">Includes</span> {combo.included.join(', ')}
    </p>
    <a class="book-link" href={`/booking?tour=${combo.slug}`}>Book this combo</a>
  </div>
</article>

<style>
  .combo-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .combo-card__pairs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
  }

  .combo-card__half {
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  .combo-card__photo {
    aspect-ratio: 4 / 3;
    margin-bottom: 0.6rem;
  }

  .combo-card__half-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .combo-card__plus {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-accent-strong);
    line-height: 1;
  }

  .combo-card__tag {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .combo-card__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-text);
    margin: 0 0 0.6rem;
  }

  .combo-card__desc {
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    margin: 0 0 0.75rem;
  }

  .combo-card__note {
    font-size: 0.78rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .combo-card__included {
    font-size: 0.78rem;
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .combo-card__included-label {
    font-weight: 600;
    color: var(--color-earth-900);
  }

  @media (max-width: 480px) {
    .combo-card__half-name {
      white-space: normal;
    }
  }
</style>
