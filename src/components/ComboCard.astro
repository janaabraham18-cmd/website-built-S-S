---
import type { Tour } from '../data/tours';
import { tourBySlug } from '../data/tours';

interface Props {
  combo: Tour;
}

const { combo } = Astro.props;
const components = (combo.pairs ?? [])
  .map((slug) => tourBySlug(slug))
  .filter((t): t is Tour => !!t);
---

<article class="combo-card">
  <div class="combo-card__pairs">
    {
      components.map((t, i) => (
        <>
          <div class="combo-card__half">
            <div class="photo-frame combo-card__photo">
              <img src={t.imageUrl} alt={t.name} loading="lazy" decoding="async" />
            </div>
            <p class="combo-card__half-name">{t.name}</p>
          </div>
          {i < components.length - 1 && (
            <span class="combo-card__plus" aria-hidden="true">+</span>
          )}
        </>
      ))
    }
  </div>

  <div class="combo-card__body">
    <p class="combo-card__tag">Two in one day{combo.duration ? ` · ${combo.duration}` : ''}</p>
    <h3 class="combo-card__name">{combo.name}</h3>
    <a class="book-link" href={`/booking?tour=${combo.slug}`}>Book this combo</a>
  </div>
</article>

<style>
  .combo-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .combo-card__pairs {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
  }

  .combo-card__half {
    flex: 0 1 76px;
    min-width: 0;
    text-align: center;
  }

  .combo-card__photo {
    aspect-ratio: 1 / 1;
    margin-bottom: 0.35rem;
  }

  .combo-card__half-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .combo-card__plus {
    flex-shrink: 0;
    align-self: center;
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-accent-strong);
    line-height: 1;
  }

  .combo-card__body {
    text-align: center;
  }

  .combo-card__tag {
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin: 0 0 0.3rem;
  }

  .combo-card__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }
</style>
