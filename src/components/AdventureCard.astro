---
import type { Tour } from '../data/tours';

interface Props {
  tour: Tour;
  featured?: boolean;
}

const { tour, featured = false } = Astro.props;
---

<article class:list={['adventure-card', featured && 'adventure-card--featured']}>
  {
    tour.imageUrl ? (
      <img class="adventure-card__img" src={tour.imageUrl} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="adventure-card__img adventure-card__img--placeholder" aria-hidden="true" />
    )
  }

  <div class="adventure-card__scrim" aria-hidden="true"></div>
  <div class="adventure-card__scrim-strong" aria-hidden="true"></div>

  <button
    type="button"
    class="adventure-card__tap-hint"
    aria-expanded="false"
    data-adventure-toggle
  >
    Tap for details
  </button>

  {
    tour.imageCredit && (
      <p class="adventure-card__credit">
        Photo:{' '}
        <a
          href={`https://unsplash.com/@${tour.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {tour.imageCredit.name}
        </a>{' '}
        /{' '}
        <a
          href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
          target="_blank"
          rel="noopener noreferrer"
        >
          Unsplash
        </a>
      </p>
    )
  }

  <div class="adventure-card__content">
    <h3 class="adventure-card__title">{tour.name}</h3>

    <div class="adventure-card__details" data-adventure-details>
      <p class="adventure-card__desc">{tour.description}</p>
      <p class="adventure-card__included">
        <span class="adventure-card__included-label">Includes</span> {tour.included.join(', ')}
      </p>
    </div>
  </div>
</article>

<style>
  .adventure-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-lg);
    grid-column: span 1;
    grid-row: span 1;
  }

  /* Soft edge vignette feathering the photo into the page's own sand
     tone, so the image reads as part of the surrounding surface rather
     than a hard-edged tile. */
  .adventure-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse farthest-side at 50% 50%,
      transparent 55%,
      rgba(var(--color-sand-100-rgb), 0.3) 100%
    );
  }

  .adventure-card--featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .adventure-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .adventure-card__img--placeholder {
    background: var(--gradient-warm);
  }

  .adventure-card__scrim {
    position: absolute;
    inset: 0;
    background: var(--gradient-overlay-photo);
  }

  .adventure-card__scrim-strong {
    position: absolute;
    inset: 0;
    background: var(--gradient-overlay-photo-strong);
  }

  .adventure-card__content {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-md);
  }

  .adventure-card__title {
    font-size: var(--fs-lg);
    color: var(--color-text-on-dark);
    margin: 0;
  }

  .adventure-card--featured .adventure-card__title {
    font-size: var(--fs-2xl);
  }

  .adventure-card__details {
    margin-top: var(--space-xs);
    /* Capped so long copy can never grow past the card's fixed height and
       push the title (a flex sibling under justify-content: flex-end) up
       and out of the visible box — opacity: 0 hides content but doesn't
       remove it from flex layout, so uncapped text still counts toward
       flex sizing even while "invisible". Overflow fades out softly
       instead of clipping mid-line. */
    max-height: 8rem;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, black 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 70%, transparent 100%);
  }

  .adventure-card--featured .adventure-card__details {
    max-height: 14rem;
  }

  .adventure-card__desc {
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
    margin: 0 0 var(--space-2xs);
  }

  .adventure-card--featured .adventure-card__desc {
    font-size: var(--fs-base);
  }

  .adventure-card__included {
    font-size: var(--fs-xs);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    margin: 0;
  }

  .adventure-card__included-label {
    font-weight: 600;
    color: var(--color-text-on-dark);
  }

  .adventure-card__credit {
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    z-index: 2;
    margin: 0;
    font-size: 0.65rem;
    color: rgba(251, 247, 241, 0.6);
    line-height: 1;
  }

  .adventure-card__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .adventure-card__credit a:hover {
    color: var(--color-text-on-dark);
  }

  .adventure-card__tap-hint {
    display: none;
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    z-index: 2;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-text-on-dark);
    background: rgba(58, 35, 28, 0.65);
    border: 1px solid rgba(251, 247, 241, 0.4);
    border-radius: 999px;
    padding: var(--space-3xs) var(--space-sm);
    cursor: pointer;
  }

  @media (prefers-reduced-motion: reduce) {
    .adventure-card__tap-hint {
      display: inline-flex;
    }

    .adventure-card__scrim-strong {
      opacity: 0;
      transition: opacity var(--duration-fast) ease;
    }

    .adventure-card__details {
      opacity: 0;
      transition: opacity var(--duration-fast) ease;
    }

    .adventure-card__scrim-strong.is-expanded,
    .adventure-card__details.is-expanded {
      opacity: 1;
    }
  }

  @media (max-width: 960px) {
    .adventure-card--featured {
      grid-column: span 2;
      grid-row: span 1;
    }
  }

  @media (max-width: 640px) {
    .adventure-card--featured {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
