---
import type { Tour } from '../data/tours';

interface Props {
  tour: Tour;
  featured?: boolean;
}

const { tour, featured = false } = Astro.props;

// Some tours' `duration` field is a real sentence (pickup times, a
// scheduling note) rather than a short "30 min"/"2h30min" — those read as
// exactly the long-sentence-on-a-card problem this component exists to
// avoid, so only genuinely short values get shown here at all.
const shortDuration = tour.duration && tour.duration.length <= 16 ? tour.duration : undefined;
---

<article class:list={['adventure-card', featured && 'adventure-card--featured']}>
  <a class="adventure-card__link" href={`/booking?tour=${tour.slug}`}>
    <div class="photo-frame adventure-card__photo">
      {
        tour.imageUrl ? (
          <img src={tour.imageUrl} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="adventure-card__photo-placeholder" aria-hidden="true" />
        )
      }
    </div>
    <div class="adventure-card__caption">
      <h3 class="adventure-card__title">{tour.name}</h3>
      {shortDuration && <span class="adventure-card__duration">{shortDuration}</span>}
    </div>
  </a>
</article>

<style>
  .adventure-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .adventure-card__photo {
    aspect-ratio: 4 / 3;
  }

  .adventure-card--featured {
    grid-column: span 2;
  }

  .adventure-card--featured .adventure-card__photo {
    aspect-ratio: 16 / 9;
  }

  @media (max-width: 640px) {
    .adventure-card--featured {
      grid-column: span 1;
    }
  }

  .adventure-card__photo-placeholder {
    width: 100%;
    height: 100%;
    background: var(--gradient-warm);
  }

  .adventure-card__caption {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .adventure-card__title {
    font-size: var(--fs-base);
    color: var(--color-text);
    margin: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .adventure-card--featured .adventure-card__title {
    font-size: var(--fs-lg);
  }

  .adventure-card__link:hover .adventure-card__title {
    color: var(--color-accent-strong);
  }

  .adventure-card__duration {
    flex-shrink: 0;
    max-width: 40%;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
