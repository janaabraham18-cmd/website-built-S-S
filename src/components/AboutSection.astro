---
interface Props {
  eyebrow?: string;
  heading?: string;
  imageUrl?: string;
  imageCredit?: { name: string; username: string };
  reverse?: boolean;
  id?: string;
}

const {
  eyebrow = 'About us',
  heading = 'Placeholder heading about the company',
  imageUrl = '',
  imageCredit,
  reverse = false,
  id,
} = Astro.props;
---

<section
  id={id}
  class:list={['about', reverse && 'about--reverse', 'reveal']}
>
  <div class="about__media reveal-item">
    {
      imageUrl ? (
        <img src={imageUrl} alt="" loading="lazy" />
      ) : (
        <div class="about__media-placeholder" aria-hidden="true">
          <span>Placeholder image</span>
        </div>
      )
    }
    {
      imageCredit && (
        <p class="about__credit">
          Photo:{' '}
          <a
            href={`https://unsplash.com/@${imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {imageCredit.name}
          </a>{' '}
          /{' '}
          <a
            href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
            target="_blank"
            rel="noopener noreferrer"
          >
            Unsplash
          </a>
        </p>
      )
    }
  </div>

  <div class="about__content">
    <p class="about__eyebrow reveal-item">{eyebrow}</p>
    <h2 class="about__heading reveal-item">{heading}</h2>
    <div class="about__body reveal-item">
      <slot>
        <p>
          Placeholder paragraph introducing the people and philosophy
          behind the company. This will be replaced with real founder
          or team copy once it's ready.
        </p>
        <p>
          A second placeholder paragraph — room for a short story about
          how the company got started or what makes its approach to
          travel different.
        </p>
      </slot>
    </div>

    <ul class="about__tags reveal-item">
      <li>Desert tours</li>
      <li>Coastal adventures</li>
      <li>Combo deals</li>
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-md);
  }

  .about--reverse {
    direction: rtl;
  }

  .about--reverse > * {
    direction: ltr;
  }

  .about__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-md);
  }

  .about__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .about__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about__credit a:hover {
    color: var(--color-text-on-dark);
  }

  .about__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-warm);
    color: var(--color-text-on-dark);
    font-size: var(--fs-sm);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .about__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .about__heading {
    margin-bottom: var(--space-md);
  }

  .about__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: 34rem;
  }

  .about__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .about__tags li {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    background: var(--color-sand-100);
    border-radius: 999px;
    padding: var(--space-2xs) var(--space-sm);
  }

  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-block: var(--space-xl);
    }

    .about--reverse {
      direction: ltr;
    }

    .about__media {
      aspect-ratio: 16 / 10;
    }

  }
</style>
