---
import type { Tour } from '../data/tours';

interface Props {
  eyebrow?: string;
  ctaLabel?: string;
  tours: Tour[];
}

const { eyebrow = 'Salt & Sun Tours', ctaLabel = 'View tour', tours } = Astro.props;

const first = tours[0];

// heroGallery photos are fetched at w=800 — right for the ~380px card in
// the stack, but the same photo also fills the full-bleed background,
// which on most screens is 1400–2500px+ wide. Reusing the 800px file there
// meant the browser upscaling it several times over (visibly soft/blurry).
// This swaps in a much larger version of the same Unsplash photo for
// background use, at full quality, while the card stack keeps the small
// one it actually needs.
const HERO_BG_WIDTH = 1920;
const toBackgroundUrl = (url: string) => url.replace(/([?&]w=)\d+/, `$1${HERO_BG_WIDTH}`);

// Payload the client script swaps through on tour change — kept lean
// (only what the hero itself renders) rather than re-shipping full Tour
// objects with `included` lists, etc.
const tourData = tours.map((tour) => {
  const gallery = tour.heroGallery ?? [];
  // Most tours reuse their first gallery photo as the background (it
  // already sits mostly hidden behind the other two cards in the stack, so
  // showing it large behind everything reads as the stack "emerging" from
  // it). A tour can set heroBg to use a different photo for the
  // background instead — e.g. a wider establishing shot that wouldn't work
  // as a small card.
  const bgPhoto = tour.heroBg ?? gallery[0];
  return {
    slug: tour.slug,
    name: tour.name,
    tagline: tour.tagline ?? tour.description,
    gallery,
    bg: bgPhoto ? { ...bgPhoto, imageUrl: toBackgroundUrl(bgPhoto.imageUrl) } : undefined,
  };
});

const firstBg = tourData[0].bg;
---

<section class="hero hero--tours full-bleed" data-tour-hero data-tours={JSON.stringify(tourData)}>
  <h1 class="visually-hidden">Salt &amp; Sun Tours — six signature Namibian tours</h1>

  <div class="hero__bg" data-hero-bg aria-hidden="true">
    {/* Two stacked layers, not one — swapping a single image's src mid-fade
        leaves a gap where neither photo is visible (the page background
        shows through). Crossfading two real layers means something's
        always fully painted. */}
    <img
      class="hero__bg-layer is-active"
      data-hero-bg-layer="0"
      src={firstBg?.imageUrl}
      alt=""
      loading="eager"
      decoding="async"
    />
    <img class="hero__bg-layer" data-hero-bg-layer="1" alt="" loading="eager" decoding="async" />
  </div>

  <div class="container hero__grid">
    <div class="hero__panel">
      <p class="hero__eyebrow">{eyebrow}</p>

      <h2 class="hero__tour-name" data-hero-name>{first.name}</h2>
      <p class="hero__tour-tagline" data-hero-tagline>{first.tagline ?? first.description}</p>

      <a class="btn btn-primary hero__cta" data-hero-cta href={`/tours#${first.slug}`}>
        {ctaLabel}
      </a>

      <div class="hero__nav" data-hero-nav role="group" aria-label="Choose a tour">
        {
          tours.map((tour, i) => (
            <button
              type="button"
              class:list={['hero__nav-btn', i === 0 && 'is-active']}
              data-hero-nav-btn
              data-index={i}
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={`Show ${tour.name}`}
            >
              {String(i + 1).padStart(2, '0')}
            </button>
          ))
        }
      </div>
    </div>

    <div class="hero__gallery">
      <div class="hero__stack" data-hero-stack aria-hidden="true">
        {
          [0, 1, 2].map((i) => {
            const photo = first.heroGallery?.[i];
            return (
              <div class={`hero__card hero__card--${i}`} data-hero-card data-index={i}>
                <img
                  class="hero__card-layer is-active"
                  data-hero-card-layer="0"
                  src={photo?.imageUrl}
                  alt={photo?.alt}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                <img
                  class="hero__card-layer"
                  data-hero-card-layer="1"
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
              </div>
            );
          })
        }
      </div>

      <p class="hero__credit" data-hero-credit hidden={!firstBg?.imageCredit}>
        Photo:{' '}
        <a
          data-hero-credit-name
          href={
            firstBg
              ? `https://unsplash.com/@${firstBg.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`
              : '#'
          }
          target="_blank"
          rel="noopener noreferrer"
        >
          {firstBg?.imageCredit.name}
        </a>{' '}
        /{' '}
        <a
          href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
          target="_blank"
          rel="noopener noreferrer"
        >
          Unsplash
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero--tours {
    /* Slow, deliberate crossfade between tours — the JS swap delay
       (setupTourHero in motion.ts) is timed to match this exactly, so the
       old content is fully faded out (not just partway) before the new
       content appears. Keeping both in one place avoids them drifting out
       of sync and reintroducing a blink. */
    --hero-crossfade: 900ms;
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
    background: var(--gradient-page-glow);
    overflow: hidden;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--hero-crossfade) ease-in-out;
  }

  .hero__bg-layer.is-active {
    opacity: 1;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    min-height: min(72vh, 640px);
  }

  /* ---------- Left panel ---------- */
  .hero__panel {
    max-width: 32rem;
  }

  /* The photo is full-bleed with no scrim over it, so the panel text sits
     directly on top of whatever's in that photo — legibility comes from a
     text-shadow on each element instead, not a background overlay. */
  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    text-shadow: 0 1px 10px rgba(31, 18, 14, 0.55);
    margin-bottom: var(--space-sm);
  }

  .hero__tour-name {
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    color: var(--color-text-on-dark);
    text-shadow: 0 4px 24px rgba(31, 18, 14, 0.55), 0 1px 4px rgba(31, 18, 14, 0.7);
    margin-bottom: var(--space-md);
    transition: opacity var(--hero-crossfade) ease-in-out;
  }

  .hero__tour-tagline {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
    text-shadow: 0 2px 12px rgba(31, 18, 14, 0.6);
    max-width: 30rem;
    margin-bottom: var(--space-lg);
    transition: opacity var(--hero-crossfade) ease-in-out;
  }

  .hero__panel.is-transitioning .hero__tour-name,
  .hero__panel.is-transitioning .hero__tour-tagline {
    opacity: 0;
  }

  .hero__cta {
    font-size: var(--fs-sm);
  }

  .hero__nav {
    display: flex;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
  }

  .hero__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    box-shadow: var(--shadow-sm);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.03em;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .hero__nav-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-strong);
  }

  .hero__nav-btn.is-active {
    background: var(--gradient-warm);
    border-color: transparent;
    color: var(--color-text-on-dark);
    transform: scale(1.06);
  }

  /* ---------- Right gallery ---------- */
  .hero__gallery {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero__stack {
    position: relative;
    width: min(80vw, 380px);
    aspect-ratio: 3 / 4;
  }

  .hero__card {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: var(--color-beige-300);
    transition: opacity var(--duration-base) var(--ease-out),
      transform var(--duration-slow) var(--ease-out);
  }

  .hero__card-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity var(--hero-crossfade) ease-in-out;
  }

  .hero__card-layer.is-active {
    opacity: 1;
  }

  .hero__card--0 {
    z-index: 1;
    transform: rotate(-9deg) translate(-14%, 5%) scale(0.9);
  }

  .hero__card--1 {
    z-index: 2;
    transform: rotate(8deg) translate(15%, 3%) scale(0.92);
  }

  .hero__card--2 {
    z-index: 3;
    transform: rotate(-1.5deg) translate(0, -3%) scale(1);
  }

  .hero__gallery:hover .hero__card--0 {
    transform: rotate(-13deg) translate(-20%, 3%) scale(0.9);
  }

  .hero__gallery:hover .hero__card--1 {
    transform: rotate(12deg) translate(21%, 1%) scale(0.92);
  }

  .hero__gallery:hover .hero__card--2 {
    transform: rotate(-1.5deg) translate(0, -5%) scale(1.02);
  }

  .hero__credit {
    position: absolute;
    right: 0;
    bottom: -1.75rem;
    z-index: 4;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.85);
    text-shadow: 0 1px 6px rgba(31, 18, 14, 0.6);
  }

  .hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hero__credit a:hover {
    color: var(--color-text-on-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__bg-layer,
    .hero__card,
    .hero__card-layer,
    .hero__gallery:hover .hero__card--0,
    .hero__gallery:hover .hero__card--1,
    .hero__gallery:hover .hero__card--2 {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__panel {
      max-width: none;
      text-align: center;
      margin-inline: auto;
    }

    .hero__nav {
      justify-content: center;
    }

    .hero__gallery {
      margin-top: var(--space-2xl);
    }

    .hero__stack {
      width: min(70vw, 320px);
    }

    .hero__credit {
      right: 50%;
      transform: translateX(50%);
    }
  }
</style>
