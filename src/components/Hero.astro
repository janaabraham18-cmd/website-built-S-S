---
interface Panel {
  imageUrl: string;
  imageCredit?: { name: string; username: string };
  letter: string;
  alt: string;
}

interface Props {
  title?: string;
  eyebrow?: string;
  subhead?: string;
  ctaLabel?: string;
  ctaHref?: string;
  panels: Panel[];
}

const {
  title = '',
  eyebrow = 'Placeholder eyebrow',
  subhead = 'Placeholder subheading copy describing the experience — swap in real copy later.',
  ctaLabel = 'Book your tour',
  ctaHref = '/booking',
  panels,
} = Astro.props;

const firstCredit = panels[0]?.imageCredit;
---

<section class="hero hero--panels full-bleed">
  <h1 class="visually-hidden">{title}</h1>

  <div class="hero__panels" data-hero-panels aria-hidden="true">
    {
      panels.map((panel, i) => (
        <div
          class:list={['hero__panel', i === 0 && 'is-active']}
          data-hero-panel
          data-credit-name={panel.imageCredit?.name}
          data-credit-username={panel.imageCredit?.username}
          style={`background-image: url(${panel.imageUrl});`}
        >
          <img class="visually-hidden" src={panel.imageUrl} alt={panel.alt} loading="eager" />
          <span class="hero__panel-letter">{panel.letter}</span>
        </div>
      ))
    }
  </div>

  <div class="hero__content container">
    <p class="hero__eyebrow">{eyebrow}</p>
    <p class="hero__subhead">{subhead}</p>
    <a class="btn btn-primary hero__cta" href={ctaHref}>{ctaLabel}</a>
  </div>

  <p class="hero__credit" data-hero-credit hidden={!firstCredit}>
    Photo:{' '}
    <a
      data-hero-credit-name
      href={firstCredit ? `https://unsplash.com/@${firstCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral` : '#'}
      target="_blank"
      rel="noopener noreferrer"
    >
      {firstCredit?.name}
    </a>{' '}
    /{' '}
    <a
      href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
      target="_blank"
      rel="noopener noreferrer"
    >
      Unsplash
    </a>
  </p>

  <a href="#scroll-target" class="hero__scroll-cue" aria-label="Scroll to content">
    <span class="hero__scroll-cue-line"></span>
  </a>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-end;
    color: var(--color-text-on-dark);
    overflow: hidden;
  }

  .hero__panels {
    position: absolute;
    inset: 0;
    display: flex;
  }

  .hero__panel {
    position: relative;
    flex: 1 1 0%;
    min-width: 0;
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
    transition: flex-grow 1.2s var(--ease-out);
  }

  .hero__panel::before {
    /* Per-panel scrim so every letter stays legible regardless of what's
       behind it, brightest at top (where the letter sits) and bottom
       (where the content bar sits), lighter through the middle so the
       photo itself still reads. */
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.55) 0%,
      rgba(31, 18, 14, 0.15) 22%,
      rgba(31, 18, 14, 0.1) 55%,
      rgba(31, 18, 14, 0.75) 100%
    );
  }

  .hero__panel:not(:last-child) {
    box-shadow: inset -1px 0 0 rgba(251, 247, 241, 0.15);
  }

  .hero__panel.is-active {
    flex-grow: 3.4;
  }

  .hero__panel-letter {
    position: absolute;
    top: 9%;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4.2vw, 3.25rem);
    letter-spacing: 0.04em;
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.45);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-xl) var(--space-md) var(--space-3xl);
  }

  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin-bottom: var(--space-sm);
  }

  .hero__subhead {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
    margin: 0 auto var(--space-lg);
    max-width: 34rem;
  }

  .hero__cta {
    font-size: var(--fs-sm);
  }

  .hero__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.65);
  }

  .hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .hero__credit a:hover {
    color: var(--color-text-on-dark);
  }

  .hero__scroll-cue {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 24px;
    height: 40px;
    border: 2px solid rgba(251, 247, 241, 0.7);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .hero__scroll-cue-line {
    width: 3px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-sand-100);
    animation: scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes scroll-cue {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    70% {
      opacity: 0;
      transform: translateY(10px);
    }
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-cue-line {
      animation: none;
    }

    .hero__panel {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .hero__content {
      padding: var(--space-lg) var(--space-md) var(--space-2xl);
    }

    .hero__panel-letter {
      font-size: clamp(1.1rem, 6vw, 1.75rem);
    }
  }
</style>
