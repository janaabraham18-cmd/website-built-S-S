---
const FORMSPREE_ID = 'xnpjqayr';
---

<form class="form" action={`https://formspree.io/f/${FORMSPREE_ID}`} method="POST">
  <div class="form-row">
    <label for="contact-name">Full name</label>
    <input type="text" id="contact-name" name="name" autocomplete="name" required />
  </div>

  <div class="form-row">
    <label for="contact-email">Email</label>
    <input type="email" id="contact-email" name="email" autocomplete="email" required />
  </div>

  <div class="form-row">
    <label for="contact-message">Message</label>
    <textarea id="contact-message" name="message" required></textarea>
  </div>

  <!-- Honeypot: invisible to real visitors, but bots that blindly fill
       every field they find will fill this one too — Formspree silently
       discards any submission where its reserved "_gotcha" field isn't
       empty, so this needs no validation logic on our side. -->
  <input
    type="text"
    name="_gotcha"
    class="form-honeypot"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <button type="submit" class="btn btn-primary form-submit">
    <span data-submit-label>Send message</span>
    <span class="btn__spinner" data-submit-spinner aria-hidden="true" hidden></span>
  </button>
</form>
