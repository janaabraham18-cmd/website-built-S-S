---
import type { Tour } from '../data/tours';
import { categoryLabels } from '../data/tours';

interface Props {
  tour: Tour;
  imageUrl?: string;
  showCategory?: boolean;
}

const { tour, imageUrl, showCategory = false } = Astro.props;
---

<article class="tour-card reveal-item" id={tour.slug}>
  {
    imageUrl && (
      <div class="tour-card__media">
        <img src={imageUrl} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="tour-card__body">
    {showCategory && (
      <span class="tour-card__category">{categoryLabels[tour.category].label}</span>
    )}

    <h3 class="tour-card__name">{tour.name}</h3>
    <p class="tour-card__desc">{tour.description}</p>

    {(tour.duration || tour.note) && (
      <p class="tour-card__meta">
        {tour.duration && <span>{tour.duration}</span>}
        {tour.duration && tour.note && <span aria-hidden="true"> · </span>}
        {tour.note && <span>{tour.note}</span>}
      </p>
    )}

    <ul class="tour-card__included">
      {tour.included.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>
</article>

<style>
  .tour-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    scroll-margin-top: 6rem;
  }

  .tour-card__media {
    aspect-ratio: 16 / 10;
  }

  .tour-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    padding: var(--space-lg);
  }

  .tour-card__category {
    align-self: start;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-accent-strong);
    background: var(--color-sand-100);
    padding: var(--space-3xs) var(--space-xs);
    border-radius: var(--radius-sm);
  }

  .tour-card__name {
    font-size: var(--fs-lg);
    margin: 0;
  }

  .tour-card__desc {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0;
  }

  .tour-card__meta {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0;
  }

  .tour-card__included {
    list-style: none;
    margin: var(--space-2xs) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .tour-card__included li {
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: var(--space-3xs) var(--space-xs);
  }
</style>
