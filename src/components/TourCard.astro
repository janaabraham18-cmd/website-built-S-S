---
import type { Tour } from '../data/tours';

interface Props {
  tour: Tour;
  reverse?: boolean;
}

const { tour, reverse = false } = Astro.props;
---

<article class:list={['tour-row', reverse && 'tour-row--reverse']}>
  <div class="tour-row__media">
    {
      tour.imageUrl ? (
        <img src={tour.imageUrl} alt="" loading="lazy" decoding="async" />
      ) : (
        <div class="tour-row__media-placeholder" aria-hidden="true" />
      )
    }
    <div class="tour-row__media-gradient" aria-hidden="true"></div>
    <h3 class="tour-row__title">{tour.name}</h3>
    {
      tour.imageCredit && (
        <p class="tour-row__credit">
          Photo:{' '}
          <a
            href={`https://unsplash.com/@${tour.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {tour.imageCredit.name}
          </a>{' '}
          /{' '}
          <a
            href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
            target="_blank"
            rel="noopener noreferrer"
          >
            Unsplash
          </a>
        </p>
      )
    }
  </div>

  <div class="tour-row__panel">
    {tour.duration && <span class="tour-row__badge">{tour.duration}</span>}

    <p class="tour-row__desc">{tour.description}</p>

    {tour.note && <p class="tour-row__meta">{tour.note}</p>}

    <p class="tour-row__included">
      <span class="tour-row__included-label">Includes</span> {tour.included.join(', ')}
    </p>

    <a class="btn btn-primary tour-row__cta" href={`/booking?tour=${tour.slug}`}>
      Book this tour
    </a>
  </div>
</article>

<style>
  .tour-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 85vh;
    overflow: hidden;
  }

  .tour-row--reverse .tour-row__media {
    order: 2;
  }

  .tour-row--reverse .tour-row__panel {
    order: 1;
  }

  .tour-row__media {
    position: relative;
    overflow: hidden;
    z-index: 1;
  }

  .tour-row__media img,
  .tour-row__media-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-row__media-placeholder {
    background: var(--gradient-warm);
  }

  .tour-row__media-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(31, 18, 14, 0.85) 0%, transparent 60%);
  }

  .tour-row__title {
    position: absolute;
    left: var(--space-lg);
    right: var(--space-lg);
    bottom: var(--space-lg);
    z-index: 1;
    font-size: var(--fs-2xl);
    color: var(--color-text-on-dark);
    margin: 0;
  }

  .tour-row__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.65);
  }

  .tour-row__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-row__credit a:hover {
    color: var(--color-text-on-dark);
  }

  .tour-row__panel {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-3xl);
    /* Cream, not pure white — a solid-white panel here spans half of every
       85vh row, stacked one after another, which reads as the whole page
       having dropped to plain white rather than the site's warm tone. */
    background: var(--color-bg-alt);
  }

  .tour-row__badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    padding: var(--space-3xs) var(--space-sm);
    border-radius: 999px;
    background: var(--color-sand-100);
    color: var(--color-accent-strong);
    font-size: var(--fs-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .tour-row__desc {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0;
    max-width: 32rem;
  }

  .tour-row__meta {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0;
  }

  .tour-row__included {
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
    max-width: 32rem;
  }

  .tour-row__included-label {
    font-weight: 600;
    color: var(--color-text);
  }

  .tour-row__cta {
    align-self: flex-start;
    margin-top: var(--space-2xs);
  }

  @media (max-width: 768px) {
    .tour-row {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .tour-row--reverse .tour-row__media,
    .tour-row--reverse .tour-row__panel {
      order: initial;
    }

    .tour-row__media {
      aspect-ratio: 4 / 3;
    }

    .tour-row__title {
      font-size: var(--fs-xl);
    }

    .tour-row__panel {
      padding: var(--space-lg);
    }
  }
</style>
