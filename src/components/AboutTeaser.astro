---
interface Props {
  imageUrl?: string;
  imageAlt?: string;
  imageCredit?: { name: string; username: string };
}

const { imageUrl, imageAlt = '', imageCredit } = Astro.props;
---

<section class="about-teaser reveal">
  <div class="about-teaser__media reveal-item">
    {imageUrl && <img src={imageUrl} alt={imageAlt} loading="lazy" decoding="async" />}
    {
      imageCredit && (
        <p class="about-teaser__credit">
          Photo:{' '}
          <a
            href={`https://unsplash.com/@${imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {imageCredit.name}
          </a>{' '}
          /{' '}
          <a
            href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
            target="_blank"
            rel="noopener noreferrer"
          >
            Unsplash
          </a>
        </p>
      )
    }
  </div>

  <div class="about-teaser__content reveal-item">
    <p class="about-teaser__eyebrow">Salt &amp; Sun Tours</p>
    <h2 class="about-teaser__heading">More Than a Journey</h2>

    <p class="about-teaser__body">
      My name is Lenga, and Lenga means King. My roots are in Etosha, where
      the heart of Salt &amp; Sun Tours begins — from the salt of the
      earth, under the Namibian sun, grounded in a purpose greater than
      tourism.
    </p>
    <p class="about-teaser__body about-teaser__body--emphasis">
      For us, a tour was never just about the dunes. It's about the person
      you become along the way.
    </p>

    <a class="btn btn-outline about-teaser__cta" href="/about">Read our story</a>
  </div>
</section>

<style>
  .about-teaser {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
    max-width: var(--content-width);
    margin-inline: auto;
    padding: var(--space-2xl) var(--space-md);
  }

  .about-teaser__media {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    box-shadow: var(--shadow-md);
  }

  .about-teaser__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-teaser__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .about-teaser__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-teaser__credit a:hover {
    color: var(--color-text-on-dark);
  }

  .about-teaser__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .about-teaser__heading {
    margin-bottom: var(--space-md);
  }

  .about-teaser__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: 32rem;
    margin: 0 0 var(--space-md);
  }

  .about-teaser__body--emphasis {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--color-earth-900);
  }

  .about-teaser__cta {
    margin-top: var(--space-sm);
  }

  @media (max-width: 860px) {
    .about-teaser {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      padding-block: var(--space-xl);
    }

    .about-teaser__media {
      aspect-ratio: 16 / 10;
    }
  }
</style>
