---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/tours', label: 'Tours' },
  { href: '/adventures', label: 'Adventures' },
  { href: '/journeys', label: 'Journeys' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/booking', label: 'Booking' },
  { href: '/faq', label: 'FAQ' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__logo">
      <svg class="site-header__mark" viewBox="0 0 40 40" aria-hidden="true">
        <defs>
          <clipPath id="logo-mark-clip">
            <circle cx="20" cy="20" r="19" />
          </clipPath>
        </defs>
        <g clip-path="url(#logo-mark-clip)">
          <rect x="0" y="0" width="40" height="20" fill="#d1754a" />
          <!-- Reflection lines: each is a true chord of the r=19 circle at
               its y, so the taper comes from the geometry rather than a
               hand-picked width per line. -->
          <rect x="1.11" y="22" width="37.79" height="1.3" rx="0.65" fill="#8b6762" />
          <rect x="1.54" y="24.5" width="36.92" height="1.3" rx="0.65" fill="#8b6762" />
          <rect x="2.34" y="27" width="35.33" height="1.3" rx="0.65" fill="#8b6762" />
          <rect x="3.55" y="29.5" width="32.91" height="1.3" rx="0.65" fill="#8b6762" />
          <rect x="5.27" y="32" width="29.46" height="1.3" rx="0.65" fill="#8b6762" />
          <rect x="7.72" y="34.5" width="24.56" height="1.3" rx="0.65" fill="#8b6762" />
          <rect x="11.51" y="37" width="16.97" height="1.3" rx="0.65" fill="#8b6762" />
        </g>
      </svg>
      Salt and <span class="site-header__logo-accent">Sun</span> Tours
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="site-header__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="site-header__mobile-nav" aria-label="Mobile">
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* A whisper of the same ochre glow as the page background (see
       --gradient-page-glow), so the sticky bar reads as part of the page
       rather than a flat UI chrome slapped on top of it. */
    background: linear-gradient(180deg, rgba(211, 162, 79, 0.14) 0%, rgba(251, 247, 241, 0.92) 65%),
      rgba(251, 247, 241, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /* Once scrolled off the top, the bar recedes to 40% opacity so it
     stops competing with the page content — hovering (or a mobile tap
     landing on it) brings it back to full strength so it's never
     actually hard to read or use. */
  .site-header.is-scrolled {
    opacity: 0.4;
  }

  .site-header.is-scrolled:hover,
  .site-header.is-scrolled:focus-within {
    opacity: 1;
  }

  .site-header__inner {
    /* Wider than the site's standard .container, same reasoning as the
       footer's __inner: the logo sits closer to the page's true left
       edge instead of inheriting the main content column's narrower
       centering margin. */
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-sm);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    /* Besley: the refined brand concept's wordmark serif — brought in
       just for this lockup rather than swapped into --font-display
       sitewide, since only the logo itself was asked to change. */
    font-family: "Besley", Georgia, "Times New Roman", serif;
    font-weight: 600;
    font-size: var(--fs-lg);
    text-decoration: none;
    text-transform: uppercase;
    color: var(--color-earth-900);
    letter-spacing: 0.04em;
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Same device as the sitewide one-accent-word heading treatment
     (.accent-word in global.css) — "Sun" picked out in the same warm
     orange, scoped to just this logo text rather than reusing that class
     directly, since the logo isn't a heading. */
  .site-header__logo-accent {
    color: var(--color-heading-accent);
  }

  .site-header__mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .site-header__links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Same display font as the logo right next to it — previously these
     inherited the plain body font, so the header read as two different
     typographic voices side by side instead of one connected unit. */
  .site-header__links a {
    position: relative;
    display: inline-block;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding-bottom: 3px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent-strong);
    transform: scaleX(0);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .site-header__links a:hover {
    color: var(--color-accent-strong);
  }

  .site-header__links a:hover::after {
    transform: scaleX(1);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-earth-900);
    transition: transform var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .site-header__mobile-nav {
    display: none;
    max-height: 0;
    overflow: hidden;
    background: var(--color-bg-alt);
    transition: max-height var(--duration-base) var(--ease-out);
  }

  .site-header__mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: var(--space-sm) var(--space-md) var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  .site-header__mobile-nav a {
    text-decoration: none;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text);
  }

  .site-header.is-open .site-header__mobile-nav {
    max-height: 20rem;
  }

  .site-header.is-open .site-header__toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.is-open .site-header__toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header.is-open .site-header__toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* The full logo wordmark + all 8 nav links need ~1180px with zero
     breathing room (measured directly) — comfortably more than the
     768px this used to switch at, which let the tablet range (~768–
     900px) and narrower laptop windows reach this with neither the desktop
     nav nor the logo having room, wrapping the logo text into a stack
     that overlaps the nav. Switching to the hamburger pattern earlier,
     at 1200px, guarantees they never compete for space. */
  @media (max-width: 1200px) {
    .site-header__nav {
      display: none;
    }

    .site-header__toggle {
      display: flex;
    }

    .site-header__mobile-nav {
      display: block;
    }
  }
</style>
