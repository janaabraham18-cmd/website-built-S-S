---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/tours', label: 'Tours' },
  { href: '/booking', label: 'Booking' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href="/" class="site-header__logo">
      <svg class="site-header__mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <path
          d="M3 23c3.2-6.4 8.4-9.6 13-9.6s9.8 3.2 13 9.6"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
        />
        <circle cx="16" cy="12.5" r="4.5" stroke="currentColor" stroke-width="1.6" />
      </svg>
      Salt &amp; Sun Tours
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="site-header__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="site-header__mobile-nav" aria-label="Mobile">
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* A whisper of the same ochre glow as the page background (see
       --gradient-page-glow), so the sticky bar reads as part of the page
       rather than a flat UI chrome slapped on top of it. */
    background: linear-gradient(180deg, rgba(211, 162, 79, 0.14) 0%, rgba(251, 247, 241, 0.92) 65%),
      rgba(251, 247, 241, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-sm);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    text-decoration: none;
    color: var(--color-earth-900);
    letter-spacing: 0.02em;
  }

  .site-header__mark {
    width: 22px;
    height: 22px;
    color: var(--color-accent-strong);
    flex-shrink: 0;
  }

  .site-header__links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__links a {
    position: relative;
    display: inline-block;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding-bottom: 3px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent-strong);
    transform: scaleX(0);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .site-header__links a:hover {
    color: var(--color-accent-strong);
  }

  .site-header__links a:hover::after {
    transform: scaleX(1);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-earth-900);
    transition: transform var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .site-header__mobile-nav {
    display: none;
    max-height: 0;
    overflow: hidden;
    background: var(--color-bg-alt);
    transition: max-height var(--duration-base) var(--ease-out);
  }

  .site-header__mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: var(--space-sm) var(--space-md) var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  .site-header__mobile-nav a {
    text-decoration: none;
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-text);
  }

  .site-header.is-open .site-header__mobile-nav {
    max-height: 20rem;
  }

  .site-header.is-open .site-header__toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.is-open .site-header__toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header.is-open .site-header__toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .site-header__nav {
      display: none;
    }

    .site-header__toggle {
      display: flex;
    }

    .site-header__mobile-nav {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.getElementById('nav-toggle');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });
</script>
