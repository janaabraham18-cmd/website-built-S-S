---
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/tours', label: 'Tours' },
  { href: '/booking', label: 'Booking' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="site-header__inner container">
    <a href="/" class="site-header__logo">
      <svg class="site-header__mark" viewBox="0 0 40 40" aria-hidden="true">
        <defs>
          <clipPath id="logo-mark-clip">
            <circle cx="20" cy="20" r="19" />
          </clipPath>
        </defs>
        <g clip-path="url(#logo-mark-clip)">
          <rect x="0" y="0" width="40" height="19.5" fill="#e2884d" />
          <rect x="0" y="20.5" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="23" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="25.5" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="28" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="30.5" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="33" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="35.5" width="40" height="1.6" rx="0.8" fill="#a68885" />
          <rect x="0" y="38" width="40" height="1.6" rx="0.8" fill="#a68885" />
        </g>
      </svg>
      Salt and Sun Tours
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul class="site-header__links">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="site-header__toggle"
      id="nav-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Toggle navigation menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <nav id="mobile-nav" class="site-header__mobile-nav" aria-label="Mobile">
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* A whisper of the same ochre glow as the page background (see
       --gradient-page-glow), so the sticky bar reads as part of the page
       rather than a flat UI chrome slapped on top of it. */
    background: linear-gradient(180deg, rgba(211, 162, 79, 0.14) 0%, rgba(251, 247, 241, 0.92) 65%),
      rgba(251, 247, 241, 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
    transition: opacity var(--duration-base) var(--ease-out);
  }

  /* Once scrolled off the top, the bar recedes to 40% opacity so it
     stops competing with the page content — hovering (or a mobile tap
     landing on it) brings it back to full strength so it's never
     actually hard to read or use. */
  .site-header.is-scrolled {
    opacity: 0.4;
  }

  .site-header.is-scrolled:hover,
  .site-header.is-scrolled:focus-within {
    opacity: 1;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-sm);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    text-decoration: none;
    color: var(--color-earth-900);
    letter-spacing: 0.02em;
  }

  .site-header__mark {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .site-header__links {
    display: flex;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-header__links a {
    position: relative;
    display: inline-block;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    padding-bottom: 3px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .site-header__links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--color-accent-strong);
    transform: scaleX(0);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .site-header__links a:hover {
    color: var(--color-accent-strong);
  }

  .site-header__links a:hover::after {
    transform: scaleX(1);
  }

  .site-header__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .site-header__toggle span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--color-earth-900);
    transition: transform var(--duration-fast) var(--ease-out),
      opacity var(--duration-fast) var(--ease-out);
  }

  .site-header__mobile-nav {
    display: none;
    max-height: 0;
    overflow: hidden;
    background: var(--color-bg-alt);
    transition: max-height var(--duration-base) var(--ease-out);
  }

  .site-header__mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: var(--space-sm) var(--space-md) var(--space-md);
    display: grid;
    gap: var(--space-sm);
  }

  .site-header__mobile-nav a {
    text-decoration: none;
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--color-text);
  }

  .site-header.is-open .site-header__mobile-nav {
    max-height: 20rem;
  }

  .site-header.is-open .site-header__toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.is-open .site-header__toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header.is-open .site-header__toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .site-header__nav {
      display: none;
    }

    .site-header__toggle {
      display: flex;
    }

    .site-header__mobile-nav {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector('.site-header');
  const toggle = document.getElementById('nav-toggle');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  const SCROLL_FADE_THRESHOLD = 40;
  const updateScrolledState = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > SCROLL_FADE_THRESHOLD);
  };

  updateScrolledState();
  window.addEventListener('scroll', updateScrolledState, { passive: true });
</script>
