---
interface Props {
  imageUrl: string;
  imageCredit?: { name: string; username: string };
}

const { imageUrl, imageCredit } = Astro.props;

const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<div class="picture-break">
  <div
    class="picture-break__photo"
    data-picture-break-photo
    style={`background-image:url('${imageUrl}')`}
    aria-hidden="true"
  ></div>
  {imageCredit && (
    <p class="picture-break__credit">
      Photo:{' '}
      <a href={creditHref(imageCredit.username)} target="_blank" rel="noopener noreferrer">
        {imageCredit.name}
      </a>{' '}
      / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
    </p>
  )}
</div>

<style>
  /* A short full-bleed photo strip between the homepage's product bands —
     just a breather between three back-to-back content sections, not
     another thing to read. Shown fully defined (full strength, no wash
     over the photo — same "fully defined" treatment as booking/contact):
     only the outer top/bottom edges fade to transparent so the section's
     own background color shows through gradually there, while the rest
     of the photo stays completely opaque. The photo is oversized (see
     the -22% inset) so setupPictureBreakParallax in motion.ts has room
     to drift it without ever exposing a hard edge. */
  .picture-break {
    position: relative;
    min-height: clamp(260px, 34vw, 460px);
    overflow: hidden;
    background: var(--color-sand-50);
  }

  .picture-break__photo {
    position: absolute;
    inset: -22% 0;
    background-size: cover;
    background-position: center;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 16%, black 84%, transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0%, black 16%, black 84%, transparent 100%);
    will-change: transform;
  }

  .picture-break__credit {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-xs);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(58, 35, 28, 0.55);
  }

  .picture-break__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
