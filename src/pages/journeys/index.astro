---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NamibiaMap from '../../components/NamibiaMap.astro';
import { journeys, tripTypeLabels } from '../../data/journeys';
import { journeyRoutes } from '../../data/journeyRoutes';

const mapBgPhoto = {
  url: 'https://images.unsplash.com/photo-1639402477646-e88e811eef21?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Andrew Svk', username: 'andrew_svk' },
};
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<BaseLayout
  title="Journeys"
  description="Multi-day, multi-location journeys across Namibia with Salt and Sun Tours — a set route, planned day by day."
>
  <div class="journeys-page">
    <section class="journeys-hero">
      <svg
        class="journeys-hero__scene"
        viewBox="0 0 1600 800"
        preserveAspectRatio="xMidYMax slice"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <clipPath id="journeys-sun-clip">
            <circle cx="0" cy="0" r="50" />
          </clipPath>
        </defs>

        <path
          class="journeys-hero__dune journeys-hero__dune--back"
          d="M0,560 C200,520 400,540 600,510 C800,480 1000,520 1200,500 C1400,480 1500,510 1600,495 L1600,800 L0,800 Z"
        />
        <path
          class="journeys-hero__dune journeys-hero__dune--mid"
          d="M0,640 C250,590 450,650 700,610 C950,570 1150,630 1350,590 C1450,575 1550,600 1600,590 L1600,800 L0,800 Z"
        />

        <path
          data-journeys-trail
          class="journeys-hero__trail"
          d="M80,640 C280,560 380,680 580,600 C780,520 880,640 1080,580 C1280,500 1380,580 1560,540"
          fill="none"
        />

        <g
          data-journeys-sun
          data-start-x="100"
          data-start-y="600"
          data-peak-x="800"
          data-peak-y="140"
          data-end-x="1500"
          data-end-y="600"
          class="journeys-hero__sun"
        >
          <circle class="journeys-hero__sun-glow" cx="0" cy="0" r="90" />
          <g clip-path="url(#journeys-sun-clip)">
            <rect x="-50" y="-50" width="100" height="48.75" fill="#e2884d" />
            <rect x="-50" y="1.25" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="7.5" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="13.75" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="20" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="26.25" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="32.5" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="38.75" width="100" height="4" rx="2" fill="#a68885" />
            <rect x="-50" y="45" width="100" height="4" rx="2" fill="#a68885" />
          </g>
        </g>

        <path
          class="journeys-hero__dune journeys-hero__dune--front"
          d="M0,700 C300,630 500,720 800,660 C1050,610 1250,680 1450,630 C1520,615 1560,640 1600,630 L1600,800 L0,800 Z"
        />
      </svg>

      <div class="container journeys-hero__content">
        <p class="journeys-hero__eyebrow">Beyond a single day</p>
        <h1>Journeys</h1>
        <p class="journeys-hero__subhead">
          A Journey strings several of our tours and destinations together into one
          set route across Namibia, planned day by day — not just a longer version
          of a single tour. Four routes exist already; tell us what you have in
          mind and we'll plan another.
        </p>
        {journeys.length > 0 && (
          <a class="btn btn-primary" href={`#${journeys[0].slug}`}>Start exploring</a>
        )}
      </div>

      <a href="#scroll-target" class="journeys-hero__scroll-cue" aria-label="Scroll to content">
        <span />
      </a>
    </section>
    <div id="scroll-target"></div>

    {
      journeys.length > 0 ? (
        journeys.map((journey, i) => (
          <section
            class:list={['journey-feature', 'reveal', i % 2 === 1 && 'journey-feature--reverse']}
            id={journey.slug}
          >
            <div class="journey-feature__media">
              <img src={journey.heroImage} alt={journey.name} loading="lazy" decoding="async" />
              <div class="journey-feature__media-gradient" aria-hidden="true" />

              <div class="journey-feature__media-content">
                <p class="journey-feature__eyebrow">
                  {journey.durationDays}-Day Journey · {tripTypeLabels[journey.tripType]}
                </p>
                <h2 class="journey-feature__name">{journey.name}</h2>
                <p class="journey-feature__tagline">{journey.tagline}</p>
                <p class="journey-feature__regions">{journey.regions.join(' · ')}</p>
                <a
                  class="btn btn-primary journey-feature__cta"
                  href={`/booking?journey=${encodeURIComponent(journey.name)}#booking-form`}
                >
                  Book this Journey
                </a>
              </div>

              {journey.imageCredit && (
                <p class="journey-feature__credit">
                  Photo:{' '}
                  <a href={creditHref(journey.imageCredit.username)} target="_blank" rel="noopener noreferrer">
                    {journey.imageCredit.name}
                  </a>{' '}
                  / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                </p>
              )}
            </div>

            <div class="journey-feature__content reveal-item">
              <h3 class="journey-feature__content-heading">Day by day</h3>
              <ol class="journey-feature__timeline">
                {journey.itinerary.map((day) => (
                  <li class="journey-feature__timeline-item">
                    <span class="journey-feature__timeline-day">Day {day.day}</span>
                    <div>
                      <h4>{day.title}</h4>
                      <p class="journey-feature__timeline-location">{day.location}</p>
                      <p>{day.description}</p>
                    </div>
                  </li>
                ))}
              </ol>

              <div class="journey-feature__lists">
                <div>
                  <h4>Includes</h4>
                  <ul>
                    {journey.includes.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                {journey.excludes.length > 0 && (
                  <div>
                    <h4>Excludes</h4>
                    <ul>
                      {journey.excludes.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </section>
        ))
      ) : (
        <section class="journeys-empty reveal">
          <div class="container">
            <div class="journeys-empty__card reveal-item">
              <p class="journeys-header__eyebrow">Every journey starts with a conversation</p>
              <h2 class="journeys-empty__heading">Tell us how long you have and where you'd like to go</h2>
              <p class="journeys-empty__body">
                We're still building out our set-route Journeys — but if you already know
                you want more than one day, get in touch and we'll design a day-by-day
                route around the time you have, combining tours and destinations across
                Namibia into one trip.
              </p>
              <div class="journeys-empty__actions">
                <a class="btn btn-primary" href="/contact">Start planning a Journey</a>
                <a class="btn btn-outline" href="/tours">See our single-day tours</a>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      journeys.length > 0 && (
        <section class="journeys-map-section reveal">
          <div class="journeys-map-section__bg" style={`background-image:url('${mapBgPhoto.url}')`} aria-hidden="true"></div>

          <div class="container">
            <div class="journeys-map-intro reveal-item">
              <p class="eyebrow">The Route Book</p>
              <h2>Every Route, Plotted</h2>
              <p>Four routes charted across Namibia — tap a name to jump straight to its itinerary above.</p>
            </div>

            <div class="journeys-map reveal-item">
              <div class="journeys-map__canvas">
                <NamibiaMap routes={journeyRoutes} />
              </div>

              <ul class="journeys-map__key">
                {journeys.map((journey) => {
                  const route = journeyRoutes.find((r) => r.slug === journey.slug);
                  if (!route) return null;
                  return (
                    <li>
                      <a href={`#${journey.slug}`}>
                        <svg class="journeys-map__key-swatch" width="28" height="10" aria-hidden="true">
                          <line
                            x1="0"
                            y1="5"
                            x2="28"
                            y2="5"
                            stroke={route.color}
                            stroke-width="3.5"
                            stroke-dasharray={route.dash}
                            stroke-linecap="round"
                          />
                        </svg>
                        <span>
                          <strong>{journey.durationDays}-Day</strong> {journey.name.replace(/^\d+-Day /, '')}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>

          <p class="journeys-map-section__credit">
            Photo:{' '}
            <a href={creditHref(mapBgPhoto.credit.username)} target="_blank" rel="noopener noreferrer">{mapBgPhoto.credit.name}</a>{' '}
            /{' '}
            <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .journeys-page {
    position: relative;
    z-index: 0;
  }

  /* Eyebrow reused by the empty-state card below (light background). */
  .journeys-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  /* ---------- Journeys hero ---------- */
  /* Not a photo and not a diagram: a day passing over the dunes. The
     brand's own sun mark (same striped-reflection shape as the header
     logo) arcs from one horizon to the other while a trail draws itself
     in beneath it — movement (the arc), change (the sky it crosses) and
     growth (the trail extending) in one scene, entirely original SVG,
     no photography or map reuse. See setupJourneysHeroScene in motion.ts. */
  .journeys-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    background: linear-gradient(
      180deg,
      var(--color-sand-100) 0%,
      var(--color-ochre-400) 45%,
      var(--color-terracotta-600) 75%,
      var(--color-earth-900) 100%
    );
    color: var(--color-earth-900);
  }

  .journeys-hero__scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .journeys-hero__dune {
    fill: var(--color-ochre-500);
  }

  .journeys-hero__dune--mid {
    fill: var(--color-terracotta-600);
  }

  .journeys-hero__dune--front {
    fill: var(--color-earth-900);
  }

  .journeys-hero__trail {
    stroke: rgba(251, 247, 241, 0.85);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .journeys-hero__sun-glow {
    fill: rgba(226, 136, 77, 0.35);
  }

  /* Resting position (also the reduced-motion state, since the arc/draw-in
     JS never runs then): roughly where the arc's midpoint sits, so a
     visitor who never sees the animation still gets a sensible scene
     instead of the sun pinned to the SVG's raw (0,0) origin. GSAP's
     inline transform overrides this the moment the animation starts. */
  .journeys-hero__sun {
    transform: translate(1150px, 560px);
  }

  .journeys-hero__content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    padding-top: clamp(5rem, 16vh, 9rem);
  }

  .journeys-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-earth-900);
    text-shadow: 0 1px 12px rgba(251, 247, 241, 0.5);
    margin: 0 0 var(--space-sm);
  }

  .journeys-hero__content h1 {
    color: var(--color-earth-900);
    text-shadow: 0 1px 20px rgba(251, 247, 241, 0.4);
    margin: 0 0 var(--space-md);
  }

  .journeys-hero__subhead {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-earth-900);
    text-shadow: 0 1px 12px rgba(251, 247, 241, 0.4);
    margin: 0 0 var(--space-lg);
  }

  .journeys-hero__scroll-cue {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 24px;
    height: 40px;
    border: 2px solid rgba(58, 35, 28, 0.5);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .journeys-hero__scroll-cue span {
    width: 3px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-earth-900);
    animation: journeys-hero-scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes journeys-hero-scroll-cue {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    70%,
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journeys-hero__scroll-cue span {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .journeys-hero__content {
      padding-top: var(--space-2xl);
    }
  }

  .journeys-empty {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .journeys-empty__card {
    max-width: var(--content-width-narrow);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-lg);
  }

  .journeys-empty__heading {
    margin: 0 0 var(--space-sm);
  }

  .journeys-empty__body {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-lg);
  }

  .journeys-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* ---------- Journey feature sections ---------- */
  /* One full section per journey instead of a card grid — the photo
     panel stays pinned while its own day-by-day content scrolls past
     beside it, alternating sides journey to journey (same alternating
     convention as .tour-row on the tours page). */
  .journey-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(320px, 42%) 1fr;
    scroll-margin-top: 5rem;
  }

  .journey-feature--reverse {
    grid-template-columns: 1fr minmax(320px, 42%);
  }

  .journey-feature--reverse .journey-feature__media {
    order: 2;
  }

  .journey-feature--reverse .journey-feature__content {
    order: 1;
  }

  .journey-feature__media {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .journey-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journey-feature__media-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.15) 0%,
      rgba(31, 18, 14, 0.05) 35%,
      rgba(31, 18, 14, 0.85) 100%
    );
  }

  .journey-feature__media-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-xl) var(--space-lg);
  }

  .journey-feature__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-2xs);
  }

  .journey-feature__name {
    color: var(--color-text-on-dark);
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__tagline {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__regions {
    font-size: var(--fs-sm);
    color: var(--color-sand-100);
    margin: 0 0 var(--space-md);
  }

  .journey-feature__credit {
    position: absolute;
    right: var(--space-sm);
    top: var(--space-sm);
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journey-feature__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .journey-feature__content {
    background: var(--color-surface);
    padding: var(--space-2xl) var(--space-xl);
  }

  .journey-feature__content-heading {
    margin: 0 0 var(--space-md);
  }

  .journey-feature__timeline {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .journey-feature__timeline-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .journey-feature__timeline-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .journey-feature__timeline-day {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent-strong);
  }

  .journey-feature__timeline-item h4 {
    margin: 0 0 0.2rem;
  }

  .journey-feature__timeline-location {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0 0 0.4rem;
  }

  .journey-feature__timeline-item p:not(.journey-feature__timeline-location) {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0;
  }

  .journey-feature__lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .journey-feature__lists h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__lists ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .journey-feature__lists li {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    padding-left: 1.1rem;
    position: relative;
  }

  .journey-feature__lists li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-strong);
  }

  @media (max-width: 900px) {
    .journey-feature,
    .journey-feature--reverse {
      grid-template-columns: 1fr;
    }

    .journey-feature--reverse .journey-feature__media,
    .journey-feature--reverse .journey-feature__content {
      order: initial;
    }

    .journey-feature__media {
      position: relative;
      height: 70vh;
    }

    .journey-feature__content {
      padding: var(--space-xl) var(--space-md);
    }

    .journey-feature__lists {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Routes map ---------- */
  /* Same "fully defined" full-strength background photo treatment as the
     rest of the page — the map+legend panel is already an opaque white
     card, so it only needed the intro copy protected. This section is
     the last thing on the page: fully opaque throughout (photo, intro
     card, white panel), so it meets the footer directly with no stray
     strip of a different background showing through beneath it. */
  .journeys-map-section {
    position: relative;
    z-index: 0;
    padding-block: var(--space-2xl);
  }

  .journeys-map-section__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
  }

  .journeys-map-intro {
    max-width: var(--content-width-narrow);
    background: rgba(58, 35, 28, 0.72);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl);
    box-shadow: var(--shadow-lg);
  }

  .journeys-map-intro .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-2xs);
  }

  .journeys-map-intro h2 {
    color: var(--color-text-on-dark);
  }

  .journeys-map-intro p:not(.eyebrow) {
    color: var(--color-sand-200);
  }

  .journeys-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-2xl);
    align-items: center;
    margin-top: var(--space-lg);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
  }

  .journeys-map__canvas {
    aspect-ratio: 751 / 740;
  }

  .journeys-map__key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .journeys-map__key a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .journeys-map__key a:hover {
    color: var(--color-accent-strong);
  }

  .journeys-map__key-swatch {
    flex-shrink: 0;
  }

  .journeys-map__key strong {
    font-family: var(--font-display);
    font-weight: 400;
  }

  @media (max-width: 780px) {
    .journeys-map {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }
  }

  .journeys-map-section__credit {
    position: relative;
    z-index: 1;
    margin: var(--space-sm) 0 0;
    padding: 0 var(--space-md);
    text-align: right;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journeys-map-section__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .journeys-empty__card,
    .journeys-map-intro {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
