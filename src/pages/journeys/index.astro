---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NamibiaMap from '../../components/NamibiaMap.astro';
import { journeys, tripTypeLabels } from '../../data/journeys';
import { journeyRoutes } from '../../data/journeyRoutes';
import { hl } from '../../utils/text';

const journeyAccentWords: Record<string, string> = {
  '5-day-sossusvlei-coast': 'Coast',
  '10-day-namibia-grand-tour': 'Grand',
  '8-day-windhoek-coastal-discovery': 'Discovery',
  '13-day-namibia-complete-safari': 'Safari',
};

const heroPhoto = {
  url: 'https://images.unsplash.com/photo-1658239828111-75a642ac6b6d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2400',
  credit: { name: 'Colin Watts', username: 'colinwatts' },
};
const mapBgPhoto = {
  url: 'https://images.unsplash.com/photo-1639402477646-e88e811eef21?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Andrew Svk', username: 'andrew_svk' },
};
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<BaseLayout
  title="Journeys"
  description="Multi-day, multi-location journeys across Namibia with Salt and Sun Tours — a set route, planned day by day."
>
  <div class="journeys-page">
    <section class="journeys-hero">
      <div class="journeys-hero__bg" style={`background-image:url('${heroPhoto.url}')`} aria-hidden="true"></div>
      <div class="journeys-hero__scrim" aria-hidden="true"></div>

      <div class="container journeys-hero__content">
        <p class="journeys-hero__eyebrow">Beyond a single day</p>
        <h1>Journeys</h1>
        <p class="journeys-hero__subhead">
          A Journey strings several of our tours and destinations together into one
          set route across Namibia, planned day by day — not just a longer version
          of a single tour. Four routes exist already; tell us what you have in
          mind and we'll plan another.
        </p>
        {journeys.length > 0 && (
          <a class="btn btn-primary" href={`#${journeys[0].slug}`}>Start exploring</a>
        )}
      </div>

      <a href="#scroll-target" class="journeys-hero__scroll-cue" aria-label="Scroll to content">
        <span />
      </a>

      {heroPhoto.credit && (
        <p class="journeys-hero__credit">
          Photo:{' '}
          <a href={creditHref(heroPhoto.credit.username)} target="_blank" rel="noopener noreferrer">
            {heroPhoto.credit.name}
          </a>{' '}
          / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
        </p>
      )}
    </section>
    <div id="scroll-target"></div>

    {
      journeys.length > 0 ? (
        journeys.map((journey, i) => (
          <section
            class:list={['journey-feature', 'reveal', i % 2 === 1 && 'journey-feature--reverse']}
            id={journey.slug}
          >
            <div class="journey-feature__media">
              <img src={journey.heroImage} alt={journey.name} loading="lazy" decoding="async" />
              <div class="journey-feature__media-gradient" aria-hidden="true" />

              <div class="journey-feature__media-content">
                <p class="journey-feature__eyebrow">
                  {journey.durationDays}-Day Journey · {tripTypeLabels[journey.tripType]}
                </p>
                <h2 class="journey-feature__name" set:html={hl(journey.name, journeyAccentWords[journey.slug])} />
                <p class="journey-feature__tagline">{journey.tagline}</p>
                <p class="journey-feature__regions">{journey.regions.join(' · ')}</p>
                <a
                  class="btn btn-primary journey-feature__cta"
                  href={`/booking?journey=${encodeURIComponent(journey.name)}#booking-form`}
                >
                  Book this Journey
                </a>
              </div>

              {journey.imageCredit && (
                <p class="journey-feature__credit">
                  Photo:{' '}
                  <a href={creditHref(journey.imageCredit.username)} target="_blank" rel="noopener noreferrer">
                    {journey.imageCredit.name}
                  </a>{' '}
                  / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                </p>
              )}
            </div>

            <div class="journey-feature__content reveal-item">
              <h3 class="journey-feature__content-heading" set:html={hl('Day by day', 'day')} />
              <ol class="journey-feature__timeline">
                {journey.itinerary.map((day) => (
                  <li class="journey-feature__timeline-item">
                    <span class="journey-feature__timeline-day">Day {day.day}</span>
                    <div>
                      <h4 set:html={hl(day.title, day.accentWord)} />
                      <p class="journey-feature__timeline-location">{day.location}</p>
                      <p>{day.description}</p>
                    </div>
                  </li>
                ))}
              </ol>

              <div class="journey-feature__lists">
                <div>
                  <h4>Includes</h4>
                  <ul>
                    {journey.includes.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                {journey.excludes.length > 0 && (
                  <div>
                    <h4>Excludes</h4>
                    <ul>
                      {journey.excludes.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </section>
        ))
      ) : (
        <section class="journeys-empty reveal">
          <div class="container">
            <div class="journeys-empty__card reveal-item">
              <p class="journeys-header__eyebrow">Every journey starts with a conversation</p>
              <h2 class="journeys-empty__heading" set:html={hl("Tell us how long you have and where you'd like to go", 'go')} />
              <p class="journeys-empty__body">
                We're still building out our set-route Journeys — but if you already know
                you want more than one day, get in touch and we'll design a day-by-day
                route around the time you have, combining tours and destinations across
                Namibia into one trip.
              </p>
              <div class="journeys-empty__actions">
                <a class="btn btn-primary" href="/contact">Start planning a Journey</a>
                <a class="btn btn-outline" href="/tours">See our single-day tours</a>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      journeys.length > 0 && (
        <section class="journeys-map-section reveal">
          <div class="journeys-map-section__bg" style={`background-image:url('${mapBgPhoto.url}')`} aria-hidden="true"></div>
          <div class="journeys-map-section__scrim" aria-hidden="true"></div>

          <div class="container">
            <div class="journeys-map-intro reveal-item">
              <p class="eyebrow">The Route Book</p>
              <h2 set:html={hl('Every Route, Plotted', 'Plotted')} />
              <p>Four routes charted across Namibia — tap a name to jump straight to its itinerary above.</p>
            </div>

            <div class="journeys-map reveal-item">
              <div class="journeys-map__canvas">
                <NamibiaMap routes={journeyRoutes} />
              </div>

              <ul class="journeys-map__key">
                {journeys.map((journey) => {
                  const route = journeyRoutes.find((r) => r.slug === journey.slug);
                  if (!route) return null;
                  return (
                    <li>
                      <a href={`#${journey.slug}`}>
                        <svg class="journeys-map__key-swatch" width="28" height="10" aria-hidden="true">
                          <line
                            x1="0"
                            y1="5"
                            x2="28"
                            y2="5"
                            stroke={route.color}
                            stroke-width="3.5"
                            stroke-dasharray={route.dash}
                            stroke-linecap="round"
                          />
                        </svg>
                        <span>
                          <strong>{journey.durationDays}-Day</strong> {journey.name.replace(/^\d+-Day /, '')}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>

          <p class="journeys-map-section__credit">
            Photo:{' '}
            <a href={creditHref(mapBgPhoto.credit.username)} target="_blank" rel="noopener noreferrer">{mapBgPhoto.credit.name}</a>{' '}
            /{' '}
            <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .journeys-page {
    position: relative;
    z-index: 0;
  }

  /* Eyebrow reused by the empty-state card below (light background). */
  .journeys-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  /* ---------- Journeys hero ---------- */
  /* A real Journey in progress — someone out on the dunes south of
     Walvis Bay — shown at full strength. Text sits top-left, backed by
     a gradient that darkens the top of the photo and clears toward the
     bottom, plus text-shadow on the text itself. */
  .journeys-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    background-color: var(--color-earth-700);
  }

  .journeys-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center 35%;
  }

  .journeys-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.85) 0%, rgba(31, 18, 14, 0.35) 45%, rgba(31, 18, 14, 0) 80%);
  }

  .journeys-hero__content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    padding-block: var(--space-2xl);
    margin-inline: 0;
    padding-left: clamp(1.5rem, 6vw, 5rem);
  }

  .journeys-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-sm);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .journeys-hero__content h1 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-md);
  }

  .journeys-hero__subhead {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin: 0 0 var(--space-lg);
  }

  .journeys-hero__credit {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-md);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journeys-hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .journeys-hero__scroll-cue {
    position: absolute;
    bottom: var(--space-lg);
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    width: 24px;
    height: 40px;
    border: 2px solid rgba(251, 247, 241, 0.6);
    border-radius: 999px;
    display: flex;
    justify-content: center;
    padding-top: 8px;
  }

  .journeys-hero__scroll-cue span {
    width: 3px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-sand-100);
    animation: journeys-hero-scroll-cue 1.8s ease-in-out infinite;
  }

  @keyframes journeys-hero-scroll-cue {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    70%,
    100% {
      opacity: 0;
      transform: translateY(10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .journeys-hero__scroll-cue span {
      animation: none;
    }
  }

  @media (max-width: 640px) {
    .journeys-hero__content {
      max-width: none;
    }
  }

  .journeys-empty {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .journeys-empty__card {
    max-width: var(--content-width-narrow);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-lg);
  }

  .journeys-empty__heading {
    margin: 0 0 var(--space-sm);
  }

  .journeys-empty__body {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-lg);
  }

  .journeys-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* ---------- Journey feature sections ---------- */
  /* One full section per journey instead of a card grid — the photo
     panel stays pinned while its own day-by-day content scrolls past
     beside it, alternating sides journey to journey (same alternating
     convention as .tour-row on the tours page). */
  .journey-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(320px, 42%) 1fr;
    scroll-margin-top: 5rem;
  }

  .journey-feature--reverse {
    grid-template-columns: 1fr minmax(320px, 42%);
  }

  .journey-feature--reverse .journey-feature__media {
    order: 2;
  }

  .journey-feature--reverse .journey-feature__content {
    order: 1;
  }

  .journey-feature__media {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .journey-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journey-feature__media-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.15) 0%,
      rgba(31, 18, 14, 0.05) 35%,
      rgba(31, 18, 14, 0.85) 100%
    );
  }

  .journey-feature__media-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-xl) var(--space-lg);
  }

  .journey-feature__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-2xs);
  }

  .journey-feature__name {
    color: var(--color-text-on-dark);
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__tagline {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__regions {
    font-size: var(--fs-sm);
    color: var(--color-sand-100);
    margin: 0 0 var(--space-md);
  }

  .journey-feature__credit {
    position: absolute;
    right: var(--space-sm);
    top: var(--space-sm);
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journey-feature__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .journey-feature__content {
    background: var(--color-surface);
    padding: var(--space-2xl) var(--space-xl);
  }

  .journey-feature__content-heading {
    margin: 0 0 var(--space-md);
  }

  .journey-feature__timeline {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .journey-feature__timeline-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .journey-feature__timeline-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .journey-feature__timeline-day {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-accent-strong);
  }

  .journey-feature__timeline-item h4 {
    font-size: var(--fs-xl);
    margin: 0 0 0.3rem;
  }

  .journey-feature__timeline-location {
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0 0 0.5rem;
  }

  .journey-feature__timeline-item p:not(.journey-feature__timeline-location) {
    font-size: var(--fs-md);
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0;
  }

  .journey-feature__lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .journey-feature__lists h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__lists ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .journey-feature__lists li {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    padding-left: 1.1rem;
    position: relative;
  }

  .journey-feature__lists li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-strong);
  }

  @media (max-width: 900px) {
    .journey-feature,
    .journey-feature--reverse {
      grid-template-columns: 1fr;
    }

    .journey-feature--reverse .journey-feature__media,
    .journey-feature--reverse .journey-feature__content {
      order: initial;
    }

    .journey-feature__media {
      position: relative;
      height: 70vh;
    }

    .journey-feature__content {
      padding: var(--space-xl) var(--space-md);
    }

    .journey-feature__lists {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Routes map ---------- */
  /* Same "fully defined" full-strength background photo treatment as the
     rest of the page — the map+legend panel is already an opaque white
     card, so it only needed the intro copy protected. This section is
     the last thing on the page: fully opaque throughout (photo, intro
     card, white panel), so it meets the footer directly with no stray
     strip of a different background showing through beneath it. */
  .journeys-map-section {
    position: relative;
    z-index: 0;
    padding-block: var(--space-2xl);
  }

  .journeys-map-section__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
  }

  .journeys-map-section__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.68) 0%, rgba(31, 18, 14, 0.25) 55%, rgba(31, 18, 14, 0) 85%);
  }

  .journeys-map-intro {
    max-width: var(--content-width-narrow);
  }

  .journeys-map-intro .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-2xs);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .journeys-map-intro h2 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .journeys-map-intro p:not(.eyebrow) {
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .journeys-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-2xl);
    align-items: center;
    margin-top: var(--space-lg);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
  }

  .journeys-map__canvas {
    aspect-ratio: 751 / 740;
  }

  .journeys-map__key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .journeys-map__key a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .journeys-map__key a:hover {
    color: var(--color-accent-strong);
  }

  .journeys-map__key-swatch {
    flex-shrink: 0;
  }

  .journeys-map__key strong {
    font-family: var(--font-display);
    font-weight: 400;
  }

  @media (max-width: 780px) {
    .journeys-map {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }
  }

  .journeys-map-section__credit {
    position: relative;
    z-index: 1;
    margin: var(--space-sm) 0 0;
    padding: 0 var(--space-md);
    text-align: right;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journeys-map-section__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .journeys-empty__card {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
