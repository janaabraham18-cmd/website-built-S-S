---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import NamibiaMap from '../../components/NamibiaMap.astro';
import { journeys, tripTypeLabels } from '../../data/journeys';
import { journeyRoutes } from '../../data/journeyRoutes';

// The top of the page previews the 4 real Journeys below it rather than
// one generic photo behind a text card — same multi-panel slideshow
// component as the homepage hero, built from each journey's own photo,
// with its duration standing in for Hero.astro's single-letter badge.
const heroPanels = journeys.map((journey) => ({
  letter: String(journey.durationDays),
  alt: journey.name,
  imageUrl: journey.heroImage,
  imageCredit: journey.imageCredit,
}));

const mapBgPhoto = {
  url: 'https://images.unsplash.com/photo-1639402477646-e88e811eef21?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Andrew Svk', username: 'andrew_svk' },
};
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<BaseLayout
  title="Journeys"
  description="Multi-day, multi-location journeys across Namibia with Salt and Sun Tours — a set route, planned day by day."
>
  <div class="journeys-page">
    {
      journeys.length > 0 ? (
        <Hero
          title="Journeys"
          eyebrow="Beyond a single day"
          subhead="Four set routes across Namibia — from a short coastal escape to the full 13-day circuit. Pick one below, or tell us what you have in mind."
          ctaLabel="Start exploring"
          ctaHref={`#${journeys[0].slug}`}
          panels={heroPanels}
        />
      ) : (
        <header class="journeys-header journeys-header--plain">
          <div class="container">
            <p class="journeys-header__eyebrow">Beyond a single day</p>
            <h1>Journeys</h1>
            <p class="journeys-header__body">
              A Journey strings several of our tours and destinations together into one
              set route — a real day-by-day itinerary across Namibia, not just a longer
              version of a single tour.
            </p>
          </div>
        </header>
      )
    }
    <div id="scroll-target"></div>

    {
      journeys.length > 0 ? (
        journeys.map((journey, i) => (
          <section
            class:list={['journey-feature', 'reveal', i % 2 === 1 && 'journey-feature--reverse']}
            id={journey.slug}
          >
            <div class="journey-feature__media">
              <img src={journey.heroImage} alt={journey.name} loading="lazy" decoding="async" />
              <div class="journey-feature__media-gradient" aria-hidden="true" />

              <div class="journey-feature__media-content">
                <p class="journey-feature__eyebrow">
                  {journey.durationDays}-Day Journey · {tripTypeLabels[journey.tripType]}
                </p>
                <h2 class="journey-feature__name">{journey.name}</h2>
                <p class="journey-feature__tagline">{journey.tagline}</p>
                <p class="journey-feature__regions">{journey.regions.join(' · ')}</p>
                <a
                  class="btn btn-primary journey-feature__cta"
                  href={`/booking?journey=${encodeURIComponent(journey.name)}#booking-form`}
                >
                  Book this Journey
                </a>
              </div>

              {journey.imageCredit && (
                <p class="journey-feature__credit">
                  Photo:{' '}
                  <a href={creditHref(journey.imageCredit.username)} target="_blank" rel="noopener noreferrer">
                    {journey.imageCredit.name}
                  </a>{' '}
                  / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                </p>
              )}
            </div>

            <div class="journey-feature__content reveal-item">
              <h3 class="journey-feature__content-heading">Day by day</h3>
              <ol class="journey-feature__timeline">
                {journey.itinerary.map((day) => (
                  <li class="journey-feature__timeline-item">
                    <span class="journey-feature__timeline-day">Day {day.day}</span>
                    <div>
                      <h4>{day.title}</h4>
                      <p class="journey-feature__timeline-location">{day.location}</p>
                      <p>{day.description}</p>
                    </div>
                  </li>
                ))}
              </ol>

              <div class="journey-feature__lists">
                <div>
                  <h4>Includes</h4>
                  <ul>
                    {journey.includes.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
                {journey.excludes.length > 0 && (
                  <div>
                    <h4>Excludes</h4>
                    <ul>
                      {journey.excludes.map((item) => <li>{item}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            </div>
          </section>
        ))
      ) : (
        <section class="journeys-empty reveal">
          <div class="container">
            <div class="journeys-empty__card reveal-item">
              <p class="journeys-header__eyebrow">Every journey starts with a conversation</p>
              <h2 class="journeys-empty__heading">Tell us how long you have and where you'd like to go</h2>
              <p class="journeys-empty__body">
                We're still building out our set-route Journeys — but if you already know
                you want more than one day, get in touch and we'll design a day-by-day
                route around the time you have, combining tours and destinations across
                Namibia into one trip.
              </p>
              <div class="journeys-empty__actions">
                <a class="btn btn-primary" href="/contact">Start planning a Journey</a>
                <a class="btn btn-outline" href="/tours">See our single-day tours</a>
              </div>
            </div>
          </div>
        </section>
      )
    }

    {
      journeys.length > 0 && (
        <section class="journeys-map-section reveal">
          <div class="journeys-map-section__bg" style={`background-image:url('${mapBgPhoto.url}')`} aria-hidden="true"></div>

          <div class="container">
            <div class="journeys-map-intro reveal-item">
              <p class="eyebrow">See it on the map</p>
              <h2>Where each Journey goes</h2>
              <p>Four routes across Namibia — tap a name to jump to its full itinerary above.</p>
            </div>

            <div class="journeys-map reveal-item">
              <div class="journeys-map__canvas">
                <NamibiaMap routes={journeyRoutes} />
              </div>

              <ul class="journeys-map__key">
                {journeys.map((journey) => {
                  const route = journeyRoutes.find((r) => r.slug === journey.slug);
                  if (!route) return null;
                  return (
                    <li>
                      <a href={`#${journey.slug}`}>
                        <svg class="journeys-map__key-swatch" width="28" height="10" aria-hidden="true">
                          <line
                            x1="0"
                            y1="5"
                            x2="28"
                            y2="5"
                            stroke={route.color}
                            stroke-width="3.5"
                            stroke-dasharray={route.dash}
                            stroke-linecap="round"
                          />
                        </svg>
                        <span>
                          <strong>{journey.durationDays}-Day</strong> {journey.name.replace(/^\d+-Day /, '')}
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>

          <p class="journeys-map-section__credit">
            Photo:{' '}
            <a href={creditHref(mapBgPhoto.credit.username)} target="_blank" rel="noopener noreferrer">{mapBgPhoto.credit.name}</a>{' '}
            /{' '}
            <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
          </p>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .journeys-page {
    position: relative;
    z-index: 0;
  }

  /* Fallback only for the (currently unused) zero-journeys case — the
     real header is Hero.astro's multi-panel slideshow, built from each
     journey's own photo, styled entirely within that component. */
  .journeys-header--plain {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .journeys-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .journeys-header--plain .journeys-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: var(--content-width-narrow);
    margin: 0;
  }

  .journeys-empty {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .journeys-empty__card {
    max-width: var(--content-width-narrow);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    box-shadow: var(--shadow-lg);
  }

  .journeys-empty__heading {
    margin: 0 0 var(--space-sm);
  }

  .journeys-empty__body {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-lg);
  }

  .journeys-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* ---------- Journey feature sections ---------- */
  /* One full section per journey instead of a card grid — the photo
     panel stays pinned while its own day-by-day content scrolls past
     beside it, alternating sides journey to journey (same alternating
     convention as .tour-row on the tours page). */
  .journey-feature {
    position: relative;
    display: grid;
    grid-template-columns: minmax(320px, 42%) 1fr;
    scroll-margin-top: 5rem;
  }

  .journey-feature--reverse {
    grid-template-columns: 1fr minmax(320px, 42%);
  }

  .journey-feature--reverse .journey-feature__media {
    order: 2;
  }

  .journey-feature--reverse .journey-feature__content {
    order: 1;
  }

  .journey-feature__media {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .journey-feature__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .journey-feature__media-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(31, 18, 14, 0.15) 0%,
      rgba(31, 18, 14, 0.05) 35%,
      rgba(31, 18, 14, 0.85) 100%
    );
  }

  .journey-feature__media-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-xl) var(--space-lg);
  }

  .journey-feature__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-2xs);
  }

  .journey-feature__name {
    color: var(--color-text-on-dark);
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__tagline {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__regions {
    font-size: var(--fs-sm);
    color: var(--color-sand-100);
    margin: 0 0 var(--space-md);
  }

  .journey-feature__credit {
    position: absolute;
    right: var(--space-sm);
    top: var(--space-sm);
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journey-feature__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .journey-feature__content {
    background: var(--color-surface);
    padding: var(--space-2xl) var(--space-xl);
  }

  .journey-feature__content-heading {
    margin: 0 0 var(--space-md);
  }

  .journey-feature__timeline {
    list-style: none;
    margin: 0 0 var(--space-xl);
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .journey-feature__timeline-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .journey-feature__timeline-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .journey-feature__timeline-day {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent-strong);
  }

  .journey-feature__timeline-item h4 {
    margin: 0 0 0.2rem;
  }

  .journey-feature__timeline-location {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0 0 0.4rem;
  }

  .journey-feature__timeline-item p:not(.journey-feature__timeline-location) {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0;
  }

  .journey-feature__lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);
  }

  .journey-feature__lists h4 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-sm);
  }

  .journey-feature__lists ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .journey-feature__lists li {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    padding-left: 1.1rem;
    position: relative;
  }

  .journey-feature__lists li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-strong);
  }

  @media (max-width: 900px) {
    .journey-feature,
    .journey-feature--reverse {
      grid-template-columns: 1fr;
    }

    .journey-feature--reverse .journey-feature__media,
    .journey-feature--reverse .journey-feature__content {
      order: initial;
    }

    .journey-feature__media {
      position: relative;
      height: 70vh;
    }

    .journey-feature__content {
      padding: var(--space-xl) var(--space-md);
    }

    .journey-feature__lists {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Routes map ---------- */
  /* Same "fully defined" full-strength background photo treatment as the
     rest of the page — the map+legend panel is already an opaque white
     card, so it only needed the intro copy protected. This section is
     the last thing on the page: fully opaque throughout (photo, intro
     card, white panel), so it meets the footer directly with no stray
     strip of a different background showing through beneath it. */
  .journeys-map-section {
    position: relative;
    z-index: 0;
    padding-block: var(--space-2xl);
  }

  .journeys-map-section__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
  }

  .journeys-map-intro {
    max-width: var(--content-width-narrow);
    background: rgba(58, 35, 28, 0.72);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl);
    box-shadow: var(--shadow-lg);
  }

  .journeys-map-intro .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-2xs);
  }

  .journeys-map-intro h2 {
    color: var(--color-text-on-dark);
  }

  .journeys-map-intro p:not(.eyebrow) {
    color: var(--color-sand-200);
  }

  .journeys-map {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    gap: var(--space-2xl);
    align-items: center;
    margin-top: var(--space-lg);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
  }

  .journeys-map__canvas {
    aspect-ratio: 751 / 740;
  }

  .journeys-map__key {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .journeys-map__key a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    text-decoration: none;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .journeys-map__key a:hover {
    color: var(--color-accent-strong);
  }

  .journeys-map__key-swatch {
    flex-shrink: 0;
  }

  .journeys-map__key strong {
    font-family: var(--font-display);
    font-weight: 400;
  }

  @media (max-width: 780px) {
    .journeys-map {
      grid-template-columns: 1fr;
      padding: var(--space-lg);
    }
  }

  .journeys-map-section__credit {
    position: relative;
    z-index: 1;
    margin: var(--space-sm) 0 0;
    padding: 0 var(--space-md);
    text-align: right;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journeys-map-section__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .journeys-empty__card,
    .journeys-map-intro {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
