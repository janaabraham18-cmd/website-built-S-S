---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { journeys, tripTypeLabels } from '../../data/journeys';

export function getStaticPaths() {
  return journeys.map((journey) => ({
    params: { slug: journey.slug },
    props: { journey },
  }));
}

const { journey } = Astro.props;
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<BaseLayout title={journey.name} description={journey.tagline}>
  <div class="journey-page">
    <header class="journey-hero">
      <div class="journey-hero__bg" style={`background-image:url('${journey.heroImage}')`} aria-hidden="true"></div>

      <div class="container">
        <div class="journey-hero__card">
          <a class="journey-hero__back" href="/journeys">← All Journeys</a>
          <p class="journey-hero__eyebrow">{journey.durationDays}-Day Journey · {tripTypeLabels[journey.tripType]}</p>
          <h1 class="journey-hero__heading">{journey.name}</h1>
          <p class="journey-hero__body">{journey.tagline}</p>
          <p class="journey-hero__regions">{journey.regions.join(' · ')}</p>
        </div>
      </div>

      <p class="journey-hero__credit" hidden={!journey.imageCredit}>
        Photo:{' '}
        <a href={journey.imageCredit ? creditHref(journey.imageCredit.username) : '#'} target="_blank" rel="noopener noreferrer">
          {journey.imageCredit?.name}
        </a>{' '}
        / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
      </p>
    </header>

    <section class="journey-body reveal">
      <div class="container journey-body__grid">
        <div class="journey-itinerary reveal-item">
          <h2>Day by day</h2>
          <ol class="journey-timeline">
            {journey.itinerary.map((day) => (
              <li class="journey-timeline__item">
                <span class="journey-timeline__day">Day {day.day}</span>
                <div class="journey-timeline__content">
                  <h3>{day.title}</h3>
                  <p class="journey-timeline__location">{day.location}</p>
                  <p>{day.description}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <aside class="journey-sidebar reveal-item">
          <div class="journey-sidebar__card">
            {journey.price && <p class="journey-sidebar__price">{journey.price}</p>}

            <div class="journey-sidebar__list">
              <h3>Includes</h3>
              <ul>
                {journey.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>

            {journey.excludes.length > 0 && (
              <div class="journey-sidebar__list">
                <h3>Excludes</h3>
                <ul>
                  {journey.excludes.map((item) => <li>{item}</li>)}
                </ul>
              </div>
            )}

            <a class="btn btn-primary journey-sidebar__cta" href={`/booking?journey=${encodeURIComponent(journey.name)}#booking-form`}>
              Book this Journey
            </a>
          </div>
        </aside>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .journey-hero {
    position: relative;
    z-index: 0;
    min-height: 55vh;
    display: flex;
    align-items: center;
    padding-block: var(--space-2xl);
  }

  .journey-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
  }

  .journey-hero__card {
    max-width: var(--content-width-narrow);
    background: rgba(58, 35, 28, 0.72);
    border-radius: var(--radius-lg);
    padding: var(--space-lg) var(--space-xl);
    box-shadow: var(--shadow-lg);
  }

  .journey-hero__back {
    display: inline-block;
    font-size: var(--fs-sm);
    color: var(--color-sand-200);
    text-decoration: none;
    margin-bottom: var(--space-md);
  }

  .journey-hero__back:hover {
    color: var(--color-text-on-dark);
  }

  .journey-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin-bottom: var(--space-2xs);
  }

  .journey-hero__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
  }

  .journey-hero__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    margin: 0 0 var(--space-sm);
  }

  .journey-hero__regions {
    font-size: var(--fs-sm);
    color: var(--color-sand-100);
    margin: 0;
  }

  .journey-hero__credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .journey-hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .journey-body {
    padding-block: var(--space-2xl);
  }

  .journey-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: var(--space-2xl);
    align-items: start;
  }

  .journey-timeline {
    list-style: none;
    margin: var(--space-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .journey-timeline__item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-md);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .journey-timeline__item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .journey-timeline__day {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-accent-strong);
  }

  .journey-timeline__content h3 {
    margin: 0 0 0.2rem;
  }

  .journey-timeline__location {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0 0 0.4rem;
  }

  .journey-timeline__content p:not(.journey-timeline__location) {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0;
  }

  .journey-sidebar__card {
    position: sticky;
    top: 6rem;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-lg);
  }

  .journey-sidebar__price {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--color-text);
    margin: 0 0 var(--space-md);
  }

  .journey-sidebar__list {
    margin-bottom: var(--space-md);
  }

  .journey-sidebar__list h3 {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-sm);
  }

  .journey-sidebar__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .journey-sidebar__list li {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    padding-left: 1.1rem;
    position: relative;
  }

  .journey-sidebar__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent-strong);
  }

  .journey-sidebar__cta {
    width: 100%;
    margin-top: var(--space-sm);
  }

  @media (max-width: 860px) {
    .journey-body__grid {
      grid-template-columns: 1fr;
    }

    .journey-sidebar__card {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .journey-hero__card {
      padding: var(--space-lg) var(--space-md);
    }

    .journey-timeline__item {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
