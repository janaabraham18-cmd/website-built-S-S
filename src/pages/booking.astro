---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
---

<BaseLayout title="Booking" description="Request a tour booking with Salt and Sun Tours in Swakopmund and Walvis Bay, Namibia.">
  <header class="booking-header">
    <div class="container">
      <p class="booking-header__eyebrow">Reserve your spot</p>
      <h1 class="booking-header__heading">Book your tour</h1>
      <p class="booking-header__body">
        Tell us where you'd like to go, how many of you, and when — we'll
        take it from there. Every request gets a real reply from our team
        in Swakopmund, not an automated confirmation, so we can make sure
        the day matches what you're picturing.
      </p>
    </div>
  </header>

  <section class="booking-panel-section reveal">
    <div class="container">
      <div class="booking-panel reveal-item">
        <BookingForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .booking-header,
  .booking-panel-section {
    position: relative;
    background-color: var(--color-earth-700);
    background-image: var(--gradient-dusk);
    color: var(--color-text-on-dark);
  }

  .booking-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .booking-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin-bottom: var(--space-2xs);
  }

  .booking-header__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
  }

  .booking-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    max-width: var(--content-width-narrow);
  }

  .booking-panel-section {
    padding-block: 0 var(--space-2xl);
  }

  .booking-panel {
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
  }

  @media (max-width: 640px) {
    .booking-panel {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
