---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
import { hl } from '../utils/text';

const bgPhoto = {
  url: 'https://images.unsplash.com/photo-1575677155757-b5eb75df3a4e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Hc Digital', username: 'hcdigital' },
};
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<BaseLayout title="Booking" description="Request a tour booking with Salt and Sun Tours in Swakopmund and Walvis Bay, Namibia.">
  <div class="booking-page">
    <div class="booking-page__bg" style={`background-image:url('${bgPhoto.url}')`} aria-hidden="true"></div>
    <div class="booking-page__scrim" aria-hidden="true"></div>

    <header class="booking-header">
      <div class="container">
        <p class="booking-header__eyebrow">The Booking Desk</p>
        <h1 class="booking-header__heading" set:html={hl('Book your tour', 'tour')} />
        <p class="booking-header__body">
          Tell us where you'd like to go, how many of you, and when — we'll
          take it from there. Every request gets a real reply from our team
          in Swakopmund, not an automated confirmation, so we can make sure
          the day matches what you're picturing.
        </p>
      </div>
    </header>

    <section class="booking-panel-section reveal">
      <div class="container">
        <div class="booking-panel reveal-item" id="booking-form">
          <BookingForm />
        </div>
      </div>
    </section>

    <p class="booking-page__credit">
      Photo:{' '}
      <a href={creditHref(bgPhoto.credit.username)} target="_blank" rel="noopener noreferrer">{bgPhoto.credit.name}</a>{' '}
      /{' '}
      <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
    </p>
  </div>
</BaseLayout>

<style>
  /* One continuous background photo behind the whole page — shown at
     full strength. A soft gradient (not a boxed card) darkens the top,
     behind the header copy, and clears before the form panel starts. */
  .booking-page {
    position: relative;
    z-index: 0;
  }

  .booking-page__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center 30%;
    background-color: var(--color-earth-700);
  }

  .booking-page__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.7) 0%, rgba(31, 18, 14, 0.3) 40%, rgba(31, 18, 14, 0) 65%);
  }

  .booking-header,
  .booking-panel-section {
    position: relative;
    color: var(--color-text-on-dark);
  }

  .booking-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .booking-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin-bottom: var(--space-2xs);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .booking-header__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .booking-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    max-width: var(--content-width-narrow);
    margin: 0;
  }

  .booking-page__credit {
    position: relative;
    z-index: 1;
    margin: 0;
    padding: var(--space-sm) var(--space-md);
    text-align: right;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .booking-page__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .booking-panel-section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .booking-panel {
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
  }

  @media (max-width: 640px) {
    .booking-panel {
      padding: var(--space-lg) var(--space-md);
    }
  }
</style>
