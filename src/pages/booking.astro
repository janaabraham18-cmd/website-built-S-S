---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingForm from '../components/BookingForm.astro';
import { toursByCategory, categoryLabels } from '../data/tours';
import { hl } from '../utils/text';

const bgPhoto = {
  url: 'https://images.unsplash.com/photo-1738701243287-df5b46011c2f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Mustafa Masetic', username: 'mmvisualstories' },
};

// Same "Chart Your Own Day" combo builder as the Tours page — the data,
// markup, and its setupComboBuilder() script (src/scripts/motion.ts) are
// all reused as-is, so someone landing straight on Booking without going
// via Tours first can still build a custom combo instead of hunting for
// it elsewhere.
const builderTours = toursByCategory('tour');
const builderAdventures = toursByCategory('adventure');
---

<BaseLayout title="Booking" description="Request a tour booking with Salt and Sun Tours in Swakopmund and Walvis Bay, Namibia.">
  <div class="booking-page">
    <div class="booking-page__bg" style={`background-image:url('${bgPhoto.url}')`} aria-hidden="true"></div>
    <div class="booking-page__scrim" aria-hidden="true"></div>

    <header class="booking-header">
      <div class="container">
        <p class="booking-header__eyebrow">The Booking Desk</p>
        <h1 class="booking-header__heading" set:html={hl('Book your tour', 'tour')} />
        <p class="booking-header__body">
          Tell us where you'd like to go, how many of you, and when — we'll
          take it from there. Every request gets a real reply from our team
          in Swakopmund, not an automated confirmation, so we can make sure
          the day matches what you're picturing. Just need a ride between
          destinations, not a full tour? Choose "Transport only" below and
          tell us your pickup and drop-off points.
        </p>
      </div>
    </header>

    <section class="booking-content reveal">
      <div class="container">
        <div class="booking-panel reveal-item" id="booking-form">
          <BookingForm />
          <p class="booking-panel__note">
            A note on pricing: we don't quote a flat rate here, since cost depends on group
            size, which tour or combination you choose, and a few other factors. Send your
            request and we'll work out a quote for your trip and follow up directly.
          </p>
        </div>
      </div>

      <div class="container build-combo" id="build-your-own">
        <div class="section-intro reveal-item">
          <p class="eyebrow">Still Deciding?</p>
          <h2 set:html={hl('Chart Your Own Day', 'Own')} />
          <p>
            Not sure exactly what to book yet? Pick individual tours and adventures below
            and we'll chart the itinerary around them — your picks fill in the booking
            form above automatically.
          </p>
        </div>

        <div class="combo-builder reveal-item" data-combo-builder>
          <div class="combo-builder__picker">
            <div class="combo-builder__group">
              <p class="combo-builder__group-label">{categoryLabels.tour.label}</p>
              <div class="combo-builder__chips">
                {builderTours.map((tour) => (
                  <button
                    type="button"
                    class="combo-builder__chip"
                    data-builder-chip
                    data-slug={tour.slug}
                    data-name={tour.name}
                    data-img={tour.imageUrl}
                    aria-pressed="false"
                  >
                    <span class="combo-builder__chip-check" aria-hidden="true">✓</span>
                    {tour.name}
                  </button>
                ))}
              </div>
            </div>

            <div class="combo-builder__group">
              <p class="combo-builder__group-label">{categoryLabels.adventure.label}</p>
              <div class="combo-builder__chips">
                {builderAdventures.map((tour) => (
                  <button
                    type="button"
                    class="combo-builder__chip"
                    data-builder-chip
                    data-slug={tour.slug}
                    data-name={tour.name}
                    data-img={tour.imageUrl}
                    aria-pressed="false"
                  >
                    <span class="combo-builder__chip-check" aria-hidden="true">✓</span>
                    {tour.name}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="combo-builder__preview">
            <p class="combo-builder__count" data-builder-count role="status" aria-live="polite">
              Pick at least 2 to build your combo
            </p>

            <div class="combo-builder__pairs" data-builder-pairs>
              {Array.from({ length: 8 }).map((_, i) => (
                <div class="combo-builder__pair-slot" data-pair-slot={i} hidden>
                  <span class="combo-builder__plus" aria-hidden="true">+</span>
                  <div class="photo-frame photo-frame--sm combo-builder__pair-photo">
                    <img data-pair-img alt="" loading="lazy" decoding="async" />
                  </div>
                  <p class="combo-builder__pair-name" data-pair-name></p>
                </div>
              ))}
            </div>

            <a class="btn btn-primary combo-builder__cta" data-builder-cta href="#" aria-disabled="true">
              Book my combo
            </a>
            <p class="combo-builder__fallback">
              Not sure yet? <a href="/contact">Just tell us what you're dreaming of →</a>
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* One continuous background photo behind the whole page — shown at
     full strength. A soft gradient (not a boxed card) darkens the top,
     behind the header copy, and clears before the form panel starts. */
  .booking-page {
    position: relative;
    z-index: 0;
  }

  .booking-page__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center 30%;
    background-color: var(--color-earth-700);
  }

  .booking-page__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.7) 0%, rgba(31, 18, 14, 0.3) 40%, rgba(31, 18, 14, 0) 65%);
  }

  .booking-header,
  .booking-content {
    position: relative;
    color: var(--color-text-on-dark);
  }

  .booking-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .booking-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin-bottom: var(--space-2xs);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .booking-header__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .booking-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    max-width: var(--content-width-narrow);
    margin: 0;
  }

  .booking-content {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .booking-panel {
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
  }

  @media (max-width: 640px) {
    .booking-panel {
      padding: var(--space-lg) var(--space-md);
    }
  }

  .booking-panel__note {
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: var(--content-width-narrow);
    margin: var(--space-lg) 0 0;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  /* ---------- Chart Your Own Day (same builder as /tours) ---------- */
  /* On-dark styling throughout — this sits in the same continuous photo
     section as the booking panel above it now, not its own section with
     its own background, so it uses the same sand colors + text-shadow
     treatment as .booking-header rather than a light-background style. */
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-sand-100);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin-bottom: 0.6rem;
  }

  .section-intro {
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .section-intro h2 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-2xs);
  }

  .section-intro p {
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin: 0;
  }

  .build-combo {
    margin-top: var(--space-2xl);
    scroll-margin-top: 5rem;
  }

  .combo-builder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: var(--space-xl);
    align-items: start;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-lg);
  }

  .combo-builder__group {
    margin-bottom: var(--space-md);
  }

  .combo-builder__group:last-child {
    margin-bottom: 0;
  }

  .combo-builder__group-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 0.6rem;
  }

  .combo-builder__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .combo-builder__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .combo-builder__chip:hover,
  .combo-builder__chip:focus-visible {
    border-color: var(--color-accent-strong);
  }

  .combo-builder__chip-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    font-size: 0.6rem;
    line-height: 1;
    color: transparent;
    flex-shrink: 0;
    transition: background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .combo-builder__chip.is-selected {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text-on-dark);
  }

  .combo-builder__chip.is-selected .combo-builder__chip-check {
    background: var(--color-text-on-dark);
    border-color: var(--color-text-on-dark);
    color: var(--color-accent-strong);
  }

  .combo-builder__preview {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    position: sticky;
    top: 5rem;
  }

  .combo-builder__count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
  }

  .combo-builder__pairs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.5rem;
  }

  .combo-builder__pair-slot[hidden] {
    display: none;
  }

  .combo-builder__pair-slot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .combo-builder__pair-slot:first-child .combo-builder__plus {
    display: none;
  }

  .combo-builder__plus {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-accent-strong);
    line-height: 1;
  }

  .combo-builder__pair-photo {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  .combo-builder__pair-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 5rem;
  }

  .combo-builder__cta {
    width: 100%;
    margin-top: var(--space-md);
  }

  .combo-builder__cta[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .combo-builder__fallback {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: var(--space-sm) 0 0;
  }

  @media (max-width: 860px) {
    .combo-builder {
      grid-template-columns: 1fr;
    }

    .combo-builder__preview {
      position: static;
    }
  }
</style>
