---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tourBySlug } from '../data/tours';
import type { Tour } from '../data/tours';

interface EditorialExperience {
  name: string;
  imageUrl: string;
}

interface MoodSection {
  key: string;
  eyebrow: string;
  heading: string;
  intro: string;
  tone: 'bg' | 'alt';
  bannerUrl: string;
  bannerCredit: { name: string; username: string };
  tours: Tour[];
  editorial?: EditorialExperience[];
}

const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;

const bySlug = (slugs: string[]) => slugs.map((s) => tourBySlug(s)).filter((t): t is Tour => !!t);

// Every mood is booked as one package, not stop-by-stop — this builds the
// single CTA href (reusing the tours page's "Custom combo" deep-link into
// BookingForm) and the ordered stop list shown beside it, from a section's
// tours + any editorial-only entries combined.
const stopsOf = (section: Pick<MoodSection, 'tours' | 'editorial'>) => [
  ...section.tours.map((t) => ({ name: t.name, imageUrl: t.imageUrl ?? '' })),
  ...(section.editorial ?? []),
];

const bookingHrefFor = (section: Pick<MoodSection, 'eyebrow' | 'tours' | 'editorial'>) => {
  const names = stopsOf(section).map((s) => s.name);
  return `/booking?custom=${encodeURIComponent(`${section.eyebrow} Experience — ${names.join(' + ')}`)}`;
};

const sections: MoodSection[] = [
  {
    key: 'sunrise',
    eyebrow: 'Sunrise & Golden Hour',
    heading: 'Chase the light before the day gets busy',
    intro:
      "The desert looks like a different place at dawn — the dunes turn rose-gold, the air is still cool, and the coast feels like it belongs to you. These are the experiences built around that first hour.",
    tone: 'bg',
    bannerUrl:
      'https://images.unsplash.com/photo-1761899285601-32b23ff9aacd?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
    bannerCredit: { name: 'ray rui', username: 'ray30' },
    tours: bySlug(['breakfast-run', 'quad-bike-tour', 'moonlandscape-tour', 'explorer-tour']),
  },
  {
    key: 'full-throttle',
    eyebrow: 'Full-Throttle',
    heading: 'For the ones who came for the adrenaline',
    intro:
      "Skydive over the Namib, carve down a 300-metre dune, or feel a quad bike kick up sand behind you — if you want your heart rate up, start here.",
    tone: 'alt',
    bannerUrl:
      'https://images.unsplash.com/photo-1538584169853-905fe7292381?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
    bannerCredit: { name: 'William Pei Yuan', username: '_iamwill' },
    tours: bySlug(['tandem-skydive', 'sandboarding', 'paragliding', 'special-quad-90min', 'fat-bike-tour']),
  },
  {
    key: 'slow-and-wild',
    eyebrow: 'Slow & Wild',
    heading: 'Namibia at its own pace',
    intro:
      "Not every great day needs speed. These are the trips for tracking a sidewinder's trail across the sand, watching a seal colony from a respectful distance, or simply sitting still long enough for the desert to reveal itself.",
    tone: 'bg',
    bannerUrl:
      'https://images.unsplash.com/photo-1781817388497-bd831004913b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
    bannerCredit: { name: 'Rafael Peier', username: 'rafaelpeier' },
    tours: bySlug(['living-desert-tour', 'cape-cross', 'etosha-tour', 'moonlandscape-tour']),
  },
  {
    key: 'ocean-and-coastal',
    eyebrow: 'Ocean & Coastal',
    heading: 'Where the dunes meet the Atlantic',
    intro:
      "Walvis Bay and Pelican Point are where Namibia's desert story turns coastal — dolphins, seals, oysters, and a horizon that never quite settles. Two of the stops below are new: a private Beach Sundowner as the sun drops into the Atlantic, and an exclusive Luxury Coastal Dinner for groups and celebrations — both built purely around slowing down at the end of the day.",
    tone: 'alt',
    bannerUrl:
      'https://images.unsplash.com/photo-1736149562100-79ab7e23d692?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
    bannerCredit: { name: 'Dimitar Meddling', username: 'dmeddling' },
    tours: bySlug(['dolphin-seal-catamaran-cruise', 'kayaking', 'pelican-point-tour', 'sandwich-harbour-full-day', 'fishing']),
    editorial: [
      {
        name: 'Beach Sundowner Experience',
        imageUrl:
          'https://images.unsplash.com/photo-1612176876591-196abbaa8e79?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=400',
      },
      {
        name: 'Luxury Coastal Dinner Experience',
        imageUrl:
          'https://images.unsplash.com/photo-1777906718328-deb1ff1be508?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=400',
      },
    ],
  },
  {
    key: 'culture-and-connection',
    eyebrow: 'Culture & Connection',
    heading: 'Meet the people behind the place',
    intro:
      "Namibia isn't only landscape. An afternoon in Swakopmund's Damara, Herero and Ovambo communities is a chance to sit down, share a meal, and hear the place's story from the people who call it home.",
    tone: 'bg',
    bannerUrl:
      'https://images.unsplash.com/photo-1662534263409-c7d8a58d7744?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
    bannerCredit: { name: 'Hush Naidoo Jade Photography', username: 'hush52' },
    tours: bySlug(['township-tour']),
  },
  {
    key: 'family-friendly',
    eyebrow: 'Family-Friendly',
    heading: 'Built for every age in the group',
    intro:
      "No experience needed, no minimum-age worries — these are the days that work whether you're travelling with grandparents, toddlers, or a teenager who claims to be bored by everything.",
    tone: 'alt',
    bannerUrl:
      'https://images.unsplash.com/photo-1780681426080-0486829a0d07?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
    bannerCredit: { name: 'Jay Thakkar', username: 'cejaythakkar07' },
    tours: bySlug(['camel-ride', 'quad-bike-tour', 'fat-bike-tour', 'freedom-combo']),
  },
];
---

<BaseLayout
  title="Experiences"
  description="Find your kind of day — Salt and Sun Tours' experiences curated by mood, from golden-hour dune drives to full-throttle adventure and slow, wild wildlife encounters."
>
  <header class="experiences-header">
    <div class="container">
      <p class="experiences-header__eyebrow">Find your kind of day</p>
      <h1 class="experiences-header__heading">Experiences</h1>
      <p class="experiences-header__body">
        Our tours and adventures live on one page — this one is organised
        differently. Instead of sorting by what an activity is, it's sorted
        by how it feels: the sunrise trips, the adrenaline, the slow days,
        the coast, the culture, and the ones that work for the whole family.
        Find the mood, then pick the day.
      </p>
    </div>
  </header>

  {
    sections.map((section, i) => {
      const stops = stopsOf(section);
      return (
        <section
          class:list={['mood-section', section.tone === 'alt' && 'mood-section--alt']}
          id={section.key}
        >
          <div class="container">
            <div class:list={['mood-row', i % 2 === 1 && 'reverse']} data-alt-row>
              <div class="mood-row__media">
                <div class="photo-frame mood-row__photo">
                  <div class="mood-row__parallax" data-mood-parallax-img>
                    <img src={section.bannerUrl} alt={section.heading} loading="lazy" decoding="async" />
                  </div>
                  <p class="mood-row__credit">
                    Photo:{' '}
                    <a href={creditHref(section.bannerCredit.username)} target="_blank" rel="noopener noreferrer">
                      {section.bannerCredit.name}
                    </a>{' '}
                    / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                  </p>
                </div>
              </div>

              <div class="mood-row__copy">
                <p class="eyebrow">{section.eyebrow}</p>
                <h2>{section.heading}</h2>
                <p class="mood-row__intro">{section.intro}</p>

                <p class="mood-row__stops-label">{stops.length} stop{stops.length === 1 ? '' : 's'}, one booking</p>
                <ol class="mood-row__stops">
                  {stops.map((stop, si) => (
                    <li>
                      <span class="mood-row__stop-num">{String(si + 1).padStart(2, '0')}</span>
                      <span class="mood-row__stop-photo">
                        <img src={stop.imageUrl} alt="" loading="lazy" decoding="async" />
                      </span>
                      <span class="mood-row__stop-name">{stop.name}</span>
                    </li>
                  ))}
                </ol>

                <a class="btn btn-primary mood-row__cta" href={bookingHrefFor(section)}>
                  Book the {section.eyebrow} Experience →
                </a>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="experiences-closing reveal">
    <div class="container experiences-closing__inner reveal-item">
      <h2>Not sure which mood fits?</h2>
      <p>Tell us who's coming and what you're after — we'll point you to the right day, or build one from scratch.</p>
      <div class="experiences-closing__ctas">
        <a class="btn btn-primary" href="/booking">Start booking</a>
        <a class="btn btn-outline" href="/contact">Ask us a question</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .experiences-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .experiences-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .experiences-header__heading {
    margin-bottom: var(--space-md);
  }

  .experiences-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: var(--content-width-narrow);
  }

  .mood-section {
    padding-block: var(--space-2xl);
    scroll-margin-top: 5rem;
  }

  .mood-section--alt {
    background: var(--color-bg-alt);
  }

  /* One row = one bookable package: photo on one side, the whole pitch
     (heading, intro, stop list, single CTA) on the other. Alternates
     side-to-side per section via .reverse, same technique as the
     homepage Itinerary's program rows. */
  .mood-row {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--space-2xl);
    align-items: center;
  }

  .mood-row.reverse .mood-row__media {
    order: 2;
  }

  .mood-row.reverse .mood-row__copy {
    order: 1;
  }

  .mood-row__media {
    position: relative;
  }

  .mood-row__photo {
    position: relative;
    height: 420px;
    box-shadow: var(--shadow-md);
  }

  /* Oversized + absolutely positioned so the scroll-scrubbed parallax
     drift (see setupMoodParallax in motion.ts) never exposes an edge —
     the frame's own overflow:hidden clips it. */
  .mood-row__parallax {
    position: absolute;
    top: -15%;
    left: 0;
    width: 100%;
    height: 130%;
  }

  .mood-row__credit {
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    z-index: 1;
    margin: 0;
    font-size: 0.65rem;
    color: rgba(251, 247, 241, 0.85);
  }

  .mood-row__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .mood-row__copy h2 {
    margin: 0 0 var(--space-sm);
  }

  .mood-row__intro {
    color: var(--color-text-muted);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-lg);
  }

  .mood-row__stops-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 0.6rem;
  }

  .mood-row__stops {
    list-style: none;
    margin: 0 0 var(--space-lg);
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .mood-row__stops li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  .mood-row__stops li:first-child {
    border-top: none;
  }

  .mood-row__stop-num {
    font-family: var(--font-display);
    font-size: 0.9rem;
    color: var(--color-accent-soft);
    width: 1.4rem;
    flex-shrink: 0;
  }

  .mood-row__stop-photo {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--color-bg-alt);
  }

  .mood-row__stop-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mood-row__stop-name {
    font-size: 0.92rem;
    color: var(--color-text);
    font-weight: 500;
  }

  .mood-row__cta {
    display: inline-flex;
  }

  @media (max-width: 860px) {
    .mood-row {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .mood-row.reverse .mood-row__media,
    .mood-row.reverse .mood-row__copy {
      order: initial;
    }

    .mood-row__photo {
      height: 280px;
    }
  }

  .experiences-closing {
    padding-block: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }

  .experiences-closing__inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .experiences-closing__inner h2 {
    margin: 0 0 var(--space-2xs);
  }

  .experiences-closing__inner p {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg);
  }

  .experiences-closing__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
