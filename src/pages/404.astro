---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hl } from '../utils/text';

const bgPhoto = {
  url: 'https://images.unsplash.com/photo-1781975543356-f81ce9560f1e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Kier Allen', username: 'kallen2396' },
};
---

<BaseLayout
  title="Page Not Found"
  description="This page doesn't exist — find your way back to Salt and Sun Tours' tours, adventures, and journeys around Swakopmund and Walvis Bay."
  image={bgPhoto.url}
  noindex
>
  <div class="not-found-page">
    <div class="not-found-page__bg" style={`background-image:url('${bgPhoto.url}')`} aria-hidden="true"></div>
    <div class="not-found-page__scrim" aria-hidden="true"></div>

    <div class="container not-found-page__content">
      <p class="not-found-page__eyebrow">404</p>
      <h1 class="not-found-page__heading" set:html={hl("Looks like you've wandered off the map", 'map')} />
      <p class="not-found-page__body">
        That page doesn't exist — maybe it moved, maybe the link was wrong.
        Either way, here's a few ways back to solid ground.
      </p>
      <div class="not-found-page__ctas">
        <a class="btn btn-primary" href="/">Back to Home</a>
        <a class="btn btn-outline" href="/tours">See our Tours</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* Same full-bleed-photo-plus-scrim pattern as Contact/FAQ/Adventures —
     centered content, nothing below the fold to keep clear, so the wash
     is flat and even rather than top-weighted. */
  .not-found-page {
    position: relative;
    z-index: 0;
    min-height: calc(100vh - 4.5rem);
    display: flex;
    align-items: center;
  }

  .not-found-page__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-color: var(--color-earth-700);
  }

  .not-found-page__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(31, 18, 14, 0.55);
  }

  .not-found-page__content {
    text-align: center;
    max-width: 36rem;
    margin-inline: auto;
    padding-block: var(--space-3xl);
  }

  .not-found-page__eyebrow {
    font-family: var(--font-display);
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--color-sand-100);
    opacity: 0.85;
    margin: 0 0 var(--space-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.4);
  }

  .not-found-page__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .not-found-page__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin: 0 0 var(--space-lg);
  }

  .not-found-page__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

  /* .btn-outline inherits color from its surroundings (border-color:
     currentColor) — without this it falls back to the sitewide dark
     text color, nearly invisible against this section's dark scrim. */
  .not-found-page__ctas .btn-outline {
    color: var(--color-text-on-dark);
  }
</style>
