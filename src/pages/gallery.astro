  },
  {
    slug: 'from-the-road-coastal-relics',
    name: 'Coastal Relics',
    category: 'tour',
    imageUrl: '/images/gallery-coastal-relics.jpg',
  },
  {
    slug: 'from-the-road-climbing-to-the-top',
    name: 'Climbing to the Top',
    category: 'tour',
    imageUrl: '/images/gallery-climbing-to-the-top.jpg',
  },
  {
    slug: 'from-the-road-low-tide-walk',
    name: 'Low Tide Walk',
    category: 'tour',
    imageUrl: '/images/gallery-low-tide-walk.jpg',
  },
  {
    slug: 'from-the-road-exploring-the-canyon',
    name: 'Exploring the Canyon',
    category: 'tour',
    imageUrl: '/images/gallery-exploring-the-canyon.jpg',
  },
  {
    slug: 'from-the-road-the-whole-crew',
    name: 'The Whole Crew',
    category: 'tour',
    imageUrl: '/images/gallery-the-whole-crew.jpg',
  },
];

// Real photos only — every tour/adventure/combo/journey placeholder used
// stock Unsplash photography, so this page now shows just the genuine
// shots from an actual outing: the "From the Road" set above, plus any
// tour that has its own real (non-Unsplash) photo.
const galleryItems: GalleryItem[] = [
  ...fromTheRoadItems,
  ...tours
    .filter(
      (tour): tour is typeof tour & { imageUrl: string } =>
        !!tour.imageUrl && !tour.imageUrl.startsWith('https://images.unsplash.com')
    )
    .map((tour) => ({
      slug: tour.slug,
      name: tour.name,
      category: 'tour' as const,
      imageUrl: tour.imageUrl,
      imageCredit: tour.imageCredit,
    })),
];

// Hero backdrop: a flat-lay of every real photo on this page (small
// pre-shrunk /images/thumbs/ copies, not the full-size files — 32 photos
// at full res would make the hero itself the heaviest thing on the page)
// tiled, overlapping and crooked, like prints scattered on a table. Build
// time is fine to use Math.random-ish math here since this is purely
// decorative chrome, not content — a reseed on every rebuild just means
// the scatter looks slightly different next deploy, which doesn't matter.
// Repeated 6x so there's always enough tiles to tile a very wide (TV-size)
// viewport with no gaps; overflow is clipped by .gallery-hero itself.
function seededRandom(seed: number) {
  const x = Math.sin(seed * 12.9898 + 78.233) * 43758.5453;
  return x - Math.floor(x);
}

const collagePhotos = Array.from({ length: galleryItems.length * 6 }, (_, i) => {
  const item = galleryItems[i % galleryItems.length];
  const rotation = (seededRandom(i * 1.37) * 2 - 1) * 11;
  const liftY = (seededRandom(i * 2.63 + 5) * 2 - 1) * 12;
  return {
    imageUrl: item.imageUrl.replace('/images/', '/images/thumbs/'),
    rotation,
    liftY,
  };
});
---

<BaseLayout
  title="Photo Gallery"
  description="Real photos from our tours — guests, landmarks, and wildlife around Swakopmund and Walvis Bay, Namibia, with Salt and Sun Tours."
>
  <section class="gallery-hero">
    <div class="gallery-hero__collage" aria-hidden="true">
      {collagePhotos.map((photo) => (
        <div
          class="gallery-hero__collage-item"
          style={`transform: rotate(${photo.rotation.toFixed(2)}deg) translateY(${photo.liftY.toFixed(2)}px);`}
        >
          <img src={photo.imageUrl} alt="" loading="eager" decoding="async" />
        </div>
      ))}
    </div>
    <div class="gallery-hero__scrim" aria-hidden="true"></div>

    <div class="container gallery-hero__content">
      <p class="eyebrow">The Photo Roll</p>
      <h1>Gallery</h1>
      <p class="gallery-header__body">
        Real moments from the road — guests, landmarks and wildlife from the
        tours we run. Tap a photo to see it full-size, then browse with the
        arrows.
      </p>
    </div>
  </section>

  <section class="gallery-grid-section reveal">
    <div class="container">
      <div class="gallery-grid reveal-item">
        {galleryItems.map((item, i) => (
          <div class="gallery-tile">
            <button
              type="button"
              class="gallery-tile__link"
              data-lightbox-trigger
              data-lightbox-index={i}
              data-lightbox-img={item.imageUrl}
              data-lightbox-name={item.name}
              aria-label={`Enlarge photo: ${item.name}`}
            >
              <div class="gallery-tile__polaroid">
                <div class="photo-frame gallery-tile__photo">
                  <img src={item.imageUrl} alt={item.name} loading="lazy" decoding="async" />
                  <span class="gallery-tile__badge">{badgeLabels[item.category]}</span>
                </div>
                <p class="gallery-tile__name">{item.name}</p>
              </div>
            </button>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="lightbox" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <div class="lightbox__backdrop" data-lightbox-backdrop></div>
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close photo viewer">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </button>
    <figure class="lightbox__frame">
      <!-- Prev/next live right on the image's own box (not the
           full-viewport overlay), so they sit off the picture's actual
           edges rather than the screen edges — otherwise a narrower
           photo on a wide viewport leaves them stranded far from it. -->
      <div class="lightbox__image-wrap">
        <img class="lightbox__image" data-lightbox-image src="" alt="" />
        <button type="button" class="lightbox__arrow lightbox__arrow--prev" data-lightbox-prev aria-label="Previous photo">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="lightbox__arrow lightbox__arrow--next" data-lightbox-next aria-label="Next photo">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
      <figcaption class="lightbox__caption">
        <span data-lightbox-caption></span>
        <span class="lightbox__counter"><span data-lightbox-current></span> / {galleryItems.length}</span>
      </figcaption>
    </figure>
  </div>
</BaseLayout>

<style>
  /* Bounded hero (not the whole page) with its own photo + scrim — text
     sits at the top of the photo and nothing below it needs to stay
     clear, so a flatter gradient clearing by ~80% (same treatment as
     the Adventures hero) rather than the page-length photo other inner
     pages use. The grid section below stays on the plain light page
     background. */
  .gallery-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-earth-700);
    padding-block: var(--space-2xl) var(--space-xl);
    min-height: 26rem;
  }

  /* The "photo on the floor" backdrop: every real photo on this page
     (small pre-shrunk copies — see collagePhotos above), tiled edge to
     edge with no gaps, each one crooked and overlapping its neighbors.
     Fixed-width (not percentage) so the tiles stay a consistent physical
     size at any viewport — centered and overflowing both edges, clipped
     by .gallery-hero's own overflow: hidden, so it never runs out of
     tiles even at a 2560px+ TV-size window. */
  .gallery-hero__collage {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4200px;
    transform: translateX(-50%);
    z-index: 0;
    display: flex;
    flex-wrap: wrap;
    align-content: flex-start;
    pointer-events: none;
  }

  .gallery-hero__collage-item {
    flex: 0 0 auto;
    width: 190px;
    aspect-ratio: 4 / 3;
    margin: -20px -18px;
    background: var(--color-surface);
    padding: 6px;
    border-radius: 3px;
    box-shadow: var(--shadow-sm);
  }

  .gallery-hero__collage-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 1px;
  }

  /* Stronger and deeper than a single-photo hero needs — the collage
     behind it is 32 different photos with bright white polaroid borders,
     not one calm photo, so the dark zone has to hold all the way past
     the body copy before it starts clearing. */
  .gallery-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(20, 12, 9, 0.88) 0%, rgba(20, 12, 9, 0.8) 55%, rgba(20, 12, 9, 0.35) 80%, rgba(20, 12, 9, 0) 97%);
  }

  .gallery-hero__content {
    position: relative;
    z-index: 1;
  }

  /* This page never had a base .eyebrow rule — the label rendered as a
     plain paragraph with none of the small-caps treatment every other
     page's eyebrow gets. */
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .gallery-hero .eyebrow {
    color: var(--color-sand-100);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .gallery-hero h1 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-sm);
  }

  .gallery-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    max-width: var(--content-width-narrow);
    margin: 0 0 var(--space-lg);
  }

  /* Same "Desert Light" section-glow system the home page bands use
     (--texture-grain is already applied page-wide in global.css) — this
     just keys the gallery's own glow to its warm desert photos instead of
     leaving the section on the flat page background. */
  .gallery-grid-section {
    padding-block: var(--space-xl) var(--space-2xl);
    background-image: var(--gradient-glow-warm);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-xl) var(--space-lg);
  }

  /* A <button> now (it opens the lightbox, it no longer navigates), so
     this resets it back to looking like the plain block the old <a> was. */
  .gallery-tile__link {
    display: block;
    width: 100%;
    text-align: inherit;
    text-decoration: none;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  /* Scrapbook / travel-journal treatment: each photo gets a white
     polaroid-style border and a gentle tilt (alternated by position via
     nth-child, so it's deterministic rather than reshuffling on every
     render), with a small strip of "tape" pinning it down. Hovering
     straightens the print and lifts it slightly, like picking it up off
     the page. */
  .gallery-tile {
    transition: transform var(--duration-base) var(--ease-out);
  }

  .gallery-tile:nth-child(6n + 1) { transform: rotate(-2.2deg); }
  .gallery-tile:nth-child(6n + 2) { transform: rotate(1.6deg); }
  .gallery-tile:nth-child(6n + 3) { transform: rotate(-1.1deg); }
  .gallery-tile:nth-child(6n + 4) { transform: rotate(2deg); }
  .gallery-tile:nth-child(6n + 5) { transform: rotate(-1.6deg); }
  .gallery-tile:nth-child(6n) { transform: rotate(1.1deg); }

  .gallery-tile:hover {
    transform: rotate(0deg) translateY(-6px);
    position: relative;
    z-index: 2;
  }

  .gallery-tile__polaroid {
    position: relative;
    background: var(--color-surface);
    padding: var(--space-sm) var(--space-sm) var(--space-md);
    border-radius: 3px;
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .gallery-tile:hover .gallery-tile__polaroid {
    box-shadow: var(--shadow-lg);
  }

  .gallery-tile__polaroid::before {
    content: '';
    position: absolute;
    top: -0.55rem;
    left: 50%;
    width: 3.2rem;
    height: 1.1rem;
    background: var(--color-ochre-400);
    opacity: 0.55;
    transform: translateX(-50%) rotate(-3deg);
    box-shadow: var(--shadow-sm);
  }

  .gallery-tile__photo {
    aspect-ratio: 4 / 3;
    border-radius: 1px;
    margin-bottom: var(--space-sm);
  }

  /* .photo-frame (global.css) is already position: relative, overflow:
     hidden — this just pins the badge to it. */
  .gallery-tile__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 1;
    background: var(--color-accent-strong);
    color: var(--color-text-on-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .gallery-tile__name {
    font-family: var(--font-display);
    font-size: 1rem;
    color: var(--color-text);
    text-align: center;
    margin: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .gallery-tile__link:hover .gallery-tile__name {
    color: var(--color-accent-strong);
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-lg) var(--space-md);
    }

    /* Smaller tilts at phone width so tiles never crowd a neighbor in a
       2-column layout. */
    .gallery-tile:nth-child(6n + 1) { transform: rotate(-1.2deg); }
    .gallery-tile:nth-child(6n + 2) { transform: rotate(1deg); }
    .gallery-tile:nth-child(6n + 3) { transform: rotate(-0.8deg); }
    .gallery-tile:nth-child(6n + 4) { transform: rotate(1.2deg); }
    .gallery-tile:nth-child(6n + 5) { transform: rotate(-1deg); }
    .gallery-tile:nth-child(6n) { transform: rotate(0.8deg); }
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 12, 9, 0.92);
  }

  .lightbox__frame {
    position: relative;
    z-index: 1;
    max-width: min(90vw, 1100px);
    max-height: 85vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Shrink-wraps to the image's own rendered size (inline-block, no
     intrinsic size of its own) so the arrows below — absolutely
     positioned against this wrap — sit on the photo's actual edges
     instead of the frame's, which would also span the caption's width. */
  .lightbox__image-wrap {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .lightbox__image {
    display: block;
    max-width: 100%;
    max-height: 70vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 2px;
    box-shadow: var(--shadow-lg);
  }

  .lightbox__caption {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
    color: var(--color-sand-100);
    font-family: var(--font-display);
    font-size: 1rem;
    text-align: center;
  }

  .lightbox__counter {
    font-family: var(--font-body);
    font-size: 0.8rem;
    color: var(--color-sand-200);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    z-index: 2;
  }

  .lightbox__close,
  .lightbox__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid rgba(251, 247, 241, 0.35);
    border-radius: 50%;
    background: rgba(20, 12, 9, 0.5);
    color: var(--color-sand-100);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .lightbox__close svg,
  .lightbox__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .lightbox__close:hover {
    background: var(--color-accent-strong);
    color: var(--color-text-on-dark);
    transform: scale(1.06);
  }

  /* Positioned against .lightbox__image-wrap (sized to the photo itself),
     sitting just outside its edges — a constant gap in proportion to the
     button's own size (the -130%/130% translate), not a fixed viewport
     offset, so they stay right next to the picture whatever size it
     renders at. Each arrow's hover rule re-states that same translate
     alongside the hover scale — `transform` isn't additive, so a bare
     `scale(1.06)` on hover would overwrite the positioning translate
     entirely and the button would jump to a different spot the instant
     the pointer reached it, rather than growing in place. */
  .lightbox__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
  }

  .lightbox__arrow--prev {
    left: 0;
    transform: translate(-130%, -50%);
  }

  .lightbox__arrow--prev:hover {
    background: var(--color-accent-strong);
    color: var(--color-text-on-dark);
    transform: translate(-130%, -50%) scale(1.06);
  }

  .lightbox__arrow--next {
    right: 0;
    transform: translate(130%, -50%);
  }

  .lightbox__arrow--next:hover {
    background: var(--color-accent-strong);
