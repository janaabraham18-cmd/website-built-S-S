---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tours } from '../data/tours';

const heroPhoto = {
  url: 'https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Joshua Kettle', username: 'joshuakettle' },
};

// Only real, locally-hosted photos ever reach this page now — every
// placeholder used stock Unsplash photography, so there's only ever
// one category left to badge.
type GalleryCategory = 'tour';

const badgeLabels: Record<GalleryCategory, string> = {
  tour: 'Tour',
};

interface GalleryItem {
  slug: string;
  name: string;
  category: GalleryCategory;
  imageUrl: string;
  imageCredit?: { name: string; username: string };
  href: string;
}

// Real photos from an actual Salt and Sun Tours outing (shared by Lenga),
// not stock — kept as their own entries rather than forced onto a single
// tour's one-imageUrl slot in tours.ts, since a few of these don't map
// to one specific tour.
const fromTheRoadItems: GalleryItem[] = [
  {
    slug: 'from-the-road-beach-picnic',
    name: 'Sundowners by the Bay',
    category: 'tour',
    imageUrl: '/images/gallery-beach-picnic.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-celebrating-in-the-dunes',
    name: 'Celebrating in the Dunes',
    category: 'tour',
    imageUrl: '/images/gallery-celebrating-in-the-dunes.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-walvis-bay-jetty',
    name: 'The Walvis Bay Jetty',
    category: 'tour',
    imageUrl: '/images/gallery-walvis-bay-jetty.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-catamaran-guests',
    name: 'All Smiles on the Water',
    category: 'tour',
    imageUrl: '/images/gallery-catamaran-guests.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-walking-deadvlei',
    name: 'Walking Deadvlei',
    category: 'tour',
    imageUrl: '/images/gallery-walking-deadvlei.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-desert-arch',
    name: 'A Desert Arch',
    category: 'tour',
    imageUrl: '/images/gallery-desert-arch.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-plains-wildlife',
    name: 'Plains Wildlife',
    category: 'tour',
    imageUrl: '/images/gallery-plains-wildlife.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-desert-ostrich',
    name: 'Desert Ostrich',
    category: 'tour',
    imageUrl: '/images/gallery-desert-ostrich.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-stars-over-the-namib',
    name: 'Stars Over the Namib',
    category: 'tour',
    imageUrl: '/images/gallery-stars-over-the-namib.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-on-the-road',
    name: 'On the Road',
    category: 'tour',
    imageUrl: '/images/gallery-on-the-road.jpg',
    href: '/tours',
  },
];

// Real photos only — every tour/adventure/combo/journey placeholder used
// stock Unsplash photography, so this page now shows just the genuine
// shots from an actual outing: the "From the Road" set above, plus any
// tour that has its own real (non-Unsplash) photo.
const galleryItems: GalleryItem[] = [
  ...fromTheRoadItems,
  ...tours
    .filter(
      (tour): tour is typeof tour & { imageUrl: string } =>
        !!tour.imageUrl && !tour.imageUrl.startsWith('https://images.unsplash.com')
    )
    .map((tour) => ({
      slug: tour.slug,
      name: tour.name,
      category: 'tour' as const,
      imageUrl: tour.imageUrl,
      imageCredit: tour.imageCredit,
      href: '/tours',
    })),
];
---

<BaseLayout
  title="Gallery"
  description="Real photos from our tours — guests, landmarks and wildlife around Swakopmund and Walvis Bay, Namibia."
>
  <section class="gallery-hero">
    <div class="gallery-hero__bg" style={`background-image:url('${heroPhoto.url}')`} aria-hidden="true"></div>
    <div class="gallery-hero__scrim" aria-hidden="true"></div>

    <div class="container gallery-hero__content">
      <p class="eyebrow">The Photo Roll</p>
      <h1>Gallery</h1>
      <p class="gallery-header__body">
        Real moments from the road — guests, landmarks and wildlife from the
        tours we run. Tap a photo to see where it leads.
      </p>
    </div>
  </section>

  <section class="gallery-grid-section reveal">
    <div class="container">
      <div class="gallery-grid reveal-item">
        {galleryItems.map((item) => (
          <div class="gallery-tile">
            <a class="gallery-tile__link" href={item.href}>
              <div class="photo-frame gallery-tile__photo">
                <img src={item.imageUrl} alt={item.name} loading="lazy" decoding="async" />
                <span class="gallery-tile__badge">{badgeLabels[item.category]}</span>
              </div>
              <p class="gallery-tile__name">{item.name}</p>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Bounded hero (not the whole page) with its own photo + scrim — text
     sits at the top of the photo and nothing below it needs to stay
     clear, so a flatter gradient clearing by ~80% (same treatment as
     the Adventures hero) rather than the page-length photo other inner
     pages use. The grid section below stays on the plain light page
     background. */
  .gallery-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-earth-700);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .gallery-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center 55%;
  }

  .gallery-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.78) 0%, rgba(31, 18, 14, 0.3) 50%, rgba(31, 18, 14, 0) 80%);
  }

  .gallery-hero__content {
    position: relative;
    z-index: 1;
  }

  /* This page never had a base .eyebrow rule — the label rendered as a
     plain paragraph with none of the small-caps treatment every other
     page's eyebrow gets. */
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .gallery-hero .eyebrow {
    color: var(--color-sand-100);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .gallery-hero h1 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-sm);
  }

  .gallery-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    max-width: var(--content-width-narrow);
    margin: 0 0 var(--space-lg);
  }

  .gallery-grid-section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .gallery-tile__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .gallery-tile__photo {
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-sm);
  }

  /* .photo-frame (global.css) is already position: relative, overflow:
     hidden — this just pins the badge to it. */
  .gallery-tile__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 1;
    background: var(--color-accent-strong);
    color: var(--color-text-on-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .gallery-tile__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text);
    margin: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .gallery-tile__link:hover .gallery-tile__name {
    color: var(--color-accent-strong);
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-md);
    }
  }
</style>
