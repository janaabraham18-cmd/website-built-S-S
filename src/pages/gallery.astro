---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tours, categoryLabels } from '../data/tours';
import { journeys } from '../data/journeys';

const heroPhoto = {
  url: 'https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Joshua Kettle', username: 'joshuakettle' },
};

type GalleryCategory = 'tour' | 'adventure' | 'combo' | 'journey';

// Short singular label for the badge shown on each tile — categoryLabels
// is plural ("Tours", "Adventures") for the filter pills, this is its own
// small map rather than singularizing that string at render time.
const badgeLabels: Record<GalleryCategory, string> = {
  tour: 'Tour',
  adventure: 'Adventure',
  combo: 'Combo',
  journey: 'Journey',
};

interface GalleryItem {
  slug: string;
  name: string;
  category: GalleryCategory;
  imageUrl: string;
  imageCredit?: { name: string; username: string };
  href: string;
}

// Real photos from an actual Salt and Sun Tours outing (shared by Lenga),
// not stock — kept as their own entries rather than forced onto a single
// tour's one-imageUrl slot in tours.ts, since a few of these don't map
// to one specific tour.
const fromTheRoadItems: GalleryItem[] = [
  {
    slug: 'from-the-road-sandwich-harbour-lookout',
    name: 'Sandwich Harbour Lookout',
    category: 'tour',
    imageUrl: '/images/gallery-sandwich-harbour-lookout.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-sandwich-harbour-overlook',
    name: 'Where Ocean Meets Desert',
    category: 'tour',
    imageUrl: '/images/gallery-sandwich-harbour-overlook.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-sandwich-harbour-view',
    name: 'Taking In the View',
    category: 'tour',
    imageUrl: '/images/gallery-sandwich-harbour-view.jpg',
    href: '/tours',
  },
  {
    slug: 'from-the-road-beach-picnic',
    name: 'Sundowners by the Bay',
    category: 'tour',
    imageUrl: '/images/gallery-beach-picnic.jpg',
    href: '/tours',
  },
];

// Every real photo already sourced for the tours/adventures/combos and
// journeys, gathered into one browsable set rather than re-sourced —
// this page is a way to see them all together, not a new photo shoot.
const galleryItems: GalleryItem[] = [
  ...fromTheRoadItems,
  ...tours
    .filter((tour): tour is typeof tour & { imageUrl: string } => !!tour.imageUrl)
    .map((tour) => ({
      slug: tour.slug,
      name: tour.name,
      category: tour.category,
      imageUrl: tour.imageUrl,
      imageCredit: tour.imageCredit,
      href: '/tours',
    })),
  ...journeys.map((journey) => ({
    slug: journey.slug,
    name: journey.name,
    category: 'journey' as const,
    imageUrl: journey.heroImage,
    imageCredit: journey.imageCredit,
    href: `/journeys#${journey.slug}`,
  })),
];

const filters: { key: 'all' | GalleryCategory; label: string }[] = [
  { key: 'all', label: 'All' },
  { key: 'tour', label: categoryLabels.tour.label },
  { key: 'adventure', label: categoryLabels.adventure.label },
  { key: 'combo', label: categoryLabels.combo.label },
  { key: 'journey', label: 'Journeys' },
];
---

<BaseLayout
  title="Gallery"
  description="Photos from every tour, adventure, combo and Journey Salt and Sun Tours offers in Swakopmund and Walvis Bay, Namibia."
>
  <section class="gallery-hero">
    <div class="gallery-hero__bg" style={`background-image:url('${heroPhoto.url}')`} aria-hidden="true"></div>
    <div class="gallery-hero__scrim" aria-hidden="true"></div>

    <div class="container gallery-hero__content">
      <p class="eyebrow">The Photo Roll</p>
      <h1>Gallery</h1>
      <p class="gallery-header__body">
        Every tour, adventure, combo and Journey we run — gathered in one place.
        Tap a filter to narrow it down, or a photo to see where it leads.
      </p>

      <div class="gallery-filters" role="group" aria-label="Filter gallery by category">
        {filters.map((filter, i) => (
          <button
            type="button"
            class:list={['gallery-filters__pill', i === 0 && 'is-active']}
            data-gallery-filter={filter.key}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="gallery-grid-section reveal">
    <div class="container">
      <div class="gallery-grid reveal-item">
        {galleryItems.map((item) => (
          <div class="gallery-tile" data-gallery-item data-category={item.category}>
            <a class="gallery-tile__link" href={item.href}>
              <div class="photo-frame gallery-tile__photo">
                <img src={item.imageUrl} alt={item.name} loading="lazy" decoding="async" />
                <span class="gallery-tile__badge">{badgeLabels[item.category]}</span>
              </div>
              <p class="gallery-tile__name">{item.name}</p>
            </a>
          </div>
        ))}
      </div>

      <p class="gallery-empty" data-gallery-empty hidden>
        Nothing in this category yet — try a different filter.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Bounded hero (not the whole page) with its own photo + scrim — text
     sits at the top of the photo and nothing below it needs to stay
     clear, so a flatter gradient clearing by ~80% (same treatment as
     the Adventures hero) rather than the page-length photo other inner
     pages use. The grid section below stays on the plain light page
     background. */
  .gallery-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-earth-700);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .gallery-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center 55%;
  }

  .gallery-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.78) 0%, rgba(31, 18, 14, 0.3) 50%, rgba(31, 18, 14, 0) 80%);
  }

  .gallery-hero__content {
    position: relative;
    z-index: 1;
  }

  /* This page never had a base .eyebrow rule — the label rendered as a
     plain paragraph with none of the small-caps treatment every other
     page's eyebrow gets. */
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .gallery-hero .eyebrow {
    color: var(--color-sand-100);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .gallery-hero h1 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-sm);
  }

  .gallery-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    max-width: var(--content-width-narrow);
    margin: 0 0 var(--space-lg);
  }

  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .gallery-filters__pill {
    font-family: var(--font-body);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    /* Now sitting on a photo instead of a flat background — a bit of
       lift keeps the pills reading as controls rather than blending
       into whatever's behind them. */
    box-shadow: var(--shadow-sm);
    transition: background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .gallery-filters__pill:hover {
    border-color: var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .gallery-filters__pill.is-active {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text-on-dark);
  }

  .gallery-grid-section {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-lg);
  }

  .gallery-tile__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .gallery-tile__photo {
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-sm);
    margin-bottom: var(--space-sm);
  }

  /* .photo-frame (global.css) is already position: relative, overflow:
     hidden — this just pins the badge to it. Mainly useful when "All"
     is selected, so each tile still reads at a glance without reaching
     for the filter pills. */
  .gallery-tile__badge {
    position: absolute;
    top: var(--space-sm);
    left: var(--space-sm);
    z-index: 1;
    background: var(--color-accent-strong);
    color: var(--color-text-on-dark);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    box-shadow: var(--shadow-sm);
  }

  .gallery-tile__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text);
    margin: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .gallery-tile__link:hover .gallery-tile__name {
    color: var(--color-accent-strong);
  }

  .gallery-tile[hidden] {
    display: none;
  }

  .gallery-empty {
    text-align: center;
    color: var(--color-text-muted);
    padding-block: var(--space-2xl);
    margin: 0;
  }

  .gallery-empty[hidden] {
    display: none;
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-md);
    }
  }
</style>
