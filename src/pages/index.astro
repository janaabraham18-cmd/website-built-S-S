---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';

const heroPanels = [
  {
    letter: 'N',
    alt: 'A herd of desert-adapted elephants walking along a dry riverbed in Namibia',
    imageUrl:
      'https://images.unsplash.com/photo-1667389861341-3f1c749cdf39?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Elina Palm', username: 'drawmeasun' },
  },
  {
    letter: 'A',
    alt: 'A lone oryx crossing the Namib desert plain',
    imageUrl:
      'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Arthur Souquet', username: 'arthursouquet' },
  },
  {
    letter: 'M',
    alt: 'Flamingos wading in the shallow waters of Walvis Bay',
    imageUrl:
      'https://images.unsplash.com/photo-1669805508900-d3eaed6e6c14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Vladimir Oprisko', username: 'captoprisko' },
  },
  {
    letter: 'I',
    alt: 'A Cape fur seal resting on the Namibian coast',
    imageUrl:
      'https://images.unsplash.com/photo-1772290226248-156cc5fe4f9b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    letter: 'B',
    alt: 'A cheetah in the Namibian bush',
    imageUrl:
      'https://images.unsplash.com/photo-1696894132788-d0b1af4c95a7?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Taylor Wright', username: 'taylorwright22' },
  },
  {
    letter: 'I',
    alt: 'Two zebras on the plains of Etosha National Park',
    imageUrl:
      'https://images.unsplash.com/photo-1579172342894-e6d751ec390c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Geranimo', username: 'geraninmo' },
  },
  {
    letter: 'A',
    alt: 'Towering red sand dunes under a clear sky near Sossusvlei',
    imageUrl:
      'https://images.unsplash.com/photo-1613155358201-36bcf3ce695e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Mareike Kramper', username: 'mareike_capetown' },
  },
];

// "The Route" — five destinations fanning out from the two basecamps.
// Coordinates are a stylized (not geographically literal) 0-100 layout;
// each route-stop button and its matching SVG line share the same
// percentage so they stay coincident regardless of viewport width.
const routeDestinations = [
  {
    slug: 'sossusvlei-tour',
    name: 'Sossusvlei',
    tag: 'Desert · Half-day',
    teaser: 'Where the dunes turn red at dawn.',
    x: 45,
    y: 78,
    imageUrl: 'https://images.unsplash.com/photo-1587321174565-73cffc72e10a?w=900&q=80&auto=format&fit=crop',
    imageCredit: { name: 'Felipe Labate', username: 'felipelabate' },
  },
  {
    slug: 'sandwich-harbour-full-day',
    name: 'Sandwich Harbour',
    tag: 'Coastal · Full-day',
    teaser: 'Dunes dropping straight into the Atlantic.',
    x: 20,
    y: 72,
    imageUrl: 'https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?w=900&q=80&auto=format&fit=crop',
    imageCredit: { name: 'Bernd Dittrich', username: 'hdbernd' },
  },
  {
    slug: 'etosha-tour',
    name: 'Etosha',
    tag: 'Wildlife · Multi-day',
    teaser: 'Wildlife gathered at every waterhole.',
    x: 70,
    y: 18,
    imageUrl: 'https://images.unsplash.com/photo-1596225893172-1685676f0a50?w=900&q=80&auto=format&fit=crop',
    imageCredit: { name: 'Eelco Böhtlingk', username: 'eelco_bohtlingk' },
  },
  {
    slug: 'skeleton-coast-tour',
    name: 'Skeleton Coast',
    tag: 'Coastal · Full-day',
    teaser: 'Shipwrecks and fog along a wild shoreline.',
    x: 15,
    y: 10,
    imageUrl: 'https://images.unsplash.com/photo-1551176968-bf1e434355f6?w=900&q=80&auto=format&fit=crop',
    imageCredit: { name: 'Sam Power', username: 'sampowerphoto' },
  },
  {
    slug: 'pelican-point-tour',
    name: 'Pelican Point',
    tag: 'Coastal · Half-day',
    teaser: 'Thousands of Cape fur seals, up close.',
    x: 25,
    y: 60,
    imageUrl: 'https://images.unsplash.com/photo-1635764857370-911375b7a87a?w=900&q=80&auto=format&fit=crop',
    imageCredit: { name: 'katsuma tanaka', username: 'kt2080' },
  },
];

// The Sossusvlei photo already opens the page in the Brief banner and
// repeats in the Itinerary row below, so this preview defaults to Etosha
// instead to avoid a third repeat of the same shot right after the hero.
const defaultRouteIndex = routeDestinations.findIndex((d) => d.slug === 'etosha-tour');
const defaultRoute = routeDestinations[defaultRouteIndex];

const itineraryFilters = [
  { key: 'all', label: 'All' },
  { key: 'desert', label: 'Desert' },
  { key: 'coastal', label: 'Coastal' },
  { key: 'adventure', label: 'Adventure' },
  { key: 'wildlife', label: 'Wildlife' },
  { key: 'culture', label: 'Culture' },
];

const stampStats = [
  { value: 31, label: 'Experiences' },
  { value: 2, label: 'Basecamps' },
  { value: 0, label: 'Middlemen' },
];

// Real guest reviews, transcribed verbatim from Salt and Sun Tours' Google
// Business profile. Add more entries here as they're supplied — don't mix
// in placeholder text once a real review is in the array.
const testimonials = [
  {
    quote: "Fantastic experience. I had the pleasure to meet Lenga, the guide and he presented Namibia at a glance and its most beautiful sides. Seperate from his knowledge on the country a very pleasant experience. Well done Team Salt & Sun!",
    name: 'Jos Bol',
    trip: 'Google review',
    rating: 5,
  },
  {
    quote: "I had an amazing experience on the excavation tour to the Pink Lake with my friends. Our tour guide, Mr. Lenga and his coworker were very knowledgeable, friendly and welcoming. Everything was well explained, engaging and fun. I truly enjoyed every moment and learned so much while having a great time. It was a memorable experience and I would highly recommend this tour to anyone looking for a fun and educational adventure.",
    name: 'Lorraine Taylor',
    trip: 'Google review',
    rating: 5,
  },
  {
    quote: "Lenga is a great tour guide, everything was very well organized, he was on time and took care of us well. We had lots of time to stop at all the stops and take pictures at our leisure. He was very informative and gave us lots of key information about the areas. He tried his best to find some wild animals for us to see. The food that was supplied was amazing and Sandwich Harbour was picturesque. Thank you !",
    name: 'A P',
    trip: 'Google review',
    rating: 5,
  },
];

const faqItems = [
  {
    q: 'Do I need to book in advance?',
    a: "Most tours can be arranged with a few days' notice, but popular dates fill up faster in peak season.",
  },
  {
    q: 'Where do tours depart from?',
    a: "Most tours depart from Swakopmund or Walvis Bay; we'll confirm your pick-up point when we plan your day.",
  },
  {
    q: 'Can tours be combined?',
    a: 'Yes — many guests pair a tour with a shorter adventure or a combo deal; see the tours page for options.',
  },
  {
    q: 'What should I bring?',
    a: "Comfortable shoes, sun protection, and a camera; we'll flag anything tour-specific when we confirm your booking.",
  },
];

---

<BaseLayout
  title="Home"
  description="Desert and coastal tours from Swakopmund and Walvis Bay, Namibia — Etosha, Sossusvlei, Skeleton Coast, and more with Salt and Sun Tours."
>
  <Hero
    title="Namibia"
    eyebrow="Salt and Sun Tours"
    subhead="Desert and coastal adventures out of Swakopmund and Walvis Bay — from towering red dunes to seal colonies at Pelican Point."
    ctaLabel="Explore our tours"
    ctaHref="/tours"
    panels={heroPanels}
  />

  <div id="scroll-target"></div>

  <!-- ============ 01 · THE BRIEF ============ -->
  <section class="block brief-block reveal" id="brief">
    <p class="eyebrow">The Brief</p>
    <div class="brief-spread">
      <div class="brief-copy reveal-item">
        <blockquote class="brief-quote">"We run every tour out of Swakopmund and Walvis Bay — no call center, no middleman."</blockquote>
        <p>Just guides who know the dunes and the coastline because they work them every day — covering both ends of what Namibia does best, the towering red dunes inland and the seal colonies and Atlantic swell along the coast, often on the same day if that's how you want to build your trip.</p>
      </div>
      <div class="brief-vitals reveal-item">
        <div class="vital"><b>2</b><span>Basecamps</span></div>
        <div class="vital"><b>31</b><span>Experiences</span></div>
        <div class="vital"><b>0</b><span>Middlemen</span></div>
      </div>
    </div>
    <div class="brief-banner reveal-item">
      <div class="photo-frame">
        <img
          src="https://images.unsplash.com/photo-1587321174565-73cffc72e10a?w=1600&q=80&auto=format&fit=crop"
          alt="The ancient dead camel-thorn trees of Deadvlei rising from the red dunes"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ============ 02 · THE ROUTE ============ -->
  <section class="block route-block reveal" id="route">
    <div class="route-block__bg" data-route-bg aria-hidden="true"></div>
    <p class="eyebrow">The Route</p>
    <h2 class="section-title">Two basecamps, five routes worth taking</h2>

    <div class="route-layout reveal-item">
      <div class="route-map" data-route-map>
        <svg class="route-map__lines" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <circle class="route-map__base" cx="12" cy="35" r="1.6" />
          <circle class="route-map__base" cx="12" cy="55" r="1.6" />
          {
            routeDestinations.map((d) => {
              const fromSwakopmund = d.slug === 'skeleton-coast-tour' || d.slug === 'etosha-tour';
              return <line class="route-line" data-dest={d.slug} x1="12" y1={fromSwakopmund ? 35 : 55} x2={d.x} y2={d.y} />;
            })
          }
        </svg>
        <span class="route-map__label" style={`left:9%; top:41%;`}>Swakopmund</span>
        <span class="route-map__label" style={`left:9%; top:61%;`}>Walvis Bay</span>

        {
          routeDestinations.map((d, i) => (
            <button
              type="button"
              class:list={['route-stop', i === defaultRouteIndex && 'is-active']}
              data-dest={d.slug}
              data-name={d.name}
              data-tag={d.tag}
              data-teaser={d.teaser}
              data-slug={d.slug}
              data-img={d.imageUrl}
              data-credit-name={d.imageCredit.name}
              data-credit-username={d.imageCredit.username}
              style={`left:${d.x}%; top:${d.y}%;`}
            >
              <span class="route-stop__dot" aria-hidden="true" />
              <span class="visually-hidden">{d.name}</span>
            </button>
          ))
        }
      </div>

      <div class="route-preview" data-route-preview>
        <div class="photo-frame route-preview__photo">
          <img
            data-preview-img
            src={defaultRoute.imageUrl}
            alt={defaultRoute.name}
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="route-preview__tag" data-preview-tag>{defaultRoute.tag}</p>
        <h3 class="route-preview__name" data-preview-name>{defaultRoute.name}</h3>
        <p class="route-preview__teaser" data-preview-teaser>{defaultRoute.teaser}</p>
        <p class="route-preview__credit">
          Photo:{' '}
          <a data-preview-credit-name href={`https://unsplash.com/@${defaultRoute.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`} target="_blank" rel="noopener noreferrer">{defaultRoute.imageCredit.name}</a>{' '}
          /{' '}
          <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
        </p>
        <a class="btn btn-outline route-preview__cta" data-preview-cta href={`/booking?tour=${defaultRoute.slug}`}>Book this route</a>
      </div>
    </div>
  </section>

  <!-- ============ 03 · THE ITINERARY ============ -->
  <section class="block itinerary-block reveal" id="itinerary">
    <p class="eyebrow">The Itinerary</p>
    <h2 class="section-title">A closer look at the lineup</h2>

    <div class="itinerary-filters reveal-item" role="group" aria-label="Filter tours by type">
      {
        itineraryFilters.map((f, i) => (
          <button type="button" class:list={['filter-pill', i === 0 && 'is-active']} data-filter={f.key}>{f.label}</button>
        ))
      }
    </div>

    <div class="program-item" data-alt-row data-category="desert">
      <div class="program-media">
        <span class="ticket-stub">Half<br />Day</span>
        <div class="photo-frame">
          <div class="program-media__parallax" data-parallax-img>
            <img
              src="https://images.unsplash.com/photo-1587321174565-73cffc72e10a?w=900&q=80&auto=format&fit=crop"
              alt="The dead trees of Deadvlei at Sossusvlei"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="program-copy">
        <p class="program-tag">Desert Tour · Half-day</p>
        <p class="tour-name">Sossusvlei Tour</p>
        <h3>Namibia's most photographed dunes</h3>
        <p>Deep in the Namib-Naukluft, the dunes at Sossusvlei rise over 300 metres above the pan floor. We time the drive for early light, when the red sand and the dead trees at Deadvlei throw the longest shadows of the day.</p>
        <a class="book-link" href="/booking?tour=sossusvlei-tour">Book this tour</a>
      </div>
    </div>

    <div class="program-item reverse" data-alt-row data-thread data-category="coastal">
      <div class="program-media">
        <span class="ticket-stub">Full<br />Day</span>
        <div class="photo-frame">
          <div class="program-media__parallax" data-parallax-img>
            <img
              src="https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?w=900&q=80&auto=format&fit=crop"
              alt="Sandwich Harbour where dunes meet the ocean"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="program-copy">
        <p class="program-tag">Coastal Tour · Full-day</p>
        <p class="tour-name">Sandwich Harbour Tour</p>
        <h3>Where the dunes plunge into the Atlantic</h3>
        <p>A 4x4 run past salt pans and flamingo-filled lagoons to Namibia's most photographed meeting of desert and ocean — towering dunes dropping straight into the sea.</p>
        <a class="book-link" href="/booking?tour=sandwich-harbour-full-day">Book this tour</a>
      </div>
    </div>

    <div class="program-item" data-alt-row data-thread data-category="adventure">
      <div class="program-media">
        <span class="ticket-stub">Half<br />Day</span>
        <div class="photo-frame">
          <div class="program-media__parallax" data-parallax-img>
            <img
              src="https://images.unsplash.com/photo-1769450290445-3daed0c8fe63?w=900&q=80&auto=format&fit=crop"
              alt="Quad biking on the dunes"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="program-copy">
        <p class="program-tag">Adventure · Half-day</p>
        <p class="tour-name">Quad Bike Tour</p>
        <h3>Ride the dunes yourself</h3>
        <p>A guided quad bike run through the dune belt outside Swakopmund, built for anyone who wants to do more than just look at the sand.</p>
        <a class="book-link" href="/booking?tour=quad-bike-tour">Book this tour</a>
      </div>
    </div>

    <div class="program-item reverse" data-alt-row data-thread data-category="coastal">
      <div class="program-media">
        <span class="ticket-stub">Half<br />Day</span>
        <div class="photo-frame">
          <div class="program-media__parallax" data-parallax-img>
            <img
              src="https://images.unsplash.com/photo-1440020143730-090579c4d53c?w=900&q=80&auto=format&fit=crop"
              alt="Catamaran cruise with dolphins"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="program-copy">
        <p class="program-tag">Coastal · Half-day</p>
        <p class="tour-name">Dolphin &amp; Seal Catamaran Cruise</p>
        <h3>Dolphins, seals, and the Walvis Bay lagoon</h3>
        <p>A catamaran cruise out of Walvis Bay past the seal colony at Pelican Point, with a good chance of dolphins riding the bow wake along the way.</p>
        <a class="book-link" href="/booking?tour=dolphin-seal-catamaran-cruise">Book this tour</a>
      </div>
    </div>

    <div class="program-item" data-alt-row data-thread data-category="wildlife">
      <div class="program-media">
        <span class="ticket-stub">Multi<br />Day</span>
        <div class="photo-frame">
          <div class="program-media__parallax" data-parallax-img>
            <img
              src="https://images.unsplash.com/photo-1596225893172-1685676f0a50?w=900&q=80&auto=format&fit=crop"
              alt="Lioness at Etosha National Park"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="program-copy">
        <p class="program-tag">Wildlife · Multi-day</p>
        <p class="tour-name">Etosha Tour</p>
        <h3>Namibia's flagship game park</h3>
        <p>Etosha's salt pan and waterholes concentrate wildlife in a way few parks can match — oryx, zebra, elephant, and the cats that follow them.</p>
        <a class="book-link" href="/booking?tour=etosha-tour">Book this tour</a>
      </div>
    </div>

    <div class="program-item reverse" data-alt-row data-thread data-category="culture">
      <div class="program-media">
        <span class="ticket-stub">Half<br />Day</span>
        <div class="photo-frame">
          <div class="program-media__parallax" data-parallax-img>
            <img
              src="https://images.unsplash.com/photo-1603703182693-51a19941fa59?w=900&q=80&auto=format&fit=crop"
              alt="Township tour in Swakopmund"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
      <div class="program-copy">
        <p class="program-tag">Culture · Half-day</p>
        <p class="tour-name">Township Tour</p>
        <h3>Life in Mondesa and DRC</h3>
        <p>A guided walk through Swakopmund's townships, led by people who live there — the side of town most visitors never see.</p>
        <a class="book-link" href="/booking?tour=township-tour">Book this tour</a>
      </div>
    </div>
  </section>

  <!-- ============ 04 · ABOUT US ============ -->
  <section class="block about-block reveal" id="about">
    <p class="eyebrow">About Us</p>
    <h2 class="section-title">More than a journey</h2>
    <div class="about-copy reveal-item">
      <div class="about-copy__columns">
        <p class="about-copy__lead">My name is Lenga, and Lenga means King.</p>

        <p>My roots are in Etosha, where the earth carries one of Namibia's greatest wonders — the Etosha salt pan. That is where the heart of Salt and Sun Tours begins: from the salt of the earth, under the Namibian sun, and grounded in a purpose greater than tourism.</p>

        <p>Our foundation is inspired by Matthew 5:13–16 — to be salt and light in the world.</p>

        <p>For us, a tour is not simply about driving through the dunes, watching wildlife, camping beneath the stars, enjoying a picnic, or experiencing the thrill of an adventure.</p>

        <p class="about-copy__pull">It is about the person you become along the way.</p>

        <p>Life leaves people carrying stories that are often never spoken — pain, disappointment, loss, rejection, fear, and experiences that shape who we become. My own journey taught me that sometimes healing begins when we finally have a safe place to be heard.</p>

        <p>That is what we want Salt and Sun Tours to be.</p>

        <p class="about-copy__list">
          A place where strangers can become companions.<br />
          Where conversations go deeper than the road ahead.<br />
          Where stories can be shared without judgement.<br />
          Where we can laugh, reflect, encourage one another, and sometimes simply sit in silence beneath the African sky.
        </p>

        <p class="about-copy__pull">
          You may arrive looking for Namibia.<br />
          You may leave having found a little more of yourself.
        </p>

        <p>We believe that every person has value, regardless of their past, their mistakes, or what they have been through. And sometimes, one person's testimony can become another person's reason to keep going.</p>

        <p>So when you travel with us, you are not just booking a tour.</p>

        <p class="about-copy__pull">You are joining a journey of connection, discovery, healing and transformation.</p>
      </div>

      <div class="about-copy__close">
        <p class="about-copy__invite">Come experience the salt. Feel the sun. Meet the wilderness. Share the journey.</p>

        <p>And perhaps, somewhere between the desert and the stars, you will discover that the greatest destination was never a place — it was becoming who you were created to be.</p>

        <div class="about-copy__signoff">
          <p class="about-copy__signoff-name">Salt and Sun Tours</p>
          <p class="about-copy__signoff-tag">More than a tour. A journey that leaves a mark.</p>
        </div>
      </div>
    </div>

    <div class="about-profile-block">
      <div class="about-profile-caption">
        <p class="about-profile-name">Lenga Shihueka</p>
        <p class="about-profile-role">Founder</p>
      </div>
      <div class="about-profile">
        <img
          src="https://saltandsuntours.com.na/wp-content/uploads/2026/04/WhatsApp-Image-2025-10-24-at-4.58.13-PM.jpeg"
          alt="Lenga Shihueka, founder of Salt and Sun Tours"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <!-- ============ 05 · PASSPORT STAMPS ============ -->
  <section class="stamps-block reveal" id="stamps">
    <div class="stamps-inner">
      <p class="eyebrow">Passport Stamps</p>
      <h2 class="section-title">The short version</h2>
      <div class="stamps-row reveal-item">
        {
          stampStats.map((s) => (
            <div class="stamp">
              <b data-count-to={s.value}>0</b>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ 06 · THE LOGBOOK ============ -->
  <section class="block logbook-block reveal" id="logbook">
    <p class="eyebrow">The Logbook</p>
    <h2 class="section-title">Namibia, in passing</h2>
    <div class="logbook-grid reveal-item">
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1709192856319-255c881dd630?w=600&q=80&auto=format&fit=crop" alt="Fish River Canyon at dawn, one of the largest canyons in the world" loading="lazy" decoding="async" /></div><figcaption>dawn over the canyon</figcaption></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1595652974715-571ba74668b5?w=600&q=80&auto=format&fit=crop" alt="A giraffe at sunset in Etosha National Park" loading="lazy" decoding="async" /></div></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1696894134302-7e124a8bf2e8?w=600&q=80&auto=format&fit=crop" alt="A lone oryx crossing the red dunes of the Namib" loading="lazy" decoding="async" /></div></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1669220228835-6c80412646d2?w=600&q=80&auto=format&fit=crop" alt="Spitzkoppe's granite peaks under a star-filled sky" loading="lazy" decoding="async" /></div></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1621238705338-532e7df61de5?w=600&q=80&auto=format&fit=crop" alt="Cape fur seal colony at Cape Cross" loading="lazy" decoding="async" /></div><figcaption>seal colony, Cape Cross</figcaption></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1595583945105-3138e8dd6b98?w=600&q=80&auto=format&fit=crop" alt="Mountains of Damaraland at sunset" loading="lazy" decoding="async" /></div></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1595961664116-130d677eb080?w=600&q=80&auto=format&fit=crop" alt="A black rhino in its natural Namibian habitat" loading="lazy" decoding="async" /></div></figure>
      <figure class="logbook-item"><div class="photo-frame photo-frame--sm"><img src="https://images.unsplash.com/photo-1665072523770-601bd7e96aef?w=600&q=80&auto=format&fit=crop" alt="Aerial view of Namib desert dune patterns" loading="lazy" decoding="async" /></div><figcaption>the dunes, from above</figcaption></figure>
    </div>
  </section>

  <!-- ============ 07 · BEFORE YOU GO ============ -->
  <section class="block faq-block reveal" id="faq">
    <p class="eyebrow">Before You Go</p>
    <h2 class="section-title">A few things people ask</h2>
    <div class="faq-list reveal-item">
      {
        faqItems.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
    <p class="faq-more">Have a different question? <a href="/contact">Get in touch</a>.</p>
  </section>

  <!-- ============ 08 · POSTCARDS FROM THE ROAD ============ -->
  <section class="block postcards-block reveal" id="postcards">
    <div class="postcards-block__bg" data-postcards-bg aria-hidden="true"></div>
    <p class="eyebrow">Postcards from the Road</p>
    <h2 class="section-title">What guests say</h2>

    <div class="postcards reveal-item" data-postcards>
      <div class="postcards__stack">
        {
          testimonials.map((t, i) => (
            <article class:list={['postcard', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="postcard__rating" aria-label={`Rated ${t.rating} out of 5 stars`}>
                {
                  Array.from({ length: 5 }).map((_, star) => (
                    <svg class:list={['postcard__star', star >= t.rating && 'is-empty']} viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M10 15.27L16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" />
                    </svg>
                  ))
                }
              </div>
              <p class="postcard__quote">"{t.quote}"</p>
              <p class="postcard__name">{t.name}</p>
              <p class="postcard__trip">
                <svg class="postcard__google-mark" viewBox="0 0 48 48" aria-hidden="true">
                  <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z" />
                  <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z" />
                  <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z" />
                  <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z" />
                </svg>
                {t.trip}
              </p>
            </article>
          ))
        }
      </div>
      <div class="postcards__controls">
        <button type="button" class="postcards__arrow" data-postcard-prev aria-label="Previous postcard">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <p class="postcards__counter"><span data-postcard-current>1</span> / {testimonials.length}</p>
        <button type="button" class="postcards__arrow" data-postcard-next aria-label="Next postcard">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- Section shell ---------- */
  .block {
    background: var(--color-surface);
    color: var(--color-text);
    padding: clamp(3.5rem, 8vw, 6.25rem) clamp(1.25rem, 8vw, 6rem);
  }

  /* background-color only (not the `background` shorthand) — a shorthand
     here would silently reset background-image back to none at ID-level
     specificity, beating the lower-specificity .brief-block/.itinerary-block
     glow rules below regardless of source order. */
  #brief, #itinerary, #faq { background-color: var(--color-bg-alt); }

  /* ---------- Desert Light: per-section glows ----------
     Soft, color-matched glow keyed to each section's own photos, layered
     on top of the background colors above rather than replacing them.
     Placed after .block/#brief,#itinerary,#faq so these longhand
     background-image declarations win at equal specificity. */
  .brief-block,
  .itinerary-block {
    background-image: var(--gradient-glow-warm);
  }

  /* A giraffe shot (also used in the Logbook grid) sits behind the route
     map/card as ambient texture — the map and preview card both carry
     their own solid backgrounds, so this only shows through the
     section's own padding, never behind the card content. Lives on its
     own layer (rather than directly on .route-block's background) so it
     can be pushed taller than the section and scrubbed with scroll for
     a parallax drift, the same technique as .section__bg elsewhere. */
  .route-block {
    position: relative;
    z-index: 0;
    overflow: hidden;
  }

  .route-block__bg {
    position: absolute;
    inset: -15% 0;
    background-image: var(--gradient-glow-coastal),
      url('https://images.unsplash.com/photo-1595652974715-571ba74668b5?w=1600&q=80&auto=format&fit=crop');
    background-size: auto, cover;
    background-position: 0 0, center;
    background-repeat: no-repeat, no-repeat;
    z-index: -1;
    will-change: transform;
  }

  .logbook-block {
    background-image: var(--gradient-glow-wild);
  }

  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0 0 3.75rem 0;
    color: var(--color-text);
    max-width: 700px;
  }

  /* ---------- 01 The Brief ---------- */
  .brief-spread {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .brief-quote {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.3;
    margin: 0 0 1.25rem;
    color: var(--color-text);
    text-wrap: balance;
  }

  .brief-copy p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 52ch;
  }

  .brief-vitals {
    align-self: start;
    background: var(--color-surface);
    border: 1px dashed var(--color-accent-strong);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: grid;
    gap: 1.1rem;
  }

  .vital { display: flex; align-items: baseline; gap: 0.6rem; }
  .vital b {
    font-family: var(--font-display);
    font-size: 2.2rem;
    color: var(--color-accent-strong);
    line-height: 1;
  }
  .vital span {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .brief-banner .photo-frame { aspect-ratio: 21 / 8; }

  @media (max-width: 800px) {
    .brief-spread { grid-template-columns: 1fr; }
    .brief-banner .photo-frame { aspect-ratio: 4 / 3; }
  }

  /* ---------- 02 The Route ---------- */
  .route-layout {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .route-map {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transform: scale(0.7);
  }

  .route-map__lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .route-map__base { fill: var(--color-accent-strong); }

  .route-line {
    stroke: var(--color-border);
    stroke-width: 0.4;
    stroke-dasharray: 1.6 1.6;
    transition: stroke var(--duration-base) var(--ease-out), stroke-width var(--duration-base) var(--ease-out);
  }

  .route-line.is-active {
    stroke: var(--color-accent-strong);
    stroke-width: 0.7;
  }

  .route-map__label {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 0.65rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-weight: 600;
  }

  .route-stop {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 26px;
    height: 26px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .route-stop__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid var(--color-accent-strong);
    transition: transform var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out);
  }

  .route-stop:hover .route-stop__dot,
  .route-stop:focus-visible .route-stop__dot,
  .route-stop.is-active .route-stop__dot {
    background: var(--color-accent-strong);
    transform: scale(1.35);
  }

  .route-preview {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    padding: 1.5rem;
  }

  .route-preview__photo { aspect-ratio: 4 / 3; margin-bottom: 1rem; }

  .route-preview__tag {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin: 0 0 0.4rem;
  }

  .route-preview__name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 0.5rem;
    color: var(--color-text);
  }

  .route-preview__teaser {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 0.75rem;
  }

  .route-preview__credit {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    margin: 0 0 1.1rem;
  }
  .route-preview__credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 800px) {
    .route-layout { grid-template-columns: 1fr; }
  }

  /* ---------- 03 The Itinerary ---------- */
  .itinerary-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter-pill {
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.5rem 1.1rem;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .filter-pill:hover { border-color: var(--color-accent-strong); color: var(--color-accent-strong); }

  .filter-pill.is-active {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-bg);
  }

  .program-item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3.5rem 0;
    border-top: 1px solid rgba(58, 35, 28, 0.12);
  }

  .program-item[hidden] { display: none; }

  .program-item:first-of-type { border-top: none; padding-top: 0; }
  .program-item.reverse .program-media { order: 2; }
  .program-item.reverse .program-copy { order: 1; }
  .program-media { position: relative; }
  .program-media .photo-frame { height: 340px; }

  /* Parallax layer: taller than the frame it sits in (overflow: hidden,
     inherited from .photo-frame) so a scroll-scrubbed translateY can drift
     it without ever exposing an edge. Lives on this wrapper rather than
     the <img> itself so it doesn't fight the shared .photo-frame:hover
     scale transform, which still targets the img directly. */
  .program-media__parallax {
    position: absolute;
    top: -15%;
    left: 0;
    width: 100%;
    height: 130%;
  }

  .ticket-stub {
    position: absolute;
    top: 0.9rem;
    left: -0.6rem;
    z-index: 1;
    background: var(--color-bg-alt);
    border: 1px dashed var(--color-accent-strong);
    border-radius: var(--radius-sm);
    color: var(--color-accent-strong);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.3;
    text-align: center;
    padding: 0.35rem 0.55rem;
    transform: rotate(-6deg);
    box-shadow: var(--shadow-sm);
  }

  .program-tag {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin: 0 0 0.6rem 0;
  }

  .tour-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-text);
    margin: 0 0 0.4rem 0;
  }

  .program-copy h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
    color: var(--color-text);
  }

  .program-copy p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 1.25rem 0;
  }

  /* ---------- 04 About Us ---------- */
  .about-block {
    position: relative;
  }

  /* Small square profile photo + name/role caption, centered in normal
     flow below the closing text. */
  .about-profile-block {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 3rem auto 0;
  }

  .about-profile-caption {
    text-align: right;
  }

  .about-profile-name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-earth-900);
    margin: 0;
  }

  .about-profile-role {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0;
  }

  .about-profile {
    flex-shrink: 0;
    width: 330px;
    height: 330px;
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 3px solid var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  .about-profile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 800px) {
    .about-profile-block {
      flex-direction: column-reverse;
      margin-top: 2rem;
    }

    .about-profile-caption {
      text-align: center;
    }
  }

  .about-copy {
    text-align: center;
  }

  .about-copy p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-muted);
    margin: 0 0 1.4rem;
  }

  /* Two-column flow for the long-form body — text fills the left column
     top to bottom, then continues in the right column, so the section
     doesn't force a very long single-column scroll. Collapses back to
     one column on narrow viewports where side-by-side reading columns
     don't work. */
  .about-copy__columns {
    max-width: 64rem;
    margin: 0 auto 2.5rem;
    columns: 2;
    column-gap: 3.5rem;
    column-rule: 1px solid var(--color-border);
  }

  .about-copy__columns > * {
    break-inside: avoid;
  }

  /* The invite line and everything after it stays a single centered
     column, not split across the two above. */
  .about-copy__close {
    max-width: 40rem;
    margin-inline: auto;
  }

  @media (max-width: 800px) {
    .about-copy__columns {
      columns: 1;
      column-rule: none;
      max-width: 40rem;
    }
  }

  .about-copy__lead {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    line-height: 1.4;
    color: var(--color-text);
    margin-bottom: 1.75rem !important;
  }

  .about-copy__pull {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.2rem, 2.2vw, 1.45rem);
    line-height: 1.5;
    color: var(--color-accent-strong);
    margin: 2rem 0 !important;
  }

  .about-copy__list {
    color: var(--color-text);
  }

  .about-copy__invite {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .about-copy__signoff {
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-border);
  }

  .about-copy__signoff-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-earth-900);
    margin: 0 0 0.25rem;
  }

  .about-copy__signoff-tag {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ---------- 06 The Logbook ---------- */
  .logbook-grid {
    columns: 4;
    column-gap: 1rem;
  }

  .logbook-item {
    margin: 0 0 1rem;
    break-inside: avoid;
  }

  .logbook-item:nth-child(3n+1) .photo-frame { aspect-ratio: 3 / 4; }
  .logbook-item:nth-child(3n+2) .photo-frame { aspect-ratio: 1 / 1; }
  .logbook-item:nth-child(3n) .photo-frame { aspect-ratio: 4 / 3; }

  .logbook-item figcaption {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  @media (max-width: 960px) { .logbook-grid { columns: 2; } }
  @media (max-width: 640px) { .logbook-grid { columns: 1; } }

  /* ---------- 05 Passport Stamps ---------- */
  .stamps-block {
    background: var(--color-earth-900);
    background-image: var(--gradient-dusk);
    color: var(--color-text-on-dark);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 8vw, 6rem);
  }

  .stamps-inner { max-width: 700px; margin-inline: auto; text-align: center; }
  .stamps-inner .eyebrow { color: var(--color-ochre-400); }
  .stamps-inner .section-title { color: var(--color-text-on-dark); margin-inline: auto; margin-bottom: 2.5rem; }

  .stamps-row {
    display: flex;
    justify-content: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    flex-wrap: wrap;
  }

  .stamp {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    border: 2px dashed var(--color-ochre-400);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .stamp b {
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    color: var(--color-text-on-dark);
    font-variant-numeric: tabular-nums;
  }

  .stamp span {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-sand-200);
    margin-top: 0.3rem;
  }

  /* ---------- 08 Postcards ---------- */
  .postcards-block {
    position: relative;
    z-index: 0;
    overflow: hidden;
  }

  /* Hikers with backpacks, heavily blurred so it reads as ambient
     texture rather than a competing photo behind the review cards.
     Oversized (inset beyond the section's own edges) so the blur's
     soft fringe never shows at the boundary — the parent's
