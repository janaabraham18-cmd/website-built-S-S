        }
      </div>
    </div>
  </section>

  <!-- ============ 07 · POSTCARDS FROM THE ROAD ============ -->
  <section class="block postcards-block reveal" id="postcards">
    <div class="postcards-block__bg" data-postcards-bg aria-hidden="true"></div>
    <p class="eyebrow">Postcards from the Road</p>
    <h2 class="section-title">What guests say</h2>

    <div class="postcards reveal-item" data-postcards>
      <div class="postcards__stack">
        {
          testimonials.map((t, i) => (
            <article class:list={['postcard', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
              <div class="postcard__rating" aria-label={`Rated ${t.rating} out of 5 stars`}>
