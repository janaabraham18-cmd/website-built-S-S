---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import AboutCarousel from '../components/AboutCarousel.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
import AdventureCard from '../components/AdventureCard.astro';
import { tours } from '../data/tours';

const teaserSlugs = [
  'etosha-tour',
  'sossusvlei-tour',
  'sandwich-harbour-full-day',
  'quad-bike-tour',
  'dolphin-seal-catamaran-cruise',
  'tandem-skydive',
];
const teaserTours = teaserSlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const adventureSlugs = [
  'paragliding',
  'camel-ride',
  'sandboarding',
  'kayaking',
  'living-desert-tour',
  'township-tour',
  'fat-bike-tour',
  'cape-cross',
];
const adventureTours = adventureSlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const gallerySlugs = [
  'pelican-point-tour',
  'explorer-tour',
  'special-quad-90min',
  'sandwich-harbour-half-day',
  'fishing',
  'moonlandscape-tour',
  'surf-and-turf',
  'kayak-catamaran-combo',
];
const galleryTours = gallerySlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const heroPanels = [
  {
    letter: 'N',
    alt: 'A herd of desert-adapted elephants walking along a dry riverbed in Namibia',
    imageUrl:
      'https://images.unsplash.com/photo-1667389861341-3f1c749cdf39?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Elina Palm', username: 'drawmeasun' },
  },
  {
    letter: 'A',
    alt: 'A lone oryx crossing the Namib desert plain',
    imageUrl:
      'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Arthur Souquet', username: 'arthursouquet' },
  },
  {
    letter: 'M',
    alt: 'Flamingos wading in the shallow waters of Walvis Bay',
    imageUrl:
      'https://images.unsplash.com/photo-1669805508900-d3eaed6e6c14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Vladimir Oprisko', username: 'captoprisko' },
  },
  {
    letter: 'I',
    alt: 'A Cape fur seal resting on the Namibian coast',
    imageUrl:
      'https://images.unsplash.com/photo-1772290226248-156cc5fe4f9b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    letter: 'B',
    alt: 'A cheetah in the Namibian bush',
    imageUrl:
      'https://images.unsplash.com/photo-1696894132788-d0b1af4c95a7?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Taylor Wright', username: 'taylorwright22' },
  },
  {
    letter: 'I',
    alt: 'Two zebras on the plains of Etosha National Park',
    imageUrl:
      'https://images.unsplash.com/photo-1579172342894-e6d751ec390c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Geranimo', username: 'geraninmo' },
  },
  {
    letter: 'A',
    alt: 'Towering red sand dunes under a clear sky near Sossusvlei',
    imageUrl:
      'https://images.unsplash.com/photo-1613155358201-36bcf3ce695e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Mareike Kramper', username: 'mareike_capetown' },
  },
];

const tourCount = tours.filter((tour) => tour.category === 'tour').length;
const adventureCount = tours.filter((tour) => tour.category === 'adventure').length;
const comboCount = tours.filter((tour) => tour.category === 'combo').length;

const whyUsFeatures = [
  {
    title: 'Based right in Swakopmund',
    description:
      "No call center, no middleman — every tour starts close to home in Swakopmund and Walvis Bay.",
    icon: 'compass' as const,
  },
  {
    title: 'Desert and ocean, one lineup',
    description:
      "From the red dunes of Sossusvlei to the seal colonies of Pelican Point — few operators cover both ends of Namibia's landscape.",
    icon: 'leaf' as const,
  },
  {
    title: `${tourCount + adventureCount + comboCount} ways to mix and match`,
    description: `${tourCount} signature tours, ${adventureCount} adventures, and ${comboCount} combo deals — pair a quad bike ride with a catamaran cruise, or build your own day.`,
    icon: 'users' as const,
  },
  {
    title: 'Guides who know the ground',
    description:
      'Hands-on local guides who know the dunes and the coastline — not a script read from a clipboard.',
    icon: 'shield' as const,
  },
];
---

<BaseLayout
  title="Home"
  description="Desert and coastal tours from Swakopmund and Walvis Bay, Namibia — Etosha, Sossusvlei, Skeleton Coast, and more with Salt & Sun Tours."
>
  <Hero
    title="Namibia"
    eyebrow="Salt & Sun Tours"
    subhead="Desert and coastal adventures out of Swakopmund and Walvis Bay — from towering red dunes to seal colonies at Pelican Point."
    ctaLabel="Explore our tours"
    ctaHref="/tours"
    panels={heroPanels}
  />

  <div id="scroll-target"></div>

  <AboutCarousel />

  <WhyUsSection features={whyUsFeatures} />

  <Section
    eyebrow="Featured destination"
    heading="Sandwich Harbour"
    theme="photo"
    align="left"
    pin
    imageUrl="https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1920"
    imageCredit={{ name: 'Joshua Kettle', username: 'joshuakettle' }}
  >
    <p>
      Where towering dunes plunge straight into the Atlantic — a 4x4 run past
      salt pans and flamingo-filled lagoons to Namibia's most photographed
      meeting of desert and ocean.
    </p>
    <a class="btn btn-outline" href="/tours#tour">Explore this tour</a>
  </Section>

  <section class="tours-teaser reveal">
    <div class="container tours-teaser__intro reveal-item">
      <p class="tours-teaser__eyebrow">Our offering</p>
      <h2>A few of our tours</h2>
      <p class="tours-teaser__body">
        A sample of what we run out of Swakopmund and Walvis Bay — see
        the full lineup, including every adventure and combo deal, on
        the tours page.
      </p>
    </div>

    <div class="tours-teaser__pin">
      <div class="tours-teaser__track">
        {
          teaserTours.map((tour) => (
            <div class="tours-teaser__item">
              <AdventureCard tour={tour} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="container tours-teaser__cta reveal-item">
      <a class="btn btn-outline" href="/tours">View all tours</a>
    </div>
  </section>

  <!-- Field notes: stats + trust merged into one "travel document" strip —
       a dark beat between two long cream stretches, styled like a
       boarding-pass counterfoil rather than another card grid. -->
  <section class="field-notes reveal">
    <div class="container field-notes__inner">
      <div class="field-notes__intro reveal-item">
        <p class="field-notes__eyebrow">Why travelers choose us</p>
        <h2>Straight answers from people who know the ground</h2>
      </div>

      <div class="field-notes__ledger">
        <div class="field-notes__stats reveal-item">
          <div class="field-notes__stat">
            <span class="field-notes__number">{tourCount}</span>
            <span class="field-notes__label">Signature tours</span>
          </div>
          <div class="field-notes__stat">
            <span class="field-notes__number">{adventureCount}</span>
            <span class="field-notes__label">Adventures</span>
          </div>
          <div class="field-notes__stat">
            <span class="field-notes__number">{comboCount}</span>
            <span class="field-notes__label">Combo deals</span>
          </div>
          <div class="field-notes__stat">
            <span class="field-notes__number">2</span>
            <span class="field-notes__label">Home bases</span>
          </div>
        </div>

        <div class="field-notes__divider" aria-hidden="true"></div>

        <ul class="field-notes__points reveal-item">
          <li>
            <strong>Local, not outsourced.</strong> Every tour starts and
            ends in Swakopmund or Walvis Bay, run by the same small team
            from your first message to the final drop-off.
          </li>
          <li>
            <strong>Built for how you want to travel.</strong> {tourCount + adventureCount + comboCount} tours,
            adventures, and combo deals — from a 30-minute quad ride to a
            full day in Etosha, mixed and matched to your trip.
          </li>
          <li>
            <strong>A straight answer, fast.</strong> No call center.
            Reach out and you'll hear back from someone who actually
            knows the dunes and the coastline.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="homepage-adventures reveal">
    <div class="container homepage-adventures__intro reveal-item">
      <p class="homepage-adventures__eyebrow">Beyond the tours</p>
      <h2>More ways to spend a day</h2>
      <p class="homepage-adventures__body">
        Shorter, activity-based excursions around Swakopmund and Walvis
        Bay — the full lineup, including every combo deal, is on the
        tours page.
      </p>
    </div>

    <div class="container homepage-adventures__grid">
      {adventureTours.map((tour, i) => <AdventureCard tour={tour} featured={i === 0} />)}
    </div>

    <div class="container homepage-adventures__cta reveal-item">
      <a class="btn btn-outline" href="/tours#adventure">See every adventure</a>
    </div>
  </section>

  <!-- Pull-quote: a pure-typography beat between two photo grids — the
       rest of the homepage leans on photo+scrim for every moment of
       visual interest, so this is the one section that's just color
       and type, straight from Lenga's letter. -->
  <section class="pull-quote reveal">
    <div class="container-narrow pull-quote__inner reveal-item">
      <p class="pull-quote__mark" aria-hidden="true">&ldquo;</p>
      <blockquote class="pull-quote__text">
        Somewhere between the desert and the stars, you will discover
        that the greatest destination was never a place — it was
        becoming who you were created to be.
      </blockquote>
      <p class="pull-quote__attribution">— Lenga, Founder</p>
    </div>
  </section>

  <section class="gallery reveal">
    <div class="container gallery__intro reveal-item">
      <p class="gallery__eyebrow">A few more moments</p>
      <h2>Namibia, in passing</h2>
    </div>

    <div class="container gallery__board">
      {
        galleryTours.map((tour, i) => (
          <figure
            class:list={['gallery__pin', i % 2 === 0 ? 'gallery__pin--l' : 'gallery__pin--r']}
            data-gallery-pin
          >
            {tour.imageUrl && (
              <span class="polaroid-frame">
                <img src={tour.imageUrl} alt={tour.name} loading="lazy" decoding="async" />
              </span>
            )}
            <figcaption class="polaroid-caption">{tour.name}</figcaption>
            {tour.imageCredit && (
              <p class="gallery__credit">
                Photo:{' '}
                <a
                  href={`https://unsplash.com/@${tour.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tour.imageCredit.name}
                </a>{' '}
                /{' '}
                <a
                  href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Unsplash
                </a>
              </p>
            )}
          </figure>
        ))
      }
    </div>
  </section>

  <Section
    eyebrow="Ready when you are"
    heading="Plan your journey"
    align="center"
  >
    <p>
      Ready to see the dunes, the coastline, and everything in between?
      Get in touch and we'll help you build the right day — or days —
      around Swakopmund and Walvis Bay.
    </p>
    <a class="btn btn-primary" href="/booking">Start booking</a>
  </Section>
</BaseLayout>

<style>
  .tours-teaser {
    /* Generous top space specifically: the section right above this one
       (Skeleton Coast) is itself a pinned/scrubbed scroll effect, and the
       cards below are a second one (see setupToursTeaserSlide()). Without
       real breathing room here the two scroll-jacked moments run straight
       into each other with no normal scrolling in between. */
    padding-block: clamp(6rem, 14vw, 11rem) var(--space-2xl);
  }

  .tours-teaser__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-2xl);
  }

  .tours-teaser__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .tours-teaser__body {
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Edge-to-edge horizontal slider. Base state is a plain scrollable row
     (works with no JS, under reduced motion, and on touch/mobile); the
     motion controller upgrades it to a scroll-pinned slide on desktop
     when the visitor hasn't asked for reduced motion — see
     setupToursTeaserSlide() in scripts/motion.ts. */
  .tours-teaser__pin {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .tours-teaser__pin::-webkit-scrollbar {
    display: none;
  }

  .tours-teaser__pin--pinned {
    overflow: hidden;
  }

  .tours-teaser__track {
    display: flex;
    gap: var(--space-lg);
    width: max-content;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    scroll-snap-type: x proximity;
    will-change: transform;
  }

  .tours-teaser__pin--pinned .tours-teaser__track {
    scroll-snap-type: none;
  }

  .tours-teaser__item {
    flex: 0 0 min(78vw, 380px);
    height: 420px;
    scroll-snap-align: start;
  }

  .tours-teaser__item :global(.adventure-card) {
    width: 100%;
    height: 100%;
  }

  .tours-teaser__cta {
    text-align: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 640px) {
    .tours-teaser__item {
      height: 340px;
    }
  }

  /* ---------- Field notes (stats + trust, merged into one dark beat) ---------- */
  .field-notes {
    padding-block: var(--space-2xl);
    background: var(--color-earth-900);
    color: var(--color-text-on-dark);
    position: relative;
  }

  /* Perforated edges, like a torn ticket counterfoil, instead of a hard
     rectangular color-block cut against the cream sections above/below. */
  .field-notes::before,
  .field-notes::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(251, 247, 241, 0.35) 0 10px,
      transparent 10px 20px
    );
  }

  .field-notes::before {
    top: 0;
  }

  .field-notes::after {
    bottom: 0;
  }

  .field-notes__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .field-notes__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin-bottom: var(--space-2xs);
  }

  .field-notes__intro h2 {
    margin: 0;
    color: var(--color-text-on-dark);
  }

  .field-notes__ledger {
    display: grid;
    grid-template-columns: 1fr auto 1.2fr;
    align-items: center;
    gap: var(--space-xl);
    max-width: var(--content-width);
    margin-inline: auto;
  }

  .field-notes__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg) var(--space-md);
  }

  .field-notes__stat {
    display: flex;
    flex-direction: column;
  }

  .field-notes__number {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    color: var(--color-ochre-400);
    line-height: 1;
  }

  .field-notes__label {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-sand-200);
    margin-top: var(--space-3xs);
  }

  .field-notes__divider {
    width: 1px;
    align-self: stretch;
    background-image: repeating-linear-gradient(
      180deg,
      rgba(251, 247, 241, 0.35) 0 8px,
      transparent 8px 16px
    );
  }

  .field-notes__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-md);
  }

  .field-notes__points li {
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-sand-100);
  }

  .field-notes__points strong {
    color: var(--color-text-on-dark);
  }

  @media (max-width: 860px) {
    .field-notes__ledger {
      grid-template-columns: 1fr;
    }

    .field-notes__divider {
      width: auto;
      height: 1px;
      background-image: repeating-linear-gradient(
        90deg,
        rgba(251, 247, 241, 0.35) 0 8px,
        transparent 8px 16px
      );
    }

    .field-notes__stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 560px) {
    .field-notes__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ---------- Pull quote ---------- */
  .pull-quote {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .pull-quote__inner {
    text-align: center;
  }

  .pull-quote__mark {
    font-family: var(--font-display-italic);
    font-size: 5rem;
    line-height: 1;
    color: var(--color-accent-soft);
    margin: 0 0 -1rem;
  }

  .pull-quote__text {
    margin: 0 0 var(--space-md);
    font-family: var(--font-display-italic);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: var(--lh-snug);
    color: var(--color-earth-900);
  }

  .pull-quote__attribution {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
  }

  /* ---------- Homepage adventures grid ---------- */
  .homepage-adventures {
    padding-block: var(--space-2xl);
  }

  .homepage-adventures__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .homepage-adventures__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .homepage-adventures__body {
    color: var(--color-text-muted);
    margin: 0;
  }

  .homepage-adventures__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 240px;
    grid-auto-flow: dense;
    gap: var(--space-md);
  }

  /* Hover tilt — see setupAdventureTilt() in scripts/motion.ts, which
     drives the rotate/scale transform itself; this just handles the
     shadow lift and keeps the tilted card above its neighbors. */
  .homepage-adventures__grid :global(.adventure-card) {
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .homepage-adventures__grid :global(.adventure-card.is-tilting) {
    box-shadow: var(--shadow-lg);
    z-index: 1;
  }

  .homepage-adventures__cta {
    text-align: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 960px) {
    .homepage-adventures__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .homepage-adventures__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Gallery ---------- */
  .gallery {
    padding-block: var(--space-2xl);
  }

  .gallery__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .gallery__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  /* Corkboard-of-polaroids instead of a flat masonry grid — pins the
     About Us carousel's polaroid language onto the rest of the site so
     the repeated photo+gradient-scrim card isn't the only visual idea
     the homepage has. Alternating rows offset vertically and each pin
     rotates a few degrees so it reads as pinned-up snapshots, not a
     component grid. */
  .gallery__board {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xl) var(--space-lg);
    max-width: 1000px;
    margin-inline: auto;
    padding-block: var(--space-sm) var(--space-lg);
  }

  .gallery__pin {
    width: clamp(180px, 22vw, 230px);
    margin: 0;
  }

  .gallery__pin--l .polaroid-frame {
    transform: rotate(-4deg);
  }

  .gallery__pin--r .polaroid-frame {
    transform: rotate(3deg);
  }

  .gallery__pin:nth-child(3n) {
    margin-top: var(--space-lg);
  }

  .gallery__pin .polaroid-frame img {
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .gallery__credit {
    margin: var(--space-3xs) 0 0;
    font-size: 0.65rem;
    text-align: center;
    color: var(--color-text-muted);
  }

  .gallery__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .gallery__pin {
      width: clamp(140px, 38vw, 180px);
    }

    .gallery__pin:nth-child(3n) {
      margin-top: 0;
    }
  }
</style>
