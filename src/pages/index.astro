                  {story.imageCredit.name}
                </a>{' '}
                /{' '}
                <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">
                  Unsplash
                </a>
