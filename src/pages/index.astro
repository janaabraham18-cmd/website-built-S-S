      </div>
      <div class="postcards__controls">
        <button type="button" class="postcards__arrow" data-postcard-prev aria-label="Previous postcard">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <p class="postcards__counter"><span data-postcard-current>1</span> / {testimonials.length}</p>
        <button type="button" class="postcards__arrow" data-postcard-next aria-label="Next postcard">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---------- Section shell ---------- */
  .block {
    background: var(--color-surface);
    color: var(--color-text);
    padding: clamp(3.5rem, 8vw, 6.25rem) clamp(1.25rem, 8vw, 6rem);
  }

  /* background-color only (not the `background` shorthand) — a shorthand
     here would silently reset background-image back to none at ID-level
     specificity, beating the lower-specificity .home-band glow rule
     below regardless of source order. */
  #home-adventures { background-color: var(--color-bg-alt); }

  /* ---------- Desert Light: per-section glows ----------
     Soft, warm glow layered on top of the background colors above
     rather than replacing them. Placed after .block/#home-adventures
     so these longhand background-image declarations win at equal
     specificity. */
  .home-band {
    background-image: var(--gradient-glow-warm);
  }

  .logbook-block {
    background-image: var(--gradient-glow-wild);
  }

  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0 0 3.75rem 0;
    color: var(--color-text);
    max-width: 700px;
  }

  /* ---------- 01-03 Tours / Adventures / Journeys bands ----------
     Three parallel sections, each doing the same job for one product
     line — a short intro plus a handful of real entries that lead
     straight to that product's own page, rather than one abstract brand
     section followed by a map gimmick. One shared card pattern
     (HomeTeaserCard) across all three, so the repetition itself reads
     as "here are the three things we do." */
  .home-band__intro {
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: -2.75rem 0 2.75rem;
  }

  .home-band__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-lg);
    margin-bottom: 2.5rem;
  }

  @media (max-width: 700px) {
    .home-band__grid { grid-template-columns: repeat(2, 1fr); gap: var(--space-md); }
  }

  @media (max-width: 480px) {
    .home-band__grid { grid-template-columns: 1fr; }
  }

  /* ---------- 04 About Us ---------- */
  /* A real Namibia dune photo behind the whole section, shown "fully
     defined" (full strength, no scrim — same treatment as booking/
     contact): the heading gets its own small opaque card and the
     founder photo + bio card are already opaque, so only the caption
     under the photo needs a text-shadow to stay legible over the
     photo directly. The photo + card pin in place while the visitor
     scrolls past (see setupAboutCard in motion.ts) and the 3 bio pages
     crossfade in step with that scroll — arrows still work too, and
     under reduced motion the pin/scroll-tie drops entirely, leaving
     the arrows as the only way through. */
  .about-block {
    position: relative;
    z-index: 0;
    overflow: hidden;
    background-color: var(--color-earth-700);
  }

  .about-block__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
  }

  .about-block__intro {
    display: inline-block;
    background: rgba(58, 35, 28, 0.72);
    border-radius: var(--radius-lg);
    padding: var(--space-md) var(--space-lg);
    box-shadow: var(--shadow-lg);
    margin-bottom: var(--space-xl);
  }

  .about-block__intro .eyebrow {
    color: var(--color-ochre-400);
    margin-bottom: 0.4rem;
  }

  .about-block__intro .section-title {
    color: var(--color-text-on-dark);
    margin: 0;
  }

  .about-block__credit {
    position: relative;
    z-index: 1;
    margin: var(--space-md) 0 0;
    text-align: right;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .about-block__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about-layout {
    display: grid;
    grid-template-columns: minmax(200px, 260px) 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .about-photo__frame {
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 3px solid var(--color-surface);
  }

  .about-photo__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .about-photo__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text-on-dark);
    text-shadow: 0 1px 8px rgba(31, 18, 14, 0.6);
    margin: 0.85rem 0 0;
  }

  .about-photo__role {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-sand-200);
    text-shadow: 0 1px 8px rgba(31, 18, 14, 0.6);
    margin: 0.15rem 0 0;
  }

  .about-card {
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  /* Every page occupies the same grid cell (stacked, not stacked in
     document flow) so the card's height is set once, by the tallest
     page, and never changes as pages swap — required for the scroll
     pin above to stay stable; swapping "active" page is a pure opacity
     crossfade, nothing reflows. */
  .about-card__pages {
    display: grid;
  }

  .about-card__page {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .about-card__page.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .about-card__page p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin: 0 0 1.1rem;
  }

  .about-card__page p:last-child {
    margin-bottom: 0;
  }

  .about-copy__lead {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    line-height: 1.4;
    color: var(--color-text);
    margin-bottom: 1.25rem !important;
  }

  .about-copy__pull {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--color-accent-strong);
    margin: 1.5rem 0 !important;
  }

  .about-copy__list {
    color: var(--color-text);
  }

  .about-copy__invite {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .about-copy__signoff {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
  }

  .about-copy__signoff-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--color-text);
    margin: 0 0 0.25rem;
  }

  .about-copy__signoff-tag {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Same prev/counter/next pattern as the Postcards testimonial carousel
     elsewhere on this page, just its own instance/selectors since this
     card paginates prose, not photo cards. */
  .about-card__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.25rem;
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .about-card__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-accent-strong);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .about-card__arrow:hover {
    background: var(--color-accent);
    color: var(--color-text-on-dark);
    transform: scale(1.06);
  }

  .about-card__arrow svg {
    width: 1rem;
    height: 1rem;
  }

  .about-card__counter {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  @media (max-width: 760px) {
    .about-layout {
      grid-template-columns: 1fr;
    }

    .about-photo {
      position: static;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .about-photo__frame {
      width: 96px;
      height: 96px;
      flex-shrink: 0;
    }

    .about-photo__name,
    .about-photo__role {
      margin: 0;
    }
  }

  /* ---------- 06 The Logbook ----------
     Plain "Desert Light" treatment matching the rest of the site: full-
     colour photos in a rounded, shadowed frame, no ink rules or newsprint
     texture. Motion lives in setupLogbookSlideshow() in motion.ts. */
  .logbook-block {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }

  .logbook-masthead {
    position: relative;
    max-width: var(--content-width-narrow);
    margin: 0 auto var(--space-lg);
    text-align: center;
  }

  .logbook-masthead__dek {
    margin: var(--space-sm) 0 0;
    font-size: var(--fs-md);
    color: var(--color-text-muted);
  }

  .logbook-slideshow {
    position: relative;
    display: grid;
    grid-template-columns: minmax(200px, 280px) 1fr;
    gap: var(--space-lg);
    align-items: start;
  }

  /* ---- Photo stage: one filmstrip track, all 8 slides side by side.
     JS translates the track by whole slide-widths so the incoming
     photo visibly slides in from the side; see setupLogbookSlideshow().
     Capped to a fixed width range (not a percentage of the column) so
     it stays a compact frame beside the article rather than scaling up
     to fill however wide the section happens to be. */
  .logbook-stage {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 360px;
    overflow: hidden;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    background: var(--color-earth-900);
  }

  .logbook-stage__track {
    display: flex;
    width: 800%;
    height: 100%;
  }

  .logbook-stage__slide {
    flex: 0 0 12.5%;
    height: 100%;
    margin: 0;
  }

  .logbook-stage__slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .logbook-stage__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 2.8rem;
    height: 2.8rem;
    border: none;
    border-radius: 50%;
    background: rgba(58, 35, 28, 0.55);
    color: var(--color-text-on-dark);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: background-color 0.2s ease;
  }

  .logbook-stage__nav:hover {
    background: rgba(58, 35, 28, 0.8);
  }

  .logbook-stage__nav--prev {
    left: var(--space-sm);
  }

  .logbook-stage__nav--next {
    right: var(--space-sm);
  }

  .logbook-stage__counter {
    position: absolute;
    bottom: var(--space-sm);
    right: var(--space-sm);
    margin: 0;
    padding: 0.25em 0.7em;
    border-radius: var(--radius-sm);
    background: rgba(58, 35, 28, 0.55);
    color: var(--color-text-on-dark);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  /* ---- Article panel: all 8 articles are in the DOM (no-JS/SEO
     fallback shows the first one); JS toggles which is visible so the
     text swap isn't tied to the photo's slide animation. */
  .logbook-article__entry {
    display: none;
  }

  /* No-JS fallback: show the first article. Once JS is running, .is-active
     is the source of truth — the :not() rule below lets it override this
     default the moment the first entry is navigated away from. */
  .logbook-article__entry:first-child {
    display: block;
  }

  .logbook-article__entry.is-active {
    display: block;
  }

  .logbook-article__entry:first-child:not(.is-active) {
    display: none;
  }

  .logbook-article__kicker {
    display: inline-block;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0 0 var(--space-xs);
  }

  .logbook-article__headline {
    font-size: var(--fs-2xl);
    line-height: 1.1;
    margin: 0 0 var(--space-sm);
  }

  .logbook-article__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: var(--fs-md);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .logbook-article__body p {
    margin: 0;
  }

  .logbook-article__credit {
    margin: var(--space-md) 0 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .logbook-article__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 800px) {
    .logbook-slideshow {
      grid-template-columns: 1fr;
    }

    .logbook-stage {
      aspect-ratio: 16 / 10;
      max-height: 260px;
    }

    .logbook-article__headline {
      font-size: var(--fs-xl);
    }
  }

  /* ---------- 05 Our Fleet ---------- */
  .stamps-block {
    background: var(--color-earth-900);
    background-image: var(--gradient-dusk);
    color: var(--color-text-on-dark);
    padding: clamp(3rem, 7vw, 5rem) clamp(1.25rem, 8vw, 6rem);
  }

  .stamps-inner { max-width: 960px; margin-inline: auto; text-align: center; }
  .stamps-inner .eyebrow { color: var(--color-ochre-400); }
  .stamps-inner .section-title { color: var(--color-text-on-dark); margin-inline: auto; margin-bottom: 2.5rem; }

  .fleet-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
