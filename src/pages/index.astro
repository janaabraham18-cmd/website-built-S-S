  .faq-more a { color: var(--color-accent-strong); font-weight: 600; }

  @media (max-width: 800px) {
    .program-item { grid-template-columns: 1fr; }
    .program-item.reverse .program-media,
    .program-item.reverse .program-copy {
      order: initial;
    }
    .section-title { font-size: 1.875rem; }
  }

  /* ---------- Closing CTA card ---------- */
  .cta-card {
    max-width: 34rem;
    margin-inline: auto;
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    background: rgba(251, 247, 241, 0.12);
    backdrop-filter: blur(8px);
