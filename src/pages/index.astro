---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
import AdventureCard from '../components/AdventureCard.astro';
import { tours } from '../data/tours';

const teaserSlugs = [
  'etosha-tour',
  'sossusvlei-tour',
  'sandwich-harbour-full-day',
  'quad-bike-tour',
  'dolphin-seal-catamaran-cruise',
  'tandem-skydive',
];
const teaserTours = teaserSlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const adventureSlugs = [
  'paragliding',
  'camel-ride',
  'sandboarding',
  'kayaking',
  'living-desert-tour',
  'township-tour',
  'fat-bike-tour',
  'cape-cross',
];
const adventureTours = adventureSlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const gallerySlugs = [
  'pelican-point-tour',
  'explorer-tour',
  'special-quad-90min',
  'sandwich-harbour-half-day',
  'fishing',
  'moonlandscape-tour',
  'surf-and-turf',
  'kayak-catamaran-combo',
];
const galleryTours = gallerySlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const heroPanels = [
  {
    letter: 'N',
    alt: 'A herd of desert-adapted elephants walking along a dry riverbed in Namibia',
    imageUrl:
      'https://images.unsplash.com/photo-1667389861341-3f1c749cdf39?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Elina Palm', username: 'drawmeasun' },
  },
  {
    letter: 'A',
    alt: 'A lone oryx crossing the Namib desert plain',
    imageUrl:
      'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Arthur Souquet', username: 'arthursouquet' },
  },
  {
    letter: 'M',
    alt: 'Flamingos wading in the shallow waters of Walvis Bay',
    imageUrl:
      'https://images.unsplash.com/photo-1669805508900-d3eaed6e6c14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Vladimir Oprisko', username: 'captoprisko' },
  },
  {
    letter: 'I',
    alt: 'A Cape fur seal resting on the Namibian coast',
    imageUrl:
      'https://images.unsplash.com/photo-1772290226248-156cc5fe4f9b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    letter: 'B',
    alt: 'A cheetah in the Namibian bush',
    imageUrl:
      'https://images.unsplash.com/photo-1696894132788-d0b1af4c95a7?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Taylor Wright', username: 'taylorwright22' },
  },
  {
    letter: 'I',
    alt: 'Two zebras on the plains of Etosha National Park',
    imageUrl:
      'https://images.unsplash.com/photo-1579172342894-e6d751ec390c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Geranimo', username: 'geraninmo' },
  },
  {
    letter: 'A',
    alt: 'Towering red sand dunes under a clear sky near Sossusvlei',
    imageUrl:
      'https://images.unsplash.com/photo-1613155358201-36bcf3ce695e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Mareike Kramper', username: 'mareike_capetown' },
  },
];

const tourCount = tours.filter((tour) => tour.category === 'tour').length;
const adventureCount = tours.filter((tour) => tour.category === 'adventure').length;
const comboCount = tours.filter((tour) => tour.category === 'combo').length;

// Reuses three tours' own already-credited photos rather than sourcing
// new ones, since each is a genuine, strong shot of exactly the
// landscape it's labeling here.
const whereWeGoPanels = [
  { label: 'Desert', copy: 'Placeholder copy: towering red dunes and the salt-white floor of Deadvlei.', slug: 'sossusvlei-tour' },
  { label: 'Coast', copy: "Placeholder copy: shipwrecks, seal colonies, and Namibia's wild Atlantic edge.", slug: 'skeleton-coast-tour' },
  { label: 'Etosha', copy: 'Placeholder copy: elephants, lions, and wide-open pans teeming with wildlife.', slug: 'etosha-tour' },
]
  .map(({ label, copy, slug }) => ({ label, copy, tour: tours.find((t) => t.slug === slug) }))
  .filter((p): p is { label: string; copy: string; tour: NonNullable<typeof p.tour> } => !!p.tour);

const whyUsFeatures = [
  {
    title: 'Based right in Swakopmund',
    description:
      "No call center, no middleman — every tour starts close to home in Swakopmund and Walvis Bay.",
    icon: 'compass' as const,
  },
  {
    title: 'Desert and ocean, one lineup',
    description:
      "From the red dunes of Sossusvlei to the seal colonies of Pelican Point — few operators cover both ends of Namibia's landscape.",
    icon: 'leaf' as const,
  },
  {
    title: `${tourCount + adventureCount + comboCount} ways to mix and match`,
    description: `${tourCount} signature tours, ${adventureCount} adventures, and ${comboCount} combo deals — pair a quad bike ride with a catamaran cruise, or build your own day.`,
    icon: 'users' as const,
  },
  {
    title: 'Guides who know the ground',
    description:
      'Hands-on local guides who know the dunes and the coastline — not a script read from a clipboard.',
    icon: 'shield' as const,
  },
];

// Fresh photography for sections that had none — each sourced separately
// from every other photo already used on the page.
const statsPhoto = {
  imageUrl:
    'https://images.unsplash.com/photo-1637336659714-50c42464957a?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
  alt: 'A dirt road stretching toward distant desert mountains in Namibia',
  credit: { name: 'katsuma tanaka', username: 'kt2080' },
};

const howItWorksPhotos = [
  {
    imageUrl:
      'https://images.unsplash.com/photo-1639402477646-e88e811eef21?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1200',
    alt: 'An empty desert road stretching into the distance in Namibia',
    credit: { name: 'Andrew Svk', username: 'andrew_svk' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1772289093693-60c4de650e65?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1200',
    alt: 'A safari vehicle driving through the Namibian desert',
    credit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1592654365893-6f803cdb4913?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1200',
    alt: 'Coastal buildings by the harbor',
    credit: { name: 'Grant Durr', username: 'grant_durr' },
  },
];

const testimonialsPhoto = {
  imageUrl:
    'https://images.unsplash.com/photo-1511988617509-a57c8a288659?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
  alt: 'A group of friends laughing together outdoors',
  credit: { name: 'Helena Lopes', username: 'helenalopesph' },
};

const closingCtaPhoto = {
  imageUrl:
    'https://images.unsplash.com/photo-1783679603167-4d6650f3cbd3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
  credit: { name: 'GILLES GORLIER', username: 'gorlig_38' },
};

// About section: one wide full-bleed photo beneath the centered intro copy.
const aboutPhoto = {
  imageUrl:
    'https://images.unsplash.com/photo-1645500664580-63a1c2ab5f56?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2000',
  alt: 'A wide panorama of the Kalahari desert at sunset',
  credit: { name: 'Bernd Dittrich', username: 'hdbernd' },
};

// Philosophy section: a loose constellation of circular photo cutouts,
// each sourced separately from every other photo used on the page.
const philosophyPhotos = [
  {
    imageUrl:
      'https://images.unsplash.com/photo-1545200381-89c298dea43d?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600',
    alt: 'Trees and mountains under a wide Namibian sky',
    credit: { name: 'Alan J. Hendry', username: 'imedianamibia' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1611874156894-894081702a14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600',
    alt: 'A brown desert mountain under a blue sky',
    credit: { name: 'Erik', username: 'brmr' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1639403169804-318fcb1d23ad?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600',
    alt: 'A cluster of trees in the Namib desert',
    credit: { name: 'Andrew Svk', username: 'andrew_svk' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1644560781436-df5e5208bc13?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600',
    alt: "Dead trees standing in Deadvlei's dry salt pan",
    credit: { name: 'Bernd Dittrich', username: 'hdbernd' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1592136374773-71c09ea0fe25?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600',
    alt: 'A silhouette standing on desert sand under a starry sky',
    credit: { name: 'Howen', username: 'oweni' },
  },
  {
    imageUrl:
      'https://images.unsplash.com/photo-1607646710453-8655ed8a41b9?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=600',
    alt: 'Ocean waves crashing on a rocky coastline',
    credit: { name: 'Valkyrie Pierce', username: 'valkyriepierce' },
  },
];

// Placeholder reviews for the testimonials carousel — same four quotes as
// before, now driving a one-at-a-time carousel instead of a static grid.
const testimonials = [
  {
    quote:
      "Placeholder quote — swap in a real review. Planning was easy and our guide clearly knew the desert inside out.",
    name: 'Placeholder Name',
    trip: 'Sossusvlei Tour',
  },
  {
    quote:
      "Placeholder quote — swap in a real review. We saw more wildlife in one day than we expected for the whole trip.",
    name: 'Placeholder Name',
    trip: 'Etosha Tour',
  },
  {
    quote:
      "Placeholder quote — swap in a real review. Dolphins right next to the boat, and the crew made the whole morning fun.",
    name: 'Placeholder Name',
    trip: 'Dolphin & Seal Catamaran Cruise',
  },
  {
    quote:
      "Placeholder quote — swap in a real review. Fast, friendly, and no hard sell — just a great day on the dunes.",
    name: 'Placeholder Name',
    trip: 'Quad Bike Tour',
  },
];
---

<BaseLayout
  title="Home"
  description="Desert and coastal tours from Swakopmund and Walvis Bay, Namibia — Etosha, Sossusvlei, Skeleton Coast, and more with Salt & Sun Tours."
>
  <Hero
    title="Namibia"
    eyebrow="Salt & Sun Tours"
    subhead="Desert and coastal adventures out of Swakopmund and Walvis Bay — from towering red dunes to seal colonies at Pelican Point."
    ctaLabel="Explore our tours"
    ctaHref="/tours"
    panels={heroPanels}
  />

  <div id="scroll-target"></div>

  <section class="about reveal">
    <div class="container about__intro reveal-item">
      <p class="about__eyebrow">About us</p>
      <h2>Placeholder heading about who we are</h2>
      <p class="about__body">
        Placeholder copy — swap in the real story here. Salt &amp; Sun
        Tours is a small, Swakopmund-based team who grew up on this
        coastline and still lead most tours personally, from your first
        message through to the drop-off at the end of the day.
      </p>
    </div>

    <div class="about__photo-wrap reveal-item">
      <img
        class="about__photo"
        src={aboutPhoto.imageUrl}
        alt={aboutPhoto.alt}
        loading="lazy"
        decoding="async"
      />
      <p class="about__credit">
        Photo:{' '}
        <a
          href={`https://unsplash.com/@${aboutPhoto.credit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
          target="_blank"
          rel="noopener noreferrer"
        >
          {aboutPhoto.credit.name}
        </a>{' '}
        /{' '}
        <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
      </p>
    </div>
  </section>

  <section class="stats-band reveal">
    <img
      class="stats-band__bg"
      src={statsPhoto.imageUrl}
      alt={statsPhoto.alt}
      loading="lazy"
      decoding="async"
    />
    <div class="stats-band__overlay" aria-hidden="true" />
    <p class="stats-band__credit">
      Photo:{' '}
      <a
        href={`https://unsplash.com/@${statsPhoto.credit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {statsPhoto.credit.name}
      </a>{' '}
      /{' '}
      <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
    </p>
    <div class="container stats-band__grid">
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number" data-count-to={tourCount}>{tourCount}</p>
        <p class="stats-band__label">Signature tours</p>
      </div>
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number" data-count-to={adventureCount}>{adventureCount}</p>
        <p class="stats-band__label">Adventures</p>
      </div>
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number" data-count-to={comboCount}>{comboCount}</p>
        <p class="stats-band__label">Combo deals</p>
      </div>
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number" data-count-to={2}>2</p>
        <p class="stats-band__label">Home bases — Swakopmund &amp; Walvis Bay</p>
      </div>
    </div>
  </section>

  <WhyUsSection features={whyUsFeatures} />

  <section class="how-it-works reveal">
    <div class="container">
      <div class="how-it-works__intro reveal-item">
        <p class="how-it-works__eyebrow">How it works</p>
        <h2>Three simple steps</h2>
      </div>

      <ol class="how-it-works__grid">
        <li class="how-it-works__item reveal-item">
          <div class="how-it-works__photo-wrap">
            <img
              class="how-it-works__photo"
              src={howItWorksPhotos[0].imageUrl}
              alt={howItWorksPhotos[0].alt}
              loading="lazy"
              decoding="async"
            />
            <p class="how-it-works__credit">
              Photo:{' '}
              <a href={`https://unsplash.com/@${howItWorksPhotos[0].credit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`} target="_blank" rel="noopener noreferrer">{howItWorksPhotos[0].credit.name}</a>{' '}
              /{' '}
              <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
            </p>
          </div>
          <span class="how-it-works__step" aria-hidden="true">01</span>
          <h3>Tell us your dates</h3>
          <p>
            Placeholder copy. Send us your travel dates and what you're
            hoping to see, whether that's Etosha's wildlife or the
            dunes at Sossusvlei.
          </p>
        </li>
        <li class="how-it-works__item reveal-item">
          <div class="how-it-works__photo-wrap">
            <img
              class="how-it-works__photo"
              src={howItWorksPhotos[1].imageUrl}
              alt={howItWorksPhotos[1].alt}
              loading="lazy"
              decoding="async"
            />
            <p class="how-it-works__credit">
              Photo:{' '}
              <a href={`https://unsplash.com/@${howItWorksPhotos[1].credit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`} target="_blank" rel="noopener noreferrer">{howItWorksPhotos[1].credit.name}</a>{' '}
              /{' '}
              <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
            </p>
          </div>
          <span class="how-it-works__step" aria-hidden="true">02</span>
          <h3>We build your day around you</h3>
          <p>
            Placeholder copy. We put together a plan that fits your
            dates, your pace, and the people you're traveling with —
            no fixed package required.
          </p>
        </li>
        <li class="how-it-works__item reveal-item">
          <div class="how-it-works__photo-wrap">
            <img
              class="how-it-works__photo"
              src={howItWorksPhotos[2].imageUrl}
              alt={howItWorksPhotos[2].alt}
              loading="lazy"
              decoding="async"
            />
            <p class="how-it-works__credit">
              Photo:{' '}
              <a href={`https://unsplash.com/@${howItWorksPhotos[2].credit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`} target="_blank" rel="noopener noreferrer">{howItWorksPhotos[2].credit.name}</a>{' '}
              /{' '}
              <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
            </p>
          </div>
          <span class="how-it-works__step" aria-hidden="true">03</span>
          <h3>Meet us in Swakopmund</h3>
          <p>
            Placeholder copy. Meet your guide in Swakopmund or Walvis
            Bay and head out — every tour starts and ends close to
            home.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="tours-teaser reveal">
    <div class="container tours-teaser__intro reveal-item">
      <p class="tours-teaser__eyebrow">Our offering</p>
      <h2>A few of our tours</h2>
      <p class="tours-teaser__body">
        A sample of what we run out of Swakopmund and Walvis Bay — see
        the full lineup, including every adventure and combo deal, on
        the tours page.
      </p>
    </div>

    <div class="tours-teaser__pin">
      <div class="tours-teaser__track">
        {
          teaserTours.map((tour) => (
            <div class="tours-teaser__item">
              <AdventureCard tour={tour} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="container tours-teaser__cta reveal-item">
      <a class="btn btn-outline" href="/tours">View all tours</a>
    </div>
  </section>

  <section class="where-we-go reveal">
    <div class="container where-we-go__intro reveal-item">
      <p class="where-we-go__eyebrow">Where we go</p>
      <h2>Three landscapes, one coastline</h2>
    </div>

    <div class="container where-we-go__grid">
      {
        whereWeGoPanels.map(({ label, copy, tour }) => (
          <figure class="where-we-go__panel">
            {tour.imageUrl && <img src={tour.imageUrl} alt={tour.name} loading="lazy" decoding="async" />}
            <div class="where-we-go__scrim" aria-hidden="true" />
            <figcaption class="where-we-go__text">
              <p class="where-we-go__label">{label}</p>
              <p class="where-we-go__copy">{copy}</p>
            </figcaption>
            {tour.imageCredit && (
              <p class="where-we-go__credit">
                Photo:{' '}
                <a
                  href={`https://unsplash.com/@${tour.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tour.imageCredit.name}
                </a>{' '}
                /{' '}
                <a
                  href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Unsplash
                </a>
              </p>
            )}
          </figure>
        ))
      }
    </div>
  </section>

  <section class="philosophy reveal">
    <div class="container philosophy__grid">
      <div class="philosophy__text reveal-item">
        <p class="philosophy__eyebrow">Why we do this</p>
        <h2>Placeholder heading about our philosophy</h2>
        <p class="philosophy__body">
          Placeholder copy — swap in the real philosophy here. We didn't
          start Salt &amp; Sun Tours to sell a checklist of sights. It's
          about the pause when the dunes catch the light just right, the
          quiet after the engine cuts on an empty stretch of coast — the
          moments a tour can't script, only make room for.
        </p>
      </div>

      <div class="philosophy__cluster">
        <svg
          class="philosophy__lines"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <line class="philosophy__line" x1="21" y1="17" x2="65" y2="17" />
          <line class="philosophy__line" x1="65" y1="17" x2="86" y2="48" />
          <line class="philosophy__line" x1="21" y1="17" x2="9" y2="49" />
          <line class="philosophy__line" x1="9" y1="49" x2="39" y2="77" />
          <line class="philosophy__line" x1="86" y1="48" x2="74" y2="86" />
          <line class="philosophy__line" x1="39" y1="77" x2="74" y2="86" />
        </svg>

        {
          philosophyPhotos.map((photo, i) => (
            <div class={`philosophy__photo philosophy__photo--${i + 1}`}>
              <img src={photo.imageUrl} alt={photo.alt} loading="lazy" decoding="async" />
            </div>
          ))
        }

        <p class="philosophy__cluster-caption">
          Placeholder copy — a short line about the people and places
          behind these tours.
        </p>
      </div>
    </div>

    <p class="container philosophy__credits">
      Photos:{' '}
      {
        philosophyPhotos.map((photo, i) => (
          <>
            <a
              href={`https://unsplash.com/@${photo.credit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {photo.credit.name}
            </a>
            {i < philosophyPhotos.length - 1 ? ', ' : ' '}
          </>
        ))
      }
      /{' '}
      <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
    </p>
  </section>

  <section class="homepage-adventures reveal">
    <div class="container homepage-adventures__intro reveal-item">
      <p class="homepage-adventures__eyebrow">Beyond the tours</p>
      <h2>More ways to spend a day</h2>
      <p class="homepage-adventures__body">
        Shorter, activity-based excursions around Swakopmund and Walvis
        Bay — the full lineup, including every combo deal, is on the
        tours page.
      </p>
    </div>

    <div class="container homepage-adventures__grid">
