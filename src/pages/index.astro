---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import HomeTeaserCard from '../components/HomeTeaserCard.astro';
import PictureBreak from '../components/PictureBreak.astro';
import { tourBySlug } from '../data/tours';
import type { Tour } from '../data/tours';
import { journeys, tripTypeLabels } from '../data/journeys';

const heroPanels = [
  {
    letter: 'N',
    alt: 'A herd of desert-adapted elephants walking along a dry riverbed in Namibia',
    imageUrl:
      'https://images.unsplash.com/photo-1667389861341-3f1c749cdf39?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Elina Palm', username: 'drawmeasun' },
  },
  {
    letter: 'A',
    alt: 'A lone oryx crossing the Namib desert plain',
    imageUrl:
      'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Arthur Souquet', username: 'arthursouquet' },
  },
  {
    letter: 'M',
    alt: 'Flamingos wading in the shallow waters of Walvis Bay',
    imageUrl:
      'https://images.unsplash.com/photo-1669805508900-d3eaed6e6c14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Vladimir Oprisko', username: 'captoprisko' },
  },
  {
    letter: 'I',
    alt: 'A Cape fur seal resting on the Namibian coast',
    imageUrl:
      'https://images.unsplash.com/photo-1772290226248-156cc5fe4f9b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    letter: 'B',
    alt: 'A cheetah in the Namibian bush',
    imageUrl:
      'https://images.unsplash.com/photo-1696894132788-d0b1af4c95a7?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Taylor Wright', username: 'taylorwright22' },
  },
  {
    letter: 'I',
    alt: 'Two zebras on the plains of Etosha National Park',
    imageUrl:
      'https://images.unsplash.com/photo-1579172342894-e6d751ec390c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Geranimo', username: 'geraninmo' },
  },
  {
    letter: 'A',
    alt: 'Towering red sand dunes under a clear sky near Sossusvlei',
    imageUrl:
      'https://images.unsplash.com/photo-1613155358201-36bcf3ce695e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Mareike Kramper', username: 'mareike_capetown' },
  },
];

// Three homepage product bands (Tours / Adventures / Journeys), each a
// curated handful of real entries pulled straight from the same data the
// /tours and /journeys pages use — not resourced or re-described, just a
// smaller preview that leads to the full listing.
const toursPreview = ['etosha-tour', 'sossusvlei-tour', 'sandwich-harbour-full-day', 'skeleton-coast-tour']
  .map((slug) => tourBySlug(slug))
  .filter((t): t is Tour => !!t);

const adventuresPreview = ['quad-bike-tour', 'sandboarding', 'tandem-skydive', 'kayaking']
  .map((slug) => tourBySlug(slug))
  .filter((t): t is Tour => !!t);

// Picture breaks between the three bands above — a short full-bleed photo
// with faded top/bottom edges and a scroll parallax drift (see
// PictureBreak.astro and setupPictureBreakParallax in motion.ts).
const toursAdventuresBreak = {
  imageUrl: 'https://images.unsplash.com/photo-1588508106185-92ee909daf55?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  imageCredit: { name: 'Max Murauer', username: 'maxtheaviator' },
};
const adventuresJourneysBreak = {
  imageUrl: 'https://images.unsplash.com/photo-1644219527937-28564ba100b0?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  imageCredit: { name: 'Ria Truter', username: 'metaldawn' },
};

// About Us background — the founder photo and bio card sit on top of
// this, "fully defined" (no scrim), same treatment as booking/contact.
const aboutBgPhoto = {
  url: 'https://images.unsplash.com/photo-1696894134220-cfc38c3bf7a1?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2400',
  credit: { name: 'Taylor Wright', username: 'taylorwright22' },
};
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;

// "The Logbook" — eight landmarks that carry real weight in Namibia's
// human and geological history, each tied to a confirmed photo of the
// actual place rather than a generic stand-in. Order is a loose
// chronological arc: deep prehistory, geological time, the age of
// exploration, the diamond era, then a closing wide shot.
const logbookStories = [
  {
    id: 'twyfelfontein',
    kicker: 'The Kunene Region — a record kept for 6,000 years',
    headline: 'Where the Rock Remembers',
    body: [
      "Long before any road reached this valley, San hunters and herders pressed more than 2,000 images into the sandstone here — lion, rhino, giraffe, ostrich and human figures, some engraved as recently as a few centuries ago and others estimated at up to 6,000 years old. It's the largest concentration of rock art in Africa, and in 2007 it became Namibia's first UNESCO World Heritage Site.",
      "The farmer who settled here in the 1940s named it Twyfelfontein — 'doubtful spring' — unsure the water source would last through a dry season. The most famous panel, the so-called Lion Man, shows a lion with five toes on each paw and a human footprint at the tip of its tail, a detail still debated by researchers studying what the engraving meant to the people who made it.",
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1745305947174-eccb8a2d5528?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'Markus Kammermann', username: 'makabera' },
    alt: 'An ancient San rock engraving of an animal pressed into sandstone at Twyfelfontein',
  },
  {
    id: 'spitzkoppe',
    kicker: 'The Erongo Region — granite risen 1,784 metres',
    headline: 'A Cathedral of Bare Stone',
    body: [
      'Locals call it the Matterhorn of Africa, though the comparison undersells it: this granite inselberg rose from the desert floor roughly 120 million years ago, as Gondwana was still pulling apart, long before the Alps existed at all. It climbs 1,784 metres above sea level and around 700 metres above the surrounding plain, a single bald dome visible for miles across flat gravel desert.',
      "Its overhangs shelter Bushman's Paradise, a hidden gallery of San paintings estimated at 2,000 to 4,000 years old. After dark, with no city light for a hundred kilometres in any direction, the bare granite turns Spitzkoppe into one of the clearest amateur observatories south of the equator — climbers have been coming since the first recorded ascent in 1946.",
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1656703324736-3663eafb4588?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'Colin Watts', username: 'colinwatts' },
    alt: 'Star trails circling above the granite peaks of Spitzkoppe at night',
  },
  {
    id: 'etosha-pan',
    kicker: 'Owamboland — a lakebed silent since the Pleistocene',
    headline: 'The Great Place of Dry Water',
    body: [
      "Etosha means 'great white place,' and the name undersells nothing: this salt pan covers roughly 4,800 square kilometres, big enough to be picked out from orbit. It was born when tectonic shifts, tens of thousands of years ago, diverted the river that once fed a permanent lake here, leaving behind a vast cracked bed of white clay and salt.",
      'It fills only after unusually heavy rain, holding a few centimetres of water for a few weeks before evaporating again. The surrounding reserve was first proclaimed in 1907 by the German colonial administration, making Etosha National Park one of the oldest protected wildlife areas in Africa — its waterholes remain the reason animals gather here at all.',
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1785509210476-84acfc4f2279?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'aurélie sgnl', username: 'auresa' },
    alt: 'The vast, cracked white surface of the Etosha salt pan under a clear sky',
  },
  {
    id: 'deadvlei',
    kicker: 'The Namib-Naukluft — trees dead 600 to 900 years',
    headline: 'Centuries Without Water',
    body: [
      'When the Tsauchab River shifted course, it cut off a shallow clay pan from the water that once reached it, stranding a grove of camel thorn trees between dunes that now rank among the tallest on Earth — Big Daddy, just beside the pan, rises some 325 metres. The trees are thought to have died somewhere between 600 and 900 years ago.',
      "What keeps them standing is the same aridity that killed them: this pocket of the Namib is too dry for the fungi and bacteria that would normally rot dead wood, so the trunks simply never decomposed. Their blackened colour isn't char from fire — it's centuries of direct sun scorching the exposed timber against a floor of pale, cracked clay and red dune sand.",
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1514471244491-6fb96fcdf04f?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'Parsing Eye', username: 'parsingeye' },
    alt: 'The blackened, centuries-old dead trees of Deadvlei against red dunes',
  },
  {
    id: 'skeleton-coast',
    kicker: 'The South Atlantic — where fog meets fire',
    headline: 'The Coast the Charts Warned Against',
    body: [
      'Early Portuguese sailors called this shoreline As Areias do Inferno — the Sands of Hell. The cold Benguela Current, sweeping up from Antarctica, meets the desert heat and produces thick fog on as many as 250 days a year, just often enough to pull ships onto sandbars with no way back to open water.',
      "More than a thousand wrecks are said to lie along roughly 500 kilometres of this coast, their ribs still surfacing from the dunes decades later. Survivors who made it to shore then faced a crossing few managed: a waterless desert stretching inland, which is why the region's name in the local Ovahimba language translates to something like 'the land God made in anger.'",
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1667506609659-599fb1f59f94?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'Joshua Kettle', username: 'joshuakettle' },
    alt: 'The rusted wreck of a ship stranded on the sand of the Skeleton Coast',
  },
  {
    id: 'cape-cross',
    kicker: "The Skeleton Coast's southern gate — marked 1486",
    headline: 'The First Marker on an Unmapped Shore',
    body: [
      'Portuguese navigator Diogo Cão planted a stone padrão here in 1486, inscribed in Portuguese and Latin, marking the first recorded European landing on this stretch of coast. German naval officers removed the original in 1893 and shipped it to a museum in Berlin, where it still stands; a replica has marked the cape since 1980.',
      'Today the site belongs to the seals far more than to any explorer\'s monument. Numbers swing with the season, from roughly 80,000 up to 210,000 or more during the November-to-December pupping season, making Cape Cross home to one of the largest Cape fur seal colonies on the planet — animals that are, despite the name, more closely related to sea lions than true seals.',
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1635764372997-a1cc39c48986?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'katsuma tanaka', username: 'kt2080' },
    alt: 'The dense Cape fur seal colony crowding the shore at Cape Cross',
  },
  {
    id: 'kolmanskop',
    kicker: 'The Sperrgebiet — diamonds found 1908',
    headline: 'A Boomtown the Desert Took Back',
    body: [
      'In April 1908, a railway worker named Zacharias Lewala picked a stray diamond out of the sand while clearing tracks, and within months this patch of desert had a boomtown. The German colonial government sealed the whole region off as a Sperrgebiet — a forbidden zone — and by the 1920s Kolmanskop had around 300 German residents, a hospital, a theatre, a bowling alley, and the first tram built in Africa.',
      'A pipeline carried fresh water 120 kilometres from the Kuiseb River just to keep it running. Richer deposits found farther south, near the Orange River, drew the diamond trade away after 1928, and the last residents left by 1956. The dunes have been moving back through the empty houses ever since, filling rooms floor to window frame.',
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1588453588404-299e4d3e37d5?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'Max Murauer', username: 'maxtheaviator' },
    alt: 'A sand-filled colonial building in the abandoned diamond town of Kolmanskop',
  },
  {
    id: 'fish-river-canyon',
    kicker: 'The far south — carved over 500 million years',
    headline: "Africa's Longest Scar",
    body: [
      "Second only to the Grand Canyon in scale, this gorge runs about 160 kilometres long, up to 27 kilometres wide, and drops as deep as 550 metres in places. Its walls record roughly 500 million years of geological history — first a collapsing valley shaped by ancient tectonic movement, then reshaped again by glaciers some 300 million years ago, and finally cut by the Fish River itself, which still flows through it today.",
      "The multi-day hiking trail through the canyon floor, around 90 kilometres end to end, is one of the most famous treks in southern Africa, and it's only open from May to September — the rest of the year the heat inside the canyon makes the walk dangerous. At dawn its terraced walls run copper, rust and violet before the sun clears the rim and the colour flattens out.",
    ],
    imageUrl:
      'https://images.unsplash.com/photo-1639402478735-7219a7e249ff?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1600',
    imageCredit: { name: 'Andrew Svk', username: 'andrew_svk' },
    alt: 'The layered red-rock terraces of Fish River Canyon at sunset',
  },
];

// Placeholder lineup — swap in real fleet photos once supplied.
interface FleetVehicle {
  name: string;
  imageUrl?: string;
  imageCredit?: { name: string; username?: string; href?: string; source?: string; sourceHref?: string };
}

const fleetVehicles: FleetVehicle[] = [
  { name: 'Toyota Land Cruiser 79 Pickup' },
  { name: 'Toyota Fortuner 2.8 GD-6' },
  { name: 'Toyota Fortuner 4.0 V6' },
];

// Real guest reviews, transcribed verbatim from Salt and Sun Tours' Google
// Business profile. Add more entries here as they're supplied — don't mix
// in placeholder text once a real review is in the array.
const testimonials = [
  {
    quote: "Fantastic experience. I had the pleasure to meet Lenga, the guide and he presented Namibia at a glance and its most beautiful sides. Seperate from his knowledge on the country a very pleasant experience. Well done Team Salt & Sun!",
    name: 'Jos Bol',
    trip: 'Google review',
    rating: 5,
  },
  {
    quote: "I had an amazing experience on the excavation tour to the Pink Lake with my friends. Our tour guide, Mr. Lenga and his coworker were very knowledgeable, friendly and welcoming. Everything was well explained, engaging and fun. I truly enjoyed every moment and learned so much while having a great time. It was a memorable experience and I would highly recommend this tour to anyone looking for a fun and educational adventure.",
    name: 'Lorraine Taylor',
    trip: 'Google review',
    rating: 5,
  },
  {
    quote: "Lenga is a great tour guide, everything was very well organized, he was on time and took care of us well. We had lots of time to stop at all the stops and take pictures at our leisure. He was very informative and gave us lots of key information about the areas. He tried his best to find some wild animals for us to see. The food that was supplied was amazing and Sandwich Harbour was picturesque. Thank you !",
    name: 'A P',
    trip: 'Google review',
    rating: 5,
  },
];

---

<BaseLayout
  title="Home"
  description="Desert and coastal tours from Swakopmund and Walvis Bay, Namibia — Etosha, Sossusvlei, Skeleton Coast, and more with Salt and Sun Tours."
>
  <Hero
    title="Namibia"
    eyebrow="Salt and Sun Tours"
    subhead="Desert and coastal adventures out of Swakopmund and Walvis Bay — from towering red dunes to seal colonies at Pelican Point."
    ctaLabel="Explore our tours"
    ctaHref="/tours"
    panels={heroPanels}
  />

  <div id="scroll-target"></div>

  <!-- ============ 01 · TOURS ============ -->
  <section class="block home-band reveal" id="home-tours">
    <p class="eyebrow">The Itinerary</p>
    <h2 class="section-title">Ten signature tours across Namibia</h2>
    <p class="home-band__intro">
      Full-day trips to Namibia's most iconic destinations — the red dunes of Sossusvlei,
      the wildlife of Etosha, the wrecks of the Skeleton Coast — run out of Swakopmund and Walvis Bay.
    </p>

    <div class="home-band__grid reveal-item">
      {
        toursPreview.map((tour) => (
          <HomeTeaserCard
            href="/tours"
            imageUrl={tour.imageUrl!}
            imageCredit={tour.imageCredit}
            name={tour.name}
            meta={tour.duration}
            desc={tour.description}
          />
        ))
      }
    </div>

    <a class="btn btn-outline" href="/tours">See all tours →</a>
  </section>

  <PictureBreak imageUrl={toursAdventuresBreak.imageUrl} imageCredit={toursAdventuresBreak.imageCredit} />

  <!-- ============ 02 · ADVENTURES ============ -->
  <section class="block home-band reveal" id="home-adventures">
    <p class="eyebrow">Closer to Town</p>
    <h2 class="section-title">An hour or an afternoon, right around Swakopmund</h2>
    <p class="home-band__intro">
      Shorter, activity-based excursions for whenever a full day isn't what you're after —
      quad bikes, sandboarding, skydiving and more, all closer to home.
    </p>

    <div class="home-band__grid reveal-item">
      {
        adventuresPreview.map((tour) => (
          <HomeTeaserCard
            href="/tours#adventures"
            imageUrl={tour.imageUrl!}
            imageCredit={tour.imageCredit}
            name={tour.name}
            meta={tour.duration}
            desc={tour.description}
          />
        ))
      }
    </div>

    <a class="btn btn-outline" href="/tours#adventures">See all adventures →</a>
  </section>

  <PictureBreak imageUrl={adventuresJourneysBreak.imageUrl} imageCredit={adventuresJourneysBreak.imageCredit} />

  <!-- ============ 03 · JOURNEYS ============ -->
  <section class="block home-band reveal" id="home-journeys">
    <p class="eyebrow">Beyond a Single Day</p>
    <h2 class="section-title">Four routes, planned day by day</h2>
    <p class="home-band__intro">
      A Journey strings several tours and destinations into one set route across Namibia —
      not just a longer tour, a whole trip planned start to finish.
    </p>

    <div class="home-band__grid reveal-item">
      {
        journeys.map((journey) => (
          <HomeTeaserCard
            href={`/journeys#${journey.slug}`}
            imageUrl={journey.heroImage}
            imageCredit={journey.imageCredit}
            name={journey.name}
            meta={`${journey.durationDays}-Day · ${tripTypeLabels[journey.tripType]}`}
            desc={journey.tagline}
          />
        ))
      }
    </div>

    <a class="btn btn-outline" href="/journeys">See all journeys →</a>
  </section>

  <!-- ============ 04 · ABOUT US ============ -->
  <section class="block about-block reveal" id="about">
    <div class="about-block__bg" style={`background-image:url('${aboutBgPhoto.url}')`} aria-hidden="true"></div>

    <div class="about-block__intro">
      <p class="eyebrow">About Us</p>
      <h2 class="section-title">More than a journey</h2>
    </div>

    <div class="about-layout reveal-item">
      <div class="about-photo">
        <div class="about-photo__frame">
          <img
            src="https://saltandsuntours.com.na/wp-content/uploads/2026/04/WhatsApp-Image-2025-10-24-at-4.58.13-PM.jpeg"
            alt="Lenga Shihueka, founder of Salt and Sun Tours"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="about-photo__name">Lenga Shihueka</p>
        <p class="about-photo__role">Founder</p>
      </div>

      <div class="about-card" data-about-pages>
        <div class="about-card__pages">
          <div class="about-card__page is-active" data-about-page>
            <p class="about-copy__lead">My name is Lenga, and Lenga means King.</p>

            <p>My roots are in Etosha, where the earth carries one of Namibia's greatest wonders — the Etosha salt pan. That is where the heart of Salt and Sun Tours begins: from the salt of the earth, under the Namibian sun, and grounded in a purpose greater than tourism.</p>

            <p>Our foundation is inspired by Matthew 5:13–16 — to be salt and light in the world.</p>

            <p>For us, a tour is not simply about driving through the dunes, watching wildlife, camping beneath the stars, enjoying a picnic, or experiencing the thrill of an adventure.</p>

            <p class="about-copy__pull">It is about the person you become along the way.</p>
          </div>

          <div class="about-card__page" data-about-page>
            <p>Life leaves people carrying stories that are often never spoken — pain, disappointment, loss, rejection, fear, and experiences that shape who we become. My own journey taught me that sometimes healing begins when we finally have a safe place to be heard.</p>

            <p>That is what we want Salt and Sun Tours to be.</p>

            <p class="about-copy__list">
              A place where strangers can become companions.<br />
              Where conversations go deeper than the road ahead.<br />
              Where stories can be shared without judgement.<br />
              Where we can laugh, reflect, encourage one another, and sometimes simply sit in silence beneath the African sky.
            </p>

            <p class="about-copy__pull">
              You may arrive looking for Namibia.<br />
              You may leave having found a little more of yourself.
            </p>
          </div>

          <div class="about-card__page" data-about-page>
            <p>We believe that every person has value, regardless of their past, their mistakes, or what they have been through. And sometimes, one person's testimony can become another person's reason to keep going.</p>

            <p>So when you travel with us, you are not just booking a tour.</p>

            <p class="about-copy__pull">You are joining a journey of connection, discovery, healing and transformation.</p>

            <p class="about-copy__invite">Come experience the salt. Feel the sun. Meet the wilderness. Share the journey.</p>

            <p>And perhaps, somewhere between the desert and the stars, you will discover that the greatest destination was never a place — it was becoming who you were created to be.</p>

            <div class="about-copy__signoff">
              <p class="about-copy__signoff-name">Salt and Sun Tours</p>
              <p class="about-copy__signoff-tag">More than a tour. A journey that leaves a mark.</p>
            </div>
          </div>
        </div>

        <div class="about-card__controls">
          <button type="button" class="about-card__arrow" data-about-prev aria-label="Previous page">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <p class="about-card__counter"><span data-about-current>1</span> / 3</p>
          <button type="button" class="about-card__arrow" data-about-next aria-label="Next page">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
        </div>
      </div>
    </div>

    {aboutBgPhoto.credit && (
      <p class="about-block__credit">
        Photo:{' '}
        <a href={creditHref(aboutBgPhoto.credit.username)} target="_blank" rel="noopener noreferrer">
          {aboutBgPhoto.credit.name}
        </a>{' '}
        / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
      </p>
    )}
  </section>

  <!-- ============ 05 · OUR FLEET ============ -->
  <section class="stamps-block reveal" id="fleet">
    <div class="stamps-inner">
      <p class="eyebrow">Our Fleet</p>
      <h2 class="section-title">What gets you there</h2>
      <div class="fleet-grid reveal-item">
        {
          fleetVehicles.map((v) => (
            <div class="fleet-card">
              {v.imageUrl ? (
                <div class="fleet-card__photo photo-frame">
                  <img src={v.imageUrl} alt={v.name} loading="lazy" decoding="async" />
                </div>
              ) : (
                <div class="fleet-card__photo fleet-card__photo--placeholder">
                  <svg viewBox="0 0 48 48" aria-hidden="true">
                    <path d="M6 30l3.4-10.2a3 3 0 0 1 2.85-2.05h23.5a3 3 0 0 1 2.85 2.05L42 30" />
                    <rect x="4" y="30" width="40" height="9" rx="2.5" />
                    <circle cx="14" cy="39" r="3.4" />
                    <circle cx="34" cy="39" r="3.4" />
                  </svg>
                  <span>Photo coming soon</span>
                </div>
              )}
              <p class="fleet-card__name">{v.name}</p>
              {v.imageCredit && v.imageCredit.username && (
                <p class="fleet-card__credit">
                  Photo:{' '}
