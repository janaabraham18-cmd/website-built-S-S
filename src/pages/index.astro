    justify-content: center;
    gap: 0.5rem;
    color: var(--color-text-muted);
  }

  .fleet-card__photo--placeholder svg {
    width: 40px;
    height: 40px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .fleet-card__photo--placeholder span {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .fleet-card__name {
    margin: 0.85rem 0 0;
    font-weight: 600;
    color: var(--color-earth-900);
  }

  .fleet-card__credit {
    margin: 0.3rem 0 0;
    font-size: var(--fs-xs);
    color: var(--color-text-muted);
  }

  .fleet-card__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---------- 07 Postcards ---------- */
  .postcards-block {
    position: relative;
    z-index: 0;
    overflow: hidden;
  }

  /* Hikers with backpacks, heavily blurred so it reads as ambient
     texture rather than a competing photo behind the review cards.
