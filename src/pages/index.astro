---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';

const heroPanels = [
  {
    letter: 'N',
    alt: 'A herd of desert-adapted elephants walking along a dry riverbed in Namibia',
    imageUrl:
      'https://images.unsplash.com/photo-1667389861341-3f1c749cdf39?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Elina Palm', username: 'drawmeasun' },
  },
  {
    letter: 'A',
    alt: 'A lone oryx crossing the Namib desert plain',
    imageUrl:
      'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Arthur Souquet', username: 'arthursouquet' },
  },
  {
    letter: 'M',
    alt: 'Flamingos wading in the shallow waters of Walvis Bay',
    imageUrl:
      'https://images.unsplash.com/photo-1669805508900-d3eaed6e6c14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Vladimir Oprisko', username: 'captoprisko' },
  },
  {
    letter: 'I',
    alt: 'A Cape fur seal resting on the Namibian coast',
    imageUrl:
      'https://images.unsplash.com/photo-1772290226248-156cc5fe4f9b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    letter: 'B',
    alt: 'A cheetah in the Namibian bush',
    imageUrl:
      'https://images.unsplash.com/photo-1696894132788-d0b1af4c95a7?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Taylor Wright', username: 'taylorwright22' },
  },
  {
    letter: 'I',
    alt: 'Two zebras on the plains of Etosha National Park',
    imageUrl:
      'https://images.unsplash.com/photo-1579172342894-e6d751ec390c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Geranimo', username: 'geraninmo' },
  },
  {
    letter: 'A',
    alt: 'Towering red sand dunes under a clear sky near Sossusvlei',
    imageUrl:
      'https://images.unsplash.com/photo-1613155358201-36bcf3ce695e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Mareike Kramper', username: 'mareike_capetown' },
  },
];

const closingCtaPhoto = {
  imageUrl:
    'https://images.unsplash.com/photo-1783679603167-4d6650f3cbd3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1800',
  credit: { name: 'GILLES GORLIER', username: 'gorlig_38' },
};
---

<BaseLayout
  title="Home"
  description="Desert and coastal tours from Swakopmund and Walvis Bay, Namibia — Etosha, Sossusvlei, Skeleton Coast, and more with Salt & Sun Tours."
>
  <Hero
    title="Namibia"
    eyebrow="Salt & Sun Tours"
    subhead="Desert and coastal adventures out of Swakopmund and Walvis Bay — from towering red dunes to seal colonies at Pelican Point."
    ctaLabel="Explore our tours"
    ctaHref="/tours"
    panels={heroPanels}
  />

  <div id="scroll-target"></div>

  <section class="block about-block reveal" id="about">
    <p class="eyebrow">About Us</p>
    <h2 class="section-title">Two home bases, one stretch of coast and desert</h2>

    <div class="about-row reveal-item">
      <div class="about-media single">
        <img
          src="https://images.unsplash.com/photo-1707470121585-23ecf4671684?w=1000&q=80&auto=format&fit=crop"
          alt="Red dunes of the Namib desert"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-copy">
        <h3>No call center, no middleman</h3>
        <p>We run every tour out of Swakopmund and Walvis Bay — no call center, no middleman, just guides who know the dunes and the coastline because they work them every day.</p>
        <p>That means we cover both ends of what Namibia does best: the towering red dunes and dry riverbeds inland, and the seal colonies, lagoons, and Atlantic swell along the coast — often on the same day, if that's how you want to build your trip.</p>
      </div>
    </div>

    <div class="about-row reverse reveal-item">
      <div class="about-media double">
        <img
          src="https://images.unsplash.com/photo-1769450290445-3daed0c8fe63?w=700&q=80&auto=format&fit=crop"
          alt="Quad biking on the dunes near Swakopmund"
          loading="lazy"
          decoding="async"
        />
        <img
          src="https://images.unsplash.com/photo-1440020143730-090579c4d53c?w=700&q=80&auto=format&fit=crop"
          alt="Catamaran cruise on Walvis Bay"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-copy">
        <h3>Desert and ocean, one lineup</h3>
        <p>Based right in Swakopmund — every tour starts close to home, with few operators anywhere in Namibia covering both ends of the landscape the way we do.</p>
        <p>From the red dunes of Sossusvlei to the seal colonies of Pelican Point, it's one lineup, one team, and one place to book it all.</p>
      </div>
    </div>

    <div class="about-row reveal-item">
      <div class="about-media double">
        <img
          src="https://images.unsplash.com/photo-1636099487113-ce0a5565b578?w=700&q=80&auto=format&fit=crop"
          alt="Wildlife in Etosha National Park"
          loading="lazy"
          decoding="async"
        />
        <img
          src="https://images.unsplash.com/photo-1603703182693-51a19941fa59?w=700&q=80&auto=format&fit=crop"
          alt="Township tour guide in Swakopmund"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="about-copy">
        <h3>31 ways to mix and match</h3>
        <p>7 signature tours, 16 adventures, and 8 combo deals — pair a quad bike ride with a catamaran cruise, or build your own day from scratch.</p>
        <p>Every one of them runs with hands-on local guides who know the dunes and the coastline — not a script read off a clipboard.</p>
      </div>
    </div>
  </section>

  <section class="block gallery-block reveal" id="gallery">
    <p class="eyebrow">Gallery</p>
    <h2 class="section-title">Namibia, in passing</h2>
    <div class="gallery-grid reveal-item">
      <img src="https://images.unsplash.com/photo-1705065277882-b0604ec13dca?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1542762002-45279e010961?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1771148884276-2f101fcadcb1?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1667666670938-4e89397d7c06?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1622713486130-aa0177e64542?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1766470956586-2b969d67b391?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1504813205186-380b1235a5d2?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
      <img src="https://images.unsplash.com/photo-1778379591293-36b4cb24324f?w=600&h=500&q=80&auto=format&fit=crop" alt="Namibia landscape" loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="block program-block reveal" id="program">
    <p class="eyebrow">Tour Programs</p>
    <h2 class="section-title">A closer look at the lineup</h2>

    <div class="program-item reveal-item">
      <div class="program-media">
        <img
          src="https://images.unsplash.com/photo-1707470121585-23ecf4671684?w=900&q=80&auto=format&fit=crop"
          alt="Sossusvlei dunes"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="program-copy">
        <p class="program-tag">Desert Tour · Half-day</p>
        <p class="tour-name">Sossusvlei Tour</p>
        <h3>Namibia's most photographed dunes</h3>
        <p>Deep in the Namib-Naukluft, the dunes at Sossusvlei rise over 300 metres above the pan floor. We time the drive for early light, when the red sand and the dead trees at Deadvlei throw the longest shadows of the day.</p>
        <a class="book-link" href="/booking?tour=sossusvlei-tour">Book this tour</a>
      </div>
    </div>

    <div class="program-item reverse reveal-item">
      <div class="program-media">
        <img
          src="https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?w=900&q=80&auto=format&fit=crop"
          alt="Sandwich Harbour where dunes meet the ocean"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="program-copy">
        <p class="program-tag">Coastal Tour · Full-day</p>
        <p class="tour-name">Sandwich Harbour Tour</p>
        <h3>Where the dunes plunge into the Atlantic</h3>
        <p>A 4x4 run past salt pans and flamingo-filled lagoons to Namibia's most photographed meeting of desert and ocean — towering dunes dropping straight into the sea.</p>
        <a class="book-link" href="/booking?tour=sandwich-harbour-full-day">Book this tour</a>
      </div>
    </div>

    <div class="program-item reveal-item">
      <div class="program-media">
        <img
          src="https://images.unsplash.com/photo-1769450290445-3daed0c8fe63?w=900&q=80&auto=format&fit=crop"
          alt="Quad biking on the dunes"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="program-copy">
        <p class="program-tag">Adventure · Half-day</p>
        <p class="tour-name">Quad Bike Tour</p>
        <h3>Ride the dunes yourself</h3>
        <p>A guided quad bike run through the dune belt outside Swakopmund, built for anyone who wants to do more than just look at the sand.</p>
        <a class="book-link" href="/booking?tour=quad-bike-tour">Book this tour</a>
      </div>
    </div>

    <div class="program-item reverse reveal-item">
      <div class="program-media">
        <img
          src="https://images.unsplash.com/photo-1440020143730-090579c4d53c?w=900&q=80&auto=format&fit=crop"
          alt="Catamaran cruise with dolphins"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="program-copy">
        <p class="program-tag">Coastal · Half-day</p>
        <p class="tour-name">Dolphin &amp; Seal Catamaran Cruise</p>
        <h3>Dolphins, seals, and the Walvis Bay lagoon</h3>
        <p>A catamaran cruise out of Walvis Bay past the seal colony at Pelican Point, with a good chance of dolphins riding the bow wake along the way.</p>
        <a class="book-link" href="/booking?tour=dolphin-seal-catamaran-cruise">Book this tour</a>
      </div>
    </div>

    <div class="program-item reveal-item">
      <div class="program-media">
        <img
          src="https://images.unsplash.com/photo-1636099487113-ce0a5565b578?w=900&q=80&auto=format&fit=crop"
          alt="Wildlife at Etosha National Park"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="program-copy">
        <p class="program-tag">Wildlife · Multi-day</p>
        <p class="tour-name">Etosha Tour</p>
        <h3>Namibia's flagship game park</h3>
        <p>Etosha's salt pan and waterholes concentrate wildlife in a way few parks can match — oryx, zebra, elephant, and the cats that follow them.</p>
        <a class="book-link" href="/booking?tour=etosha-tour">Book this tour</a>
      </div>
    </div>

    <div class="program-item reverse reveal-item">
      <div class="program-media">
        <img
          src="https://images.unsplash.com/photo-1603703182693-51a19941fa59?w=900&q=80&auto=format&fit=crop"
          alt="Township tour in Swakopmund"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="program-copy">
        <p class="program-tag">Culture · Half-day</p>
        <p class="tour-name">Township Tour</p>
        <h3>Life in Mondesa and DRC</h3>
        <p>A guided walk through Swakopmund's townships, led by people who live there — the side of town most visitors never see.</p>
        <a class="book-link" href="/booking?tour=township-tour">Book this tour</a>
      </div>
    </div>
  </section>

  <Section
    align="center"
    theme="photo"
    imageUrl={closingCtaPhoto.imageUrl}
    imageCredit={closingCtaPhoto.credit}
  >
    <div class="cta-card">
      <p class="cta-card__eyebrow">Ready when you are</p>
      <h2 class="cta-card__heading">Plan your journey</h2>
      <p class="cta-card__body">
        Ready to see the dunes, the coastline, and everything in between?
        Get in touch and we'll help you build the right day — or days —
        around Swakopmund and Walvis Bay.
      </p>
      <a class="btn btn-primary" href="/booking">Start booking</a>
    </div>
  </Section>
</BaseLayout>

<style>
  /* ---------- Dark section shell (About / Gallery / Tour Programs) ---------- */
  .block {
    background: #2b1810;
    color: #f6ecdc;
    padding: clamp(3.5rem, 8vw, 6.25rem) clamp(1.25rem, 8vw, 6rem);
  }

  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: #b15a34;
    font-weight: 600;
    margin-bottom: 0.9rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: 2.5rem;
    font-weight: 400;
    margin: 0 0 3.75rem 0;
    color: #f6ecdc;
    max-width: 700px;
  }

  /* ---------- About ---------- */
  .about-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    margin-bottom: 5rem;
  }

  .about-row:last-child {
    margin-bottom: 0;
  }

  .about-row.reverse .about-media {
    order: 2;
  }

  .about-row.reverse .about-copy {
    order: 1;
  }

  .about-media {
    display: grid;
    gap: 1rem;
  }

  .about-media.single img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 2px;
  }

  .about-media.double {
    grid-template-columns: 1fr 1fr;
  }

  .about-media.double img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    border-radius: 2px;
  }

  .about-copy h3 {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 1.1rem 0;
    color: #f6ecdc;
  }

  .about-copy p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #d9c9b8;
    margin: 0 0 1rem 0;
  }

  .about-copy p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Gallery ---------- */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: repeat(2, 1fr);
    gap: 0.875rem;
  }

  .gallery-grid img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    border-radius: 2px;
    display: block;
  }

  /* ---------- Tour Programs ---------- */
  .program-item {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
    padding: 3.5rem 0;
    border-top: 1px solid rgba(246, 236, 220, 0.12);
  }

  .program-item:first-of-type {
    border-top: none;
    padding-top: 0;
  }

  .program-item.reverse .program-media {
    order: 2;
  }

  .program-item.reverse .program-copy {
    order: 1;
  }

  .program-media img {
    width: 100%;
    height: 340px;
    object-fit: cover;
    border-radius: 2px;
  }

  .program-tag {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #b15a34;
    font-weight: 600;
    margin: 0 0 0.6rem 0;
  }

  .tour-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: #f6ecdc;
    margin: 0 0 0.4rem 0;
  }

  .program-copy h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    margin: 0 0 1rem 0;
    color: #f6ecdc;
  }

  .program-copy p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #d9c9b8;
    margin: 0 0 1.25rem 0;
  }

  .book-link {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: #f6ecdc;
    border-bottom: 1px solid #b15a34;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .book-link:hover {
    color: #d3a24f;
    border-color: #d3a24f;
  }

  @media (max-width: 800px) {
    .about-row,
    .program-item {
      grid-template-columns: 1fr;
    }

    .about-row.reverse .about-media,
    .about-row.reverse .about-copy,
    .program-item.reverse .program-media,
    .program-item.reverse .program-copy {
      order: initial;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(4, 1fr);
    }

    .section-title {
      font-size: 1.875rem;
    }
  }

  /* ---------- Closing CTA card ---------- */
  .cta-card {
    max-width: 34rem;
    margin-inline: auto;
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    background: rgba(251, 247, 241, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(251, 247, 241, 0.25);
    box-shadow: var(--shadow-lg);
  }

  .cta-card__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin: 0 0 var(--space-2xs);
  }

  .cta-card__heading {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-weight: 600;
    color: var(--color-text-on-dark);
    margin: 0 0 var(--space-md);
  }

  .cta-card__body {
    color: var(--color-sand-100);
    line-height: var(--lh-normal);
    margin: 0 0 var(--space-lg);
  }

  @media (max-width: 640px) {
    .cta-card {
      padding: var(--space-lg);
    }
  }
</style>
