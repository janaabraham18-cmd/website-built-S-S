  .cta-card__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin: 0 0 var(--space-2xs);
  }

  .cta-card__heading {
    font-family: var(--font-display-italic);
    font-style: italic;
    font-weight: 600;
    color: var(--color-text-on-dark);
