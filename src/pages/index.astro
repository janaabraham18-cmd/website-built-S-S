---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyUsSection from '../components/WhyUsSection.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import AdventureCard from '../components/AdventureCard.astro';
import { tours } from '../data/tours';

const teaserSlugs = [
  'etosha-tour',
  'sossusvlei-tour',
  'sandwich-harbour-full-day',
  'quad-bike-tour',
  'dolphin-seal-catamaran-cruise',
  'tandem-skydive',
];
const teaserTours = teaserSlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const adventureSlugs = [
  'paragliding',
  'camel-ride',
  'sandboarding',
  'kayaking',
  'living-desert-tour',
  'township-tour',
  'fat-bike-tour',
  'cape-cross',
];
const adventureTours = adventureSlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const gallerySlugs = [
  'pelican-point-tour',
  'explorer-tour',
  'special-quad-90min',
  'sandwich-harbour-half-day',
  'fishing',
  'moonlandscape-tour',
  'surf-and-turf',
  'kayak-catamaran-combo',
];
const galleryTours = gallerySlugs
  .map((slug) => tours.find((tour) => tour.slug === slug))
  .filter((tour) => tour !== undefined);

const heroPanels = [
  {
    letter: 'N',
    alt: 'A herd of desert-adapted elephants walking along a dry riverbed in Namibia',
    imageUrl:
      'https://images.unsplash.com/photo-1667389861341-3f1c749cdf39?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Elina Palm', username: 'drawmeasun' },
  },
  {
    letter: 'A',
    alt: 'A lone oryx crossing the Namib desert plain',
    imageUrl:
      'https://images.unsplash.com/photo-1727880283608-57880fa4edcc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Arthur Souquet', username: 'arthursouquet' },
  },
  {
    letter: 'M',
    alt: 'Flamingos wading in the shallow waters of Walvis Bay',
    imageUrl:
      'https://images.unsplash.com/photo-1669805508900-d3eaed6e6c14?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Vladimir Oprisko', username: 'captoprisko' },
  },
  {
    letter: 'I',
    alt: 'A Cape fur seal resting on the Namibian coast',
    imageUrl:
      'https://images.unsplash.com/photo-1772290226248-156cc5fe4f9b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'NIR HIMI', username: 'nirhimi' },
  },
  {
    letter: 'B',
    alt: 'A cheetah in the Namibian bush',
    imageUrl:
      'https://images.unsplash.com/photo-1696894132788-d0b1af4c95a7?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Taylor Wright', username: 'taylorwright22' },
  },
  {
    letter: 'I',
    alt: 'Two zebras on the plains of Etosha National Park',
    imageUrl:
      'https://images.unsplash.com/photo-1579172342894-e6d751ec390c?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Geranimo', username: 'geraninmo' },
  },
  {
    letter: 'A',
    alt: 'Towering red sand dunes under a clear sky near Sossusvlei',
    imageUrl:
      'https://images.unsplash.com/photo-1613155358201-36bcf3ce695e?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1400',
    imageCredit: { name: 'Mareike Kramper', username: 'mareike_capetown' },
  },
];

const tourCount = tours.filter((tour) => tour.category === 'tour').length;
const adventureCount = tours.filter((tour) => tour.category === 'adventure').length;
const comboCount = tours.filter((tour) => tour.category === 'combo').length;

const whyUsFeatures = [
  {
    title: 'Based right in Swakopmund',
    description:
      "No call center, no middleman — every tour starts close to home in Swakopmund and Walvis Bay.",
    icon: 'compass' as const,
  },
  {
    title: 'Desert and ocean, one lineup',
    description:
      "From the red dunes of Sossusvlei to the seal colonies of Pelican Point — few operators cover both ends of Namibia's landscape.",
    icon: 'leaf' as const,
  },
  {
    title: `${tourCount + adventureCount + comboCount} ways to mix and match`,
    description: `${tourCount} signature tours, ${adventureCount} adventures, and ${comboCount} combo deals — pair a quad bike ride with a catamaran cruise, or build your own day.`,
    icon: 'users' as const,
  },
  {
    title: 'Guides who know the ground',
    description:
      'Hands-on local guides who know the dunes and the coastline — not a script read from a clipboard.',
    icon: 'shield' as const,
  },
];
---

<BaseLayout
  title="Home"
  description="Desert and coastal tours from Swakopmund and Walvis Bay, Namibia — Etosha, Sossusvlei, Skeleton Coast, and more with Salt & Sun Tours."
>
  <Hero
    title="Namibia"
    eyebrow="Salt & Sun Tours"
    subhead="Desert and coastal adventures out of Swakopmund and Walvis Bay — from towering red dunes to seal colonies at Pelican Point."
    ctaLabel="Explore our tours"
    ctaHref="/tours"
    panels={heroPanels}
  />

  <div id="scroll-target"></div>

  <div class="scroll-reveal" data-scroll-reveal aria-hidden="true">
    <svg
      class="scroll-reveal__shape"
      viewBox="0 0 1440 420"
      preserveAspectRatio="none"
      focusable="false"
    >
      <path d="M0,0 H1440 V210 C1300,210 1300,360 720,360 C140,360 140,210 0,210 Z" />
    </svg>
  </div>

  <AboutSection
    imageUrl="https://images.unsplash.com/photo-1711092047480-4382d9626abc?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1000"
    imageCredit={{ name: 'm_oros', username: 'm_oros' }}
  />

  <WhyUsSection features={whyUsFeatures} />

  <Section
    eyebrow="Featured destination"
    heading="Sandwich Harbour"
    theme="photo"
    align="left"
    pin
    imageUrl="https://images.unsplash.com/photo-1666837147745-1c9dea9908a4?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1920"
    imageCredit={{ name: 'Joshua Kettle', username: 'joshuakettle' }}
  >
    <p>
      Where towering dunes plunge straight into the Atlantic — a 4x4 run past
      salt pans and flamingo-filled lagoons to Namibia's most photographed
      meeting of desert and ocean.
    </p>
    <a class="btn btn-outline" href="/tours#tour">Explore this tour</a>
  </Section>

  <section class="tours-teaser reveal">
    <div class="container tours-teaser__intro reveal-item">
      <p class="tours-teaser__eyebrow">Our offering</p>
      <h2>A few of our tours</h2>
      <p class="tours-teaser__body">
        A sample of what we run out of Swakopmund and Walvis Bay — see
        the full lineup, including every adventure and combo deal, on
        the tours page.
      </p>
    </div>

    <div class="tours-teaser__pin">
      <div class="tours-teaser__track">
        {
          teaserTours.map((tour) => (
            <div class="tours-teaser__item">
              <AdventureCard tour={tour} />
            </div>
          ))
        }
      </div>
    </div>

    <div class="container tours-teaser__cta reveal-item">
      <a class="btn btn-outline" href="/tours">View all tours</a>
    </div>
  </section>

  <section class="stats-band reveal">
    <div class="container stats-band__grid">
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number">{tourCount}</p>
        <p class="stats-band__label">Signature tours</p>
      </div>
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number">{adventureCount}</p>
        <p class="stats-band__label">Adventures</p>
      </div>
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number">{comboCount}</p>
        <p class="stats-band__label">Combo deals</p>
      </div>
      <div class="stats-band__stat reveal-item">
        <p class="stats-band__number">2</p>
        <p class="stats-band__label">Home bases — Swakopmund &amp; Walvis Bay</p>
      </div>
    </div>
  </section>

  <section class="homepage-adventures reveal">
    <div class="container homepage-adventures__intro reveal-item">
      <p class="homepage-adventures__eyebrow">Beyond the tours</p>
      <h2>More ways to spend a day</h2>
      <p class="homepage-adventures__body">
        Shorter, activity-based excursions around Swakopmund and Walvis
        Bay — the full lineup, including every combo deal, is on the
        tours page.
      </p>
    </div>

    <div class="container homepage-adventures__grid">
      {adventureTours.map((tour, i) => <AdventureCard tour={tour} featured={i === 0} />)}
    </div>

    <div class="container homepage-adventures__cta reveal-item">
      <a class="btn btn-outline" href="/tours#adventure">See every adventure</a>
    </div>
  </section>

  <section class="gallery reveal">
    <div class="container gallery__intro reveal-item">
      <p class="gallery__eyebrow">A few more moments</p>
      <h2>Namibia, in passing</h2>
    </div>

    <div class="container gallery__grid">
      {
        galleryTours.map((tour) => (
          <figure class="gallery__item reveal-item">
            {tour.imageUrl && <img src={tour.imageUrl} alt={tour.name} loading="lazy" decoding="async" />}
            {tour.imageCredit && (
              <figcaption class="gallery__credit">
                Photo:{' '}
                <a
                  href={`https://unsplash.com/@${tour.imageCredit.username}?utm_source=salt-and-sun-tours&utm_medium=referral`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {tour.imageCredit.name}
                </a>{' '}
                /{' '}
                <a
                  href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Unsplash
                </a>
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </section>

  <ReviewsSection />

  <Section
    eyebrow="Ready when you are"
    heading="Plan your journey"
    align="center"
  >
    <p>
      Ready to see the dunes, the coastline, and everything in between?
      Get in touch and we'll help you build the right day — or days —
      around Swakopmund and Walvis Bay.
    </p>
    <a class="btn btn-primary" href="/booking">Start booking</a>
  </Section>
</BaseLayout>

<style>
  /* ---------- Hero -> About curved scroll reveal ---------- */
  /* A dark curved shape overlaps the top of the About section on load
     (via the negative margin pulling it up so it consumes no extra
     document height), then peels away as the visitor scrolls past the
     hero, tied to scroll position via GSAP scrub — see
     setupHeroSectionReveal() in scripts/motion.ts. Reduced motion just
     hides it outright so About is visible immediately, no animation. */
  .scroll-reveal {
    position: relative;
    height: 42vh;
    min-height: 260px;
    margin-bottom: -42vh;
    z-index: 5;
    overflow: visible;
    pointer-events: none;
  }

  .scroll-reveal__shape {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 0%;
    will-change: transform;
  }

  .scroll-reveal__shape path {
    fill: var(--color-earth-900);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .scroll-reveal {
      height: 30vh;
      min-height: 170px;
      margin-bottom: -30vh;
    }
  }

  .tours-teaser {
    /* Generous top space specifically: the section right above this one
       (Skeleton Coast) is itself a pinned/scrubbed scroll effect, and the
       cards below are a second one (see setupToursTeaserSlide()). Without
       real breathing room here the two scroll-jacked moments run straight
       into each other with no normal scrolling in between. */
    padding-block: clamp(6rem, 14vw, 11rem) var(--space-2xl);
  }

  .tours-teaser__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-2xl);
  }

  .tours-teaser__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .tours-teaser__body {
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Edge-to-edge horizontal slider. Base state is a plain scrollable row
     (works with no JS, under reduced motion, and on touch/mobile); the
     motion controller upgrades it to a scroll-pinned slide on desktop
     when the visitor hasn't asked for reduced motion — see
     setupToursTeaserSlide() in scripts/motion.ts. */
  .tours-teaser__pin {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .tours-teaser__pin::-webkit-scrollbar {
    display: none;
  }

  .tours-teaser__pin--pinned {
    overflow: hidden;
  }

  .tours-teaser__track {
    display: flex;
    gap: var(--space-lg);
    width: max-content;
    padding-inline: clamp(1.25rem, 4vw, 2.5rem);
    scroll-snap-type: x proximity;
    will-change: transform;
  }

  .tours-teaser__pin--pinned .tours-teaser__track {
    scroll-snap-type: none;
  }

  .tours-teaser__item {
    flex: 0 0 min(78vw, 380px);
    height: 420px;
    scroll-snap-align: start;
  }

  .tours-teaser__item :global(.adventure-card) {
    width: 100%;
    height: 100%;
  }

  .tours-teaser__cta {
    text-align: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 640px) {
    .tours-teaser__item {
      height: 340px;
    }
  }

  /* ---------- Stats band ---------- */
  .stats-band {
    padding-block: var(--space-xl);
  }

  .stats-band__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    text-align: center;
  }

  .stats-band__number {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    color: var(--color-accent-strong);
    margin: 0;
  }

  .stats-band__label {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    margin: var(--space-3xs) 0 0;
  }

  @media (max-width: 760px) {
    .stats-band__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg) var(--space-md);
    }
  }

  /* ---------- Homepage adventures grid ---------- */
  .homepage-adventures {
    padding-block: var(--space-2xl);
  }

  .homepage-adventures__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .homepage-adventures__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .homepage-adventures__body {
    color: var(--color-text-muted);
    margin: 0;
  }

  .homepage-adventures__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 240px;
    grid-auto-flow: dense;
    gap: var(--space-md);
  }

  /* Hover tilt — see setupAdventureTilt() in scripts/motion.ts, which
     drives the rotate/scale transform itself; this just handles the
     shadow lift and keeps the tilted card above its neighbors. */
  .homepage-adventures__grid :global(.adventure-card) {
    transition: box-shadow var(--duration-base) var(--ease-out);
  }

  .homepage-adventures__grid :global(.adventure-card.is-tilting) {
    box-shadow: var(--shadow-lg);
    z-index: 1;
  }

  .homepage-adventures__cta {
    text-align: center;
    margin-top: var(--space-xl);
  }

  @media (max-width: 960px) {
    .homepage-adventures__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .homepage-adventures__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Gallery ---------- */
  .gallery {
    padding-block: var(--space-2xl);
  }

  .gallery__intro {
    text-align: center;
    max-width: var(--content-width-narrow);
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .gallery__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  /* True masonry via CSS columns instead of a fixed-height grid — each
     photo keeps its natural aspect ratio (Unsplash serves these at a set
     width with height left to scale, so ratios genuinely vary) rather
     than being cropped into identical boxes. */
  .gallery__grid {
    columns: 4;
    column-gap: var(--space-sm);
  }

  .gallery__item {
    position: relative;
    margin: 0 0 var(--space-sm);
    overflow: hidden;
    border-radius: var(--radius-md);
    break-inside: avoid;
  }

  .gallery__item img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .gallery__item:hover img {
    transform: scale(1.06);
  }

  .gallery__credit {
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    z-index: 1;
    margin: 0;
    font-size: 0.65rem;
    color: rgba(251, 247, 241, 0.75);
  }

  .gallery__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 960px) {
    .gallery__grid {
      columns: 2;
    }
  }

  @media (max-width: 640px) {
    .gallery__grid {
      columns: 1;
    }
  }
</style>
