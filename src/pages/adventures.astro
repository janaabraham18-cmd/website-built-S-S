---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tourBySlug, categoryLabels } from '../data/tours';
import type { Tour } from '../data/tours';
import { hl } from '../utils/text';

// Adventures read as two themed chapters rather than one dense wall. Each
// chapter is a compact name index next to one large shared photo — picking
// a name (hover, focus, or tap) swaps the photo and caption beside it — so
// the emphasis lands on the photography instead of on 13 identically-sized
// tiles. `spotlight` is just the first, most-requested name in that
// chapter's list — the one shown by default before anyone's picked anything.
interface AdventureGroup {
  key: string;
  eyebrow: string;
  intro: string;
  items: Tour[];
}

const adventureGroupDefs = [
  {
    key: 'dunes',
    eyebrow: 'On the Dunes',
    intro: 'Quad bikes, boards, and fat-tyre bikes — the classic Swakopmund dune activities.',
    slugs: ['quad-bike-tour', 'explorer-tour', 'breakfast-run', 'special-quad-90min', 'sandboarding', 'fat-bike-tour'],
  },
  {
    key: 'sky-sea',
    eyebrow: 'Sky, Sea & Culture',
    intro: 'From 10,000 feet to sea level, plus the slower-paced days built around the coast’s people and wildlife.',
    slugs: ['tandem-skydive', 'paragliding', 'kayaking', 'fishing', 'sandwich-harbour-half-day', 'camel-ride', 'township-tour'],
  },
];

interface AdventureGroupWithBanner extends AdventureGroup {
  bannerUrl: string;
  bannerCredit: { name: string; username: string } | undefined;
}

// Each chapter's banner reuses its own spotlight tour's photo at a wider
// crop — real photography already sourced for that activity, not a new
// stock image, so the banner and the list beneath it always show the same
// place/activity rather than two disconnected photos.
const adventureGroups: AdventureGroupWithBanner[] = adventureGroupDefs
  .map((g) => {
    const items = g.slugs.map((s) => tourBySlug(s)).filter((t): t is Tour => !!t);
    if (!items.length) return null;
    const spotlight = items[0];
    return {
      key: g.key,
      eyebrow: g.eyebrow,
      intro: g.intro,
      items,
      bannerUrl: spotlight.imageUrl!.replace('w=900', 'w=2200'),
      bannerCredit: spotlight.imageCredit,
    };
  })
  .filter((g): g is AdventureGroupWithBanner => !!g);

const totalActivities = adventureGroups.reduce((n, g) => n + g.items.length, 0);

const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;

const heroPhoto = {
  url: 'https://images.unsplash.com/photo-1534639809741-2444a584d307?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2400',
  credit: { name: 'Anqi Lu', username: 'anqilu' },
};

// Reuses the Sandboarding photo already in the "On the Dunes" list above —
// same reasoning as the chapter banners: real photography from this page's
// own activities, not a newly sourced stock image.
const closingBg = {
  url: 'https://images.unsplash.com/photo-1715876068166-51cffcbb0405?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Jorge Otero', username: 'oterex' },
};
---

<BaseLayout
  title="Adventures"
  description="Quad bikes, sandboarding, skydiving, kayaking and more — an hour or an afternoon of activity-based excursions around Swakopmund and Walvis Bay with Salt and Sun Tours."
>
  <div class="adventures-page">
    <section class="adventures-hero">
      <div class="adventures-hero__bg" style={`background-image:url('${heroPhoto.url}')`} aria-hidden="true"></div>
      <div class="adventures-hero__scrim" aria-hidden="true"></div>

      <div class="container adventures-hero__content">
        <p class="adventures-hero__eyebrow">Closer to Town</p>
        <h1>Adventures</h1>
        <p class="adventures-hero__subhead">
          {categoryLabels.adventure.description} Quad bikes, sandboarding, skydiving,
          kayaking and more — all a short drive from Swakopmund or Walvis Bay, whenever
          a full day isn't what you're after.
        </p>
        <a class="btn btn-primary" href="#adventures">Start exploring</a>
      </div>

      {heroPhoto.credit && (
        <p class="adventures-hero__credit">
          Photo:{' '}
          <a href={creditHref(heroPhoto.credit.username)} target="_blank" rel="noopener noreferrer">
            {heroPhoto.credit.name}
          </a>{' '}
          / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
        </p>
      )}
    </section>

    <section class="adventures-stats reveal" aria-label="Quick facts">
      <div class="container adventures-stats__row reveal-item">
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">{totalActivities}</p>
          <p class="adventures-stats__label">Activities</p>
        </div>
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">10,000<span>ft</span></p>
          <p class="adventures-stats__label">Skydive altitude</p>
        </div>
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">220<span>km/h</span></p>
          <p class="adventures-stats__label">Freefall speed</p>
        </div>
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">30<span>min</span></p>
          <p class="adventures-stats__label">Shortest activity</p>
        </div>
      </div>
    </section>

    <section class="adventures-section reveal" id="adventures">
      <div class="container">
        <div class="section-intro reveal-item">
          <h2 class="adventures-heading">
            Pick your <span class="accent-word">adventure</span>
            <svg class="adventures-heading__line" data-heading-line width="150" height="20" viewBox="0 0 150 20" aria-hidden="true">
              <path d="M2 12 C 26 2, 48 19, 74 10 S 124 2, 148 12" fill="none" stroke="var(--color-accent-strong)" stroke-width="3" stroke-linecap="round" />
            </svg>
          </h2>
          <p class="section-intro__hint">Pick a name, watch the photo change.</p>
        </div>

        {
          adventureGroups.map((group) => (
            <div class="adventure-group">
              <div class="adventure-group__banner reveal-item">
                <img
                  class="adventure-group__banner-img"
                  src={group.bannerUrl}
                  alt=""
                  loading="lazy"
                  decoding="async"
                />
                <div class="adventure-group__banner-gradient" aria-hidden="true" />
                <div class="adventure-group__banner-content">
                  <p class="adventure-group__eyebrow">{group.eyebrow}</p>
                  <p class="adventure-group__intro">{group.intro}</p>
                </div>
                {group.bannerCredit && (
                  <p class="adventure-group__banner-credit">
                    Photo:{' '}
                    <a href={creditHref(group.bannerCredit.username)} target="_blank" rel="noopener noreferrer">
                      {group.bannerCredit.name}
                    </a>{' '}
                    / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                  </p>
                )}
              </div>

              <div class="adventure-index reveal-item" data-adventure-index>
                <div class="adventure-index__list-wrap">
                  <p class="adventure-index__list-label">{group.items.length} activities — tap one to preview ↓</p>
                  <div class="adventure-index__list">
                  {group.items.map((tour, i) => (
                    <button
                      type="button"
                      class:list={['adventure-index__item', i === 0 && 'is-active']}
                      data-index-item
                      data-slug={tour.slug}
                      data-name={tour.name}
                      data-duration={tour.duration ?? ''}
                      data-desc={tour.description}
                      data-img={tour.imageUrl}
                      data-credit-name={tour.imageCredit?.name ?? ''}
                      data-credit-username={tour.imageCredit?.username ?? ''}
                      aria-current={i === 0 ? 'true' : 'false'}
                    >
                      <span class="adventure-index__mark" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                          <path d="M2 11c3-6 7-8 12-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                        </svg>
                      </span>
                      <span class="adventure-index__name">{tour.name}</span>
                      {i === 0 && <span class="adventure-index__badge">Most requested</span>}
                      {tour.duration && <span class="adventure-index__duration">{tour.duration}</span>}
                    </button>
                  ))}
                  </div>
                </div>

                <div class="adventure-index__preview" data-index-preview>
                  <div class="photo-frame adventure-index__photo">
                    <img data-preview-img src={group.items[0].imageUrl} alt={group.items[0].name} loading="lazy" decoding="async" />
                    <p class="adventure-index__credit" data-preview-credit hidden={!group.items[0].imageCredit}>
                      Photo:{' '}
                      <a data-preview-credit-name href={group.items[0].imageCredit ? creditHref(group.items[0].imageCredit.username) : '#'} target="_blank" rel="noopener noreferrer">
                        {group.items[0].imageCredit?.name}
                      </a>{' '}
                      / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
                    </p>
                  </div>
                  <div class="adventure-index__preview-body">
                    <p class="adventure-index__preview-duration" data-preview-duration hidden={!group.items[0].duration}>{group.items[0].duration}</p>
                    <h3 data-preview-name>{group.items[0].name}</h3>
                    <p data-preview-desc>{group.items[0].description}</p>
                    <a class="book-link" data-preview-cta href={`/booking?tour=${group.items[0].slug}`}>Book this →</a>
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="adventures-closing reveal">
      <div class="adventures-closing__bg" style={`background-image:url('${closingBg.url}')`} aria-hidden="true"></div>
      <div class="adventures-closing__scrim" aria-hidden="true"></div>
      <div class="container adventures-closing__inner reveal-item">
        <h2 set:html={hl('Want to pair this with a full day out?', 'pair')} />
        <p>Combine an adventure with one of our signature tours into a single day, or chart something entirely your own.</p>
        <div class="adventures-closing__ctas">
          <a class="btn btn-primary" href="/tours#build-your-own">Build a combo</a>
          <a class="btn btn-outline" href="/booking">Start booking</a>
        </div>
      </div>
      {closingBg.credit && (
        <p class="adventures-closing__credit">
          Photo:{' '}
          <a href={creditHref(closingBg.credit.username)} target="_blank" rel="noopener noreferrer">
            {closingBg.credit.name}
          </a>{' '}
          / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
        </p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .adventures-page {
    position: relative;
    z-index: 0;
  }

  /* ---------- Adventures hero ---------- */
  /* Full-strength photo, text sits directly on it (no boxed card) — a
     gradient darkens the bottom of the photo, where the text sits (the
     section is bottom-aligned), and text-shadow backs it up further. */
  .adventures-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background-color: var(--color-earth-700);
  }

  .adventures-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center 40%;
  }

  .adventures-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(0deg, rgba(31, 18, 14, 0.85) 0%, rgba(31, 18, 14, 0.35) 45%, rgba(31, 18, 14, 0) 80%);
  }

  .adventures-hero__content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    padding-block: var(--space-2xl);
  }

  .adventures-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 var(--space-sm);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .adventures-hero__content h1 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-md);
  }

  .adventures-hero__subhead {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin: 0 0 var(--space-lg);
  }

  .adventures-hero__credit {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-md);
    z-index: 1;
    margin: 0;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .adventures-hero__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .adventures-hero__content {
      max-width: none;
    }
  }

  /* ---------- Quick-facts strip ---------- */
  /* A punchy row of real numbers (skydive altitude, freefall speed, the
     shortest activity on offer) right where the hero hands off — instant
     proof this page has energy before anyone scrolls to the list. */
  .adventures-stats {
    background: var(--color-earth-900);
    padding-block: var(--space-lg);
  }

  .adventures-stats__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .adventures-stats__stat {
    text-align: center;
    padding-inline: var(--space-sm);
    border-left: 1px solid rgba(251, 247, 241, 0.15);
  }

  .adventures-stats__stat:first-child {
    border-left: none;
  }

  .adventures-stats__num {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--color-heading-accent);
    margin: 0;
    line-height: 1;
  }

  .adventures-stats__num span {
    font-size: 0.55em;
    font-weight: 600;
    margin-left: 0.2em;
    color: var(--color-ochre-400);
  }

  .adventures-stats__label {
    margin: 0.4rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-sand-200);
  }

  @media (max-width: 640px) {
    .adventures-stats__row {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md) var(--space-sm);
    }

    .adventures-stats__stat:nth-child(3) {
      border-left: none;
    }
  }

  .section-intro {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-xl);
  }

  .section-intro h2 {
    margin: 0 0 var(--space-2xs);
  }

  .section-intro p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-intro__hint {
    font-size: 0.85rem;
    font-style: italic;
    margin-top: var(--space-2xs) !important;
  }

  .adventures-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .adventures-heading__line {
    display: block;
  }

  .adventures-heading__line path {
    vector-effect: non-scaling-stroke;
  }

  /* ---------- Adventures index ---------- */
  /* Dark chapter treatment (same as About Us/Our Fleet/booking elsewhere
     on the site) so the page's main content reads as a distinct, focused
     zone rather than a plain continuation of the hero. */
  .adventures-section {
    padding-block: var(--space-2xl);
    scroll-margin-top: 5rem;
    background: var(--color-earth-700);
    background-image: var(--gradient-dusk);
    color: var(--color-text-on-dark);
  }

  .adventures-section h2 {
    color: var(--color-text-on-dark);
  }

  .adventures-section .section-intro p {
    color: var(--color-sand-200);
  }

  .adventures-section .book-link {
    color: var(--color-text-on-dark);
  }

  .adventure-group {
    margin-bottom: var(--space-2xl);
  }

  .adventure-group:last-child {
    margin-bottom: 0;
  }

  /* Each chapter opens with its own full-width photo banner (the
     spotlight tour's own photo, shown large) instead of a plain text
     row — a real, specific image sets the tone for that chapter before
     the name list even loads, which reads as far more alive than an
     eyebrow + one line of copy ever could. */
  .adventure-group__banner {
    position: relative;
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    aspect-ratio: 21 / 9;
  }

  .adventure-group__banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .adventure-group__banner-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      rgba(31, 18, 14, 0.92) 0%,
      rgba(31, 18, 14, 0.6) 40%,
      rgba(31, 18, 14, 0.15) 75%
    );
  }

  .adventure-group__banner-content {
    position: relative;
    z-index: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2xs);
    max-width: 26rem;
    padding: var(--space-lg) var(--space-xl);
  }

  .adventure-group__eyebrow {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-on-dark);
    margin: 0;
  }

  .adventure-group__intro {
    font-size: 0.95rem;
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    margin: 0;
  }

  .adventure-group__banner-credit {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    z-index: 1;
    margin: 0;
    font-size: 0.65rem;
    color: rgba(251, 247, 241, 0.75);
  }

  .adventure-group__banner-credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .adventure-group__banner {
      aspect-ratio: 4 / 5;
    }

    .adventure-group__banner-gradient {
      background: linear-gradient(
        0deg,
        rgba(31, 18, 14, 0.92) 0%,
        rgba(31, 18, 14, 0.55) 55%,
        rgba(31, 18, 14, 0.1) 85%
      );
    }

    .adventure-group__banner-content {
      justify-content: flex-end;
      max-width: none;
    }
  }

  /* ---------- Adventures index + preview ---------- */
  /* A compact name list beside one large shared photo, instead of a wall
     of same-sized cards — picking a name (hover/focus/tap) swaps the
     photo and caption next to it. List stays before the preview in DOM
     order (a control before what it controls), independent of which
     visually sits first at each breakpoint. */
  .adventure-index {
    display: grid;
    grid-template-columns: minmax(240px, 320px) 1fr;
    grid-template-areas: 'list preview';
    gap: var(--space-xl);
    align-items: start;
  }

  .adventure-index__list-wrap {
    grid-area: list;
  }

  .adventure-index__list-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-ochre-400);
    margin: 0 0 0.6rem;
  }

  .adventure-index__list {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 0 var(--space-md);
    box-shadow: var(--shadow-sm);
  }

  .adventure-index__item {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.6rem;
    width: 100%;
    background: none;
    border: none;
    border-top: 1px solid var(--color-border);
    padding: 0.85rem 0.1rem;
    margin: 0;
    font-family: var(--font-body);
    text-align: left;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .adventure-index__item:first-child {
    border-top: none;
  }

  .adventure-index__item:hover,
  .adventure-index__item:focus-visible,
  .adventure-index__item.is-active {
    color: var(--color-accent-strong);
  }

  .adventure-index__mark {
    flex-shrink: 0;
    display: flex;
    color: var(--color-border);
    opacity: 0.7;
    transition: color var(--duration-fast) var(--ease-out), opacity var(--duration-fast) var(--ease-out);
  }

  .adventure-index__item:hover .adventure-index__mark,
  .adventure-index__item:focus-visible .adventure-index__mark,
  .adventure-index__item.is-active .adventure-index__mark {
    color: var(--color-accent-strong);
    opacity: 1;
  }

  .adventure-index__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .adventure-index__item:hover .adventure-index__name,
  .adventure-index__item:focus-visible .adventure-index__name,
  .adventure-index__item.is-active .adventure-index__name {
    color: var(--color-accent-strong);
  }

  .adventure-index__badge {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-accent-strong);
    background: var(--color-sand-100);
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
  }

  .adventure-index__duration {
    margin-left: auto;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .adventure-index__preview {
    grid-area: preview;
  }

  .adventure-index__photo {
    position: relative;
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-md);
  }

  .adventure-index__credit {
    position: absolute;
    right: var(--space-2xs);
    bottom: var(--space-2xs);
    z-index: 1;
    margin: 0;
    font-size: 0.65rem;
    color: rgba(251, 247, 241, 0.85);
  }

  .adventure-index__credit a {
    color: inherit;
    text-decoration: underline;
