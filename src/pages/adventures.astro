---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdventureCard from '../components/AdventureCard.astro';
import { tourBySlug, categoryLabels } from '../data/tours';
import type { Tour } from '../data/tours';
import { hl } from '../utils/text';

// Adventures read as two themed chapters, each a photo-grid of cards (the
// same AdventureCard used in the component preview) rather than the old
// "pick a name, watch one shared photo change" index — every activity gets
// its own always-visible photo instead of 12 of the 13 staying hidden
// behind a click. The first item in each chapter's slug list is its
// most-requested/flagship activity, shown as the larger `featured` card so
// the grid still has visual hierarchy instead of 13 identical tiles.
interface AdventureGroup {
  key: string;
  eyebrow: string;
  accentWord: string;
  intro: string;
  items: Tour[];
}

const adventureGroupDefs = [
  {
    key: 'dunes',
    eyebrow: 'On the Dunes',
    accentWord: 'Dunes',
    intro: 'Quad bikes, boards, and fat-tyre bikes — the classic Swakopmund dune activities.',
    // Only two quad-bike options shown here (of the four in the data) —
    // the flexible standard ride and the sunset/champagne upgrade cover
    // the real choice a guest is making; Explorer Tour and Breakfast Run
    // are the same base activity with a different add-on, which read as
    // near-duplicates side by side in a photo grid.
    slugs: ['quad-bike-tour', 'special-quad-90min', 'sandboarding', 'fat-bike-tour'],
  },
  {
    key: 'sky-sea',
    eyebrow: 'Sky, Sea & Culture',
    accentWord: 'Sky',
    intro: 'From 10,000 feet to sea level, plus the slower-paced days built around the coast’s people and wildlife.',
    slugs: ['tandem-skydive', 'paragliding', 'kayaking', 'fishing', 'sandwich-harbour-half-day', 'camel-ride', 'township-tour'],
  },
];

const adventureGroups: AdventureGroup[] = adventureGroupDefs
  .map((g) => {
    const items = g.slugs.map((s) => tourBySlug(s)).filter((t): t is Tour => !!t);
    if (!items.length) return null;
    return { key: g.key, eyebrow: g.eyebrow, accentWord: g.accentWord, intro: g.intro, items };
  })
  .filter((g): g is AdventureGroup => !!g);

const totalActivities = adventureGroups.reduce((n, g) => n + g.items.length, 0);

const heroPhoto = {
  url: 'https://images.unsplash.com/photo-1534639809741-2444a584d307?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2400',
  credit: { name: 'Anqi Lu', username: 'anqilu' },
};

// Reuses the Sandboarding photo already in the "On the Dunes" list above —
// same reasoning as the chapter banners: real photography from this page's
// own activities, not a newly sourced stock image.
const closingBg = {
  url: 'https://images.unsplash.com/photo-1715876068166-51cffcbb0405?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Jorge Otero', username: 'oterex' },
};
---

<BaseLayout
  title="Adventures"
  description="Quad bikes, sandboarding, skydiving, kayaking and more — an hour or an afternoon of activity-based excursions around Swakopmund and Walvis Bay with Salt and Sun Tours."
>
  <div class="adventures-page">
    <section class="adventures-hero">
      <div class="adventures-hero__bg" style={`background-image:url('${heroPhoto.url}')`} aria-hidden="true"></div>
      <div class="adventures-hero__scrim" aria-hidden="true"></div>

      <div class="container adventures-hero__content">
        <p class="adventures-hero__eyebrow">Closer to Town</p>
        <h1>Adventures</h1>
        <p class="adventures-hero__subhead">
          {categoryLabels.adventure.description} Quad bikes, sandboarding, skydiving,
          kayaking and more — all a short drive from Swakopmund or Walvis Bay, whenever
          a full day isn't what you're after.
        </p>
        <a class="btn btn-primary" href="#adventures">Start exploring</a>

        <p class="adventures-hero__promo">
          No full day required.
          <span>Quad bikes, skydives, and sandboard runs — book by the hour, remember for years.</span>
        </p>
      </div>
    </section>

    <section class="adventures-stats reveal" aria-label="Quick facts">
      <div class="container adventures-stats__row reveal-item">
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">{totalActivities}</p>
          <p class="adventures-stats__label">Activities</p>
        </div>
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">10,000<span>ft</span></p>
          <p class="adventures-stats__label">Skydive altitude</p>
        </div>
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">220<span>km/h</span></p>
          <p class="adventures-stats__label">Freefall speed</p>
        </div>
        <div class="adventures-stats__stat">
          <p class="adventures-stats__num">30<span>min</span></p>
          <p class="adventures-stats__label">Shortest activity</p>
        </div>
      </div>
    </section>

    <section class="adventures-section reveal" id="adventures">
      <div class="container">
        <div class="section-intro reveal-item">
          <h2 class="adventures-heading">
            Pick your <span class="accent-word">adventure</span>
            <svg class="adventures-heading__line" data-heading-line width="150" height="20" viewBox="0 0 150 20" aria-hidden="true">
              <path d="M2 12 C 26 2, 48 19, 74 10 S 124 2, 148 12" fill="none" stroke="var(--color-accent-strong)" stroke-width="3" stroke-linecap="round" />
            </svg>
          </h2>
        </div>

        {
          adventureGroups.map((group) => (
            <div class="adventure-group">
              <div class="adventure-group__header reveal-item">
                <p class="eyebrow">{group.items.length} Activities</p>
                <h3 set:html={hl(group.eyebrow, group.accentWord)} />
                <p class="adventure-group__intro">{group.intro}</p>
              </div>

              <div class="adventure-grid reveal-item">
                {group.items.map((tour, i) => (
                  <AdventureCard tour={tour} featured={i === 0} />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="adventures-closing reveal">
      <div class="adventures-closing__bg" style={`background-image:url('${closingBg.url}')`} aria-hidden="true"></div>
      <div class="adventures-closing__scrim" aria-hidden="true"></div>
      <div class="container adventures-closing__inner reveal-item">
        <h2 set:html={hl('Want to pair this with a full day out?', 'pair')} />
        <p>Combine an adventure with one of our signature tours into a single day, or chart something entirely your own.</p>
        <div class="adventures-closing__ctas">
          <a class="btn btn-primary" href="/tours#build-your-own">Build a combo</a>
          <a class="btn btn-outline" href="/booking">Start booking</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .adventures-page {
    position: relative;
    z-index: 0;
  }

  /* ---------- Adventures hero ---------- */
  /* Full-strength photo, text sits directly on it (no boxed card) — text
     sits top-left (same treatment as the Journeys hero), backed by a
     gradient that darkens the top of the photo and clears toward the
     bottom, plus text-shadow on the text itself. */
  .adventures-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: flex-start;
    overflow: hidden;
    background-color: var(--color-earth-700);
  }

  .adventures-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-size: cover;
    background-position: center 40%;
  }

  .adventures-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.85) 0%, rgba(31, 18, 14, 0.35) 45%, rgba(31, 18, 14, 0) 80%);
  }

  .adventures-hero__content {
    position: relative;
    z-index: 1;
    max-width: 30rem;
    padding-block: var(--space-2xl);
    margin-inline: 0;
    padding-left: clamp(1.5rem, 6vw, 5rem);
  }

  .adventures-hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin: 0 0 var(--space-sm);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .adventures-hero__content h1 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-md);
  }

  .adventures-hero__subhead {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin: 0 0 var(--space-lg);
  }

  /* Fills the open photo space below the button on wider screens — a
     bold, punchy line plus a short supporting sentence, not a second
     heading, so it stays plain white/sand text (no accent color, no
     card) per the heading-accent and no-card-over-photo rules. */
  .adventures-hero__promo {
    margin: var(--space-2xl) 0 0;
    padding-top: var(--space-lg);
    border-top: 1px solid rgba(245, 232, 216, 0.25);
    font-family: var(--font-display-italic);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2.1rem);
    line-height: 1.25;
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .adventures-hero__promo span {
    display: block;
    margin-top: var(--space-sm);
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 400;
    font-size: var(--fs-base);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 640px) {
    .adventures-hero__content {
      max-width: none;
    }

    .adventures-hero__promo {
      margin-top: var(--space-xl);
      font-size: 1.35rem;
    }
  }

  /* ---------- Quick-facts strip ---------- */
  /* A punchy row of real numbers (skydive altitude, freefall speed, the
     shortest activity on offer) right where the hero hands off — instant
     proof this page has energy before anyone scrolls to the list. White,
     like the rest of the page's non-photo backgrounds — a thin bottom
     border is the only seam between this and the section below. */
  .adventures-stats {
    background: var(--color-surface);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .adventures-stats__row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-md);
  }

  .adventures-stats__stat {
    text-align: center;
    padding-inline: var(--space-sm);
    border-left: 1px solid var(--color-border);
  }

  .adventures-stats__stat:first-child {
    border-left: none;
  }

  .adventures-stats__num {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 700;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    color: var(--color-heading-accent);
    margin: 0;
    line-height: 1;
  }

  .adventures-stats__num span {
    font-size: 0.55em;
    font-weight: 600;
    margin-left: 0.2em;
    color: var(--color-ochre-400);
  }

  .adventures-stats__label {
    margin: 0.4rem 0 0;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .adventures-stats__row {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md) var(--space-sm);
    }

    .adventures-stats__stat:nth-child(3) {
      border-left: none;
    }
  }

  .section-intro {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-xl);
  }

  .section-intro h2 {
    margin: 0 0 var(--space-2xs);
  }

  .adventures-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .adventures-heading__line {
    display: block;
  }

  .adventures-heading__line path {
    vector-effect: non-scaling-stroke;
  }

  /* ---------- Adventures listing ---------- */
  /* White, like the rest of the page's non-photo backgrounds — the hero
     photo and the closing photo band are the only places colour/darkness
     carries the page now. */
  .adventures-section {
    padding-block: var(--space-2xl);
    scroll-margin-top: 5rem;
    background: var(--color-surface);
  }

  .adventure-group {
    margin-bottom: var(--space-2xl);
  }

  .adventure-group:last-child {
    margin-bottom: 0;
  }

  /* Plain text header per chapter — no photo banner. Real photography
     lives on every card in the grid below now (not just one shared
     spotlight image), so a banner here would just repeat a photo already
     shown a moment later at a smaller, one-of-several size. */
  .adventure-group__header {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-md);
  }

  .adventure-group__header h3 {
    margin: 0 0 var(--space-2xs);
  }

  .adventure-group__intro {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Same grid rhythm as the AdventureCard component preview: a photo grid
     with one larger `featured` card per chapter (its flagship activity)
     for visual hierarchy, everything else an equal-weight tile — fills
     the page with real photography without 13 identically-sized tiles
     competing for attention at once. */
  /* Photo + caption now sizes itself (no more fixed-height tiles with
     text overlaid inside), so this is a plain auto-height grid — the
     featured card spans two columns for a wider photo instead of
     spanning two rows. minmax(0, 1fr), not plain 1fr: a bare 1fr track
     won't shrink below its content's min-content width, so one card
     with an unusually long duration string (nowrap, by design) would
     blow out its whole column — and every other card sharing that
     column index, in any row. */
  .adventure-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg) var(--space-md);
  }

  @media (max-width: 960px) {
    .adventure-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .adventure-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* ---------- Closing ---------- */
  /* Same "fully defined" background-photo treatment as the rest of the
     site: full-strength photo, text sits directly on it (no boxed card)
     backed by a soft gradient wash and text-shadow, so the page ends on
     the same energy it opened with instead of fading to a flat band. */
  .adventures-closing {
    position: relative;
    z-index: 0;
    overflow: hidden;
    background: var(--color-earth-700);
    padding-block: var(--space-2xl);
  }

  .adventures-closing__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
  }

  .adventures-closing__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.62) 0%, rgba(31, 18, 14, 0.42) 100%);
  }

  .adventures-closing__inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .adventures-closing__inner h2 {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    margin: 0 0 var(--space-2xs);
  }

  .adventures-closing__inner p {
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    margin: 0 0 var(--space-lg);
  }

  .adventures-closing__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }

</style>
