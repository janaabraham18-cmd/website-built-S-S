---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourCard from '../components/TourCard.astro';
import AdventureCard from '../components/AdventureCard.astro';
import { toursByCategory, categoryLabels } from '../data/tours';

const heroTours = toursByCategory('tour');
const adventures = toursByCategory('adventure');
const combos = toursByCategory('combo');

const featuredAdventureSlugs = new Set([
  'quad-bike-tour',
  'dolphin-seal-catamaran-cruise',
  'tandem-skydive',
]);

const featuredComboSlugs = new Set(['surf-and-turf', 'unity-combo']);
---

<BaseLayout
  title="Tours & Adventures"
  description="The full lineup of tours, adventures, and combo deals from Salt & Sun Tours in Swakopmund and Walvis Bay, Namibia."
>
  <header class="tours-header">
    <div class="container">
      <p class="tours-header__eyebrow">Salt &amp; Sun Tours</p>
      <h1 class="tours-header__heading">Tours &amp; Adventures</h1>
      <p class="tours-header__body">
        Every excursion we run out of Swakopmund and Walvis Bay, from
        full-day trips into Etosha and Sossusvlei to short desert
        adventures and combo packages. Pricing is being finalized and
        will appear here shortly — get in touch for current rates.
      </p>
    </div>
  </header>

  <section class="tour-rows-section grain-overlay" id="tour">
    <div class="container tour-rows-section__intro reveal">
      <p class="tour-rows-section__eyebrow reveal-item">{categoryLabels.tour.label}</p>
      <p class="tour-rows-section__desc reveal-item">{categoryLabels.tour.description}</p>
    </div>

    {heroTours.map((tour, index) => <TourCard tour={tour} reverse={index % 2 === 1} />)}
  </section>

  <section class="adventure-section grain-overlay" id="adventure">
    <div class="container">
      <div class="adventure-section__intro reveal">
        <h2 class="reveal-item">{categoryLabels.adventure.label}</h2>
        <p class="reveal-item">{categoryLabels.adventure.description}</p>
      </div>

      <div class="adventure-grid">
        {
          adventures.map((tour) => (
            <AdventureCard tour={tour} featured={featuredAdventureSlugs.has(tour.slug)} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="adventure-section grain-overlay" id="combo">
    <div class="container">
      <div class="adventure-section__intro reveal">
        <h2 class="reveal-item">{categoryLabels.combo.label}</h2>
        <p class="reveal-item">{categoryLabels.combo.description}</p>
      </div>

      <div class="adventure-grid">
        {
          combos.map((tour) => (
            <AdventureCard tour={tour} featured={featuredComboSlugs.has(tour.slug)} />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .tours-header {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .tours-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin-bottom: var(--space-2xs);
  }

  .tours-header__heading {
    margin-bottom: var(--space-md);
  }

  .tours-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-text-muted);
    max-width: var(--content-width-narrow);
  }

  .tour-rows-section {
    scroll-margin-top: 5rem;
  }

  .tour-rows-section__intro {
    padding-block: var(--space-lg);
    max-width: var(--content-width-narrow);
  }

  .tour-rows-section__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-accent-strong);
    margin: 0 0 var(--space-2xs);
  }

  .tour-rows-section__desc {
    color: var(--color-text-muted);
    margin: 0;
  }

  .adventure-section {
    padding-block: var(--space-2xl);
    scroll-margin-top: 5rem;
  }

  .adventure-section__intro {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-lg);
  }

  .adventure-section__intro h2 {
    margin-bottom: var(--space-2xs);
  }

  .adventure-section__intro p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .adventure-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 240px;
    grid-auto-flow: dense;
    gap: var(--space-md);
  }

  @media (max-width: 960px) {
    .adventure-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .adventure-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: 280px;
    }
  }
</style>
