---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourMapJourney from '../components/TourMapJourney.astro';
import { toursByCategory, categoryLabels } from '../data/tours';

// Everything bookable, minus the pre-built combo deals — the raw material for
// the "Create Your Own Combo" builder below. Combos aren't included as
// pickable pieces themselves (combining a combo doesn't make sense).
const builderTours = toursByCategory('tour');
const builderAdventures = toursByCategory('adventure');

const buildComboBg = {
  url: 'https://images.unsplash.com/photo-1761205930562-e176cfa86e64?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Nathalie Lays', username: 'nath_lays' },
};
const creditHref = (username: string) =>
  `https://unsplash.com/@${username}?utm_source=salt-and-sun-tours&utm_medium=referral`;
---

<BaseLayout
  title="Tours & Adventures"
  description="The full lineup of tours, adventures, and combos from Salt and Sun Tours in Swakopmund and Walvis Bay, Namibia."
>
  <TourMapJourney />

  <section class="orientation reveal" id="how-it-works">
    <div class="container orientation__grid">
      <div class="orientation__item reveal-item">
        <span class="orientation__num">01</span>
        <h3>Signature Tours</h3>
        <p>Full-day trips to Namibia's most iconic destinations — see all ten on the map above.</p>
      </div>
      <div class="orientation__item reveal-item">
        <span class="orientation__num">02</span>
        <h3>Adventures</h3>
        <p>Shorter, activity-based excursions around Swakopmund and Walvis Bay — an hour or an afternoon, not a full day.</p>
        <a class="orientation__link" href="/adventures">See all adventures →</a>
      </div>
      <div class="orientation__item reveal-item">
        <span class="orientation__num">03</span>
        <h3>Combos</h3>
        <p>Pair two experiences into one day — or skip ahead and build something entirely your own.</p>
      </div>
    </div>
  </section>

  <section class="build-combo reveal" id="build-your-own">
    <div class="build-combo__bg" style={`background-image:url('${buildComboBg.url}')`} aria-hidden="true"></div>
    <div class="build-combo__wash" aria-hidden="true"></div>

    <div class="container">
      <div class="section-intro reveal-item">
        <p class="eyebrow">Off the Menu</p>
        <h2>Chart Your Own Day</h2>
        <p>The combos above are proven pairings, but they're not the limit. This isn't really about the cheapest way to fit two things into a day — it's your day, so pick whatever actually interests you and we'll chart the itinerary around it.</p>
      </div>

      <div class="combo-builder reveal-item" data-combo-builder>
        <div class="combo-builder__picker">
          <div class="combo-builder__group">
            <p class="combo-builder__group-label">{categoryLabels.tour.label}</p>
            <div class="combo-builder__chips">
              {builderTours.map((tour) => (
                <button
                  type="button"
                  class="combo-builder__chip"
                  data-builder-chip
                  data-slug={tour.slug}
                  data-name={tour.name}
                  data-img={tour.imageUrl}
                  aria-pressed="false"
                >
                  <span class="combo-builder__chip-check" aria-hidden="true">✓</span>
                  {tour.name}
                </button>
              ))}
            </div>
          </div>

          <div class="combo-builder__group">
            <p class="combo-builder__group-label">{categoryLabels.adventure.label}</p>
            <div class="combo-builder__chips">
              {builderAdventures.map((tour) => (
                <button
                  type="button"
                  class="combo-builder__chip"
                  data-builder-chip
                  data-slug={tour.slug}
                  data-name={tour.name}
                  data-img={tour.imageUrl}
                  aria-pressed="false"
                >
                  <span class="combo-builder__chip-check" aria-hidden="true">✓</span>
                  {tour.name}
                </button>
              ))}
            </div>
          </div>
        </div>

        <div class="combo-builder__preview">
          <p class="combo-builder__count" data-builder-count role="status" aria-live="polite">
            Pick at least 2 to build your combo
          </p>

          <div class="combo-builder__pairs" data-builder-pairs>
            {Array.from({ length: 8 }).map((_, i) => (
              <div class="combo-builder__pair-slot" data-pair-slot={i} hidden>
                <span class="combo-builder__plus" aria-hidden="true">+</span>
                <div class="photo-frame photo-frame--sm combo-builder__pair-photo">
                  <img data-pair-img alt="" loading="lazy" decoding="async" />
                </div>
                <p class="combo-builder__pair-name" data-pair-name></p>
              </div>
            ))}
          </div>

          <a class="btn btn-primary combo-builder__cta" data-builder-cta href="#" aria-disabled="true">
            Book my combo
          </a>
          <p class="combo-builder__fallback">
            Not sure yet? <a href="/contact">Just tell us what you're dreaming of →</a>
          </p>
        </div>
      </div>
    </div>

    {buildComboBg.credit && (
      <p class="build-combo__credit">
        Photo:{' '}
        <a href={creditHref(buildComboBg.credit.username)} target="_blank" rel="noopener noreferrer">
          {buildComboBg.credit.name}
        </a>{' '}
        / <a href="https://unsplash.com/?utm_source=salt-and-sun-tours&utm_medium=referral" target="_blank" rel="noopener noreferrer">Unsplash</a>
      </p>
    )}
  </section>

  <section class="tours-closing reveal">
    <div class="container tours-closing__inner reveal-item">
      <h2>Ready to book, or still deciding?</h2>
      <p>Either way, get in touch — we'll help you build the right day.</p>
      <div class="tours-closing__ctas">
        <a class="btn btn-primary" href="/booking">Start booking</a>
        <a class="btn btn-outline" href="/contact">Ask us a question</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-accent-strong);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .section-intro {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-xl);
  }

  .section-intro h2 {
    margin: 0 0 var(--space-2xs);
  }

  .section-intro p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-intro__hint {
    font-size: 0.85rem;
    font-style: italic;
    margin-top: var(--space-2xs) !important;
  }

  /* ---------- Orientation strip ---------- */
  .orientation {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .orientation__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .orientation__num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-accent-soft);
    margin-bottom: 0.4rem;
  }

  .orientation__item h3 {
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }

  .orientation__item p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 760px) {
    .orientation__grid { grid-template-columns: 1fr; gap: var(--space-md); }
  }

  .orientation__link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent-strong);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .orientation__link:hover {
    border-color: var(--color-accent-strong);
  }

  /* ---------- Create Your Own Combo ---------- */
  /* A real photo behind the section instead of a flat gradient — same
     blurred-photo-plus-wash technique as the map recap band further up
     this same page (TourMapJourney.astro's .tour-recap-band): the eyebrow/
     heading/intro sit directly on top with no card of their own, so the
     photo can't be shown at full strength (not enough contrast for that
     text) — a blur keeps it as texture/mood rather than a sharp
     background someone tries to read, and the translucent wash on top is
     the same warm ochre-to-terracotta gradient the section used before,
     just letting the photo show through it instead of replacing it. */
  .build-combo {
    position: relative;
    z-index: 0;
    overflow: hidden;
    background: var(--color-terracotta-600);
    padding-block: var(--space-2xl);
    scroll-margin-top: 5rem;
  }

  .build-combo__bg {
    position: absolute;
    inset: -40px;
    z-index: -2;
    background-size: cover;
    background-position: center;
    filter: blur(4px);
  }

  .build-combo__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      135deg,
      rgba(211, 162, 79, 0.82) 0%,
      rgba(181, 98, 63, 0.82) 55%,
      rgba(156, 77, 51, 0.85) 100%
    );
  }

  .build-combo__credit {
    position: relative;
    z-index: 1;
    margin: var(--space-sm) 0 0;
    padding: 0 var(--space-md);
    text-align: right;
    font-size: var(--fs-xs);
    color: rgba(251, 247, 241, 0.75);
  }

  .build-combo__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .build-combo .section-intro {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
  }

  .build-combo .eyebrow {
    color: var(--color-text-on-dark);
    opacity: 0.85;
  }

  .build-combo h2 {
    color: var(--color-text-on-dark);
  }

  .build-combo .section-intro p {
    color: var(--color-sand-100);
  }

  .combo-builder {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
    gap: var(--space-xl);
    align-items: start;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-lg);
  }

  .combo-builder__group {
    margin-bottom: var(--space-md);
  }

  .combo-builder__group:last-child {
    margin-bottom: 0;
  }

  .combo-builder__group-label {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--color-accent-strong);
    margin: 0 0 0.6rem;
  }

  .combo-builder__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .combo-builder__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.45rem 0.9rem 0.45rem 0.7rem;
    font-family: var(--font-body);
    font-size: 0.82rem;
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .combo-builder__chip:hover,
  .combo-builder__chip:focus-visible {
    border-color: var(--color-accent-strong);
  }

  .combo-builder__chip-check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    font-size: 0.6rem;
    line-height: 1;
    color: transparent;
    flex-shrink: 0;
    transition: background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .combo-builder__chip.is-selected {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-text-on-dark);
  }

  .combo-builder__chip.is-selected .combo-builder__chip-check {
    background: var(--color-text-on-dark);
    border-color: var(--color-text-on-dark);
    color: var(--color-accent-strong);
  }

  .combo-builder__preview {
    background: var(--color-bg);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    position: sticky;
    top: 5rem;
  }

  .combo-builder__count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
  }

  .combo-builder__pairs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    min-height: 3.5rem;
  }

  .combo-builder__pair-slot[hidden] {
    display: none;
  }

  .combo-builder__pair-slot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .combo-builder__pair-slot:first-child .combo-builder__plus {
    display: none;
  }

  .combo-builder__plus {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--color-accent-strong);
    line-height: 1;
  }

  .combo-builder__pair-photo {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
  }

  .combo-builder__pair-name {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0;
    max-width: 5rem;
  }

  .combo-builder__cta {
    width: 100%;
    margin-top: var(--space-md);
  }

  .combo-builder__cta[aria-disabled='true'] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
  }

  .combo-builder__fallback {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: center;
    margin: var(--space-sm) 0 0;
  }

  @media (max-width: 860px) {
    .combo-builder {
      grid-template-columns: 1fr;
    }

    .combo-builder__preview {
      position: static;
    }
  }

  /* ---------- Closing ---------- */
  /* Final, darkest band in the page's progression — dark enough that
     the default earth-900 body text and text-muted no longer have
     contrast against it, so both flip to the light on-dark tokens here. */
  .tours-closing {
    padding-block: var(--space-2xl);
    background: var(--color-earth-700);
  }

  .tours-closing__inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    color: var(--color-text-on-dark);
  }

  .tours-closing__inner h2 {
    margin: 0 0 var(--space-2xs);
    color: var(--color-text-on-dark);
  }

  .tours-closing__inner p {
    color: var(--color-sand-200);
    margin: 0 0 var(--space-lg);
  }

  .tours-closing__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
