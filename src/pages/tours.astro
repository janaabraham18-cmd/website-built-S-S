---
import BaseLayout from '../layouts/BaseLayout.astro';
import TourMapJourney from '../components/TourMapJourney.astro';
import { hl } from '../utils/text';
---

<BaseLayout
  title="Tours & Adventures"
  description="The full lineup of tours, adventures, and combos from Salt and Sun Tours in Swakopmund and Walvis Bay, Namibia."
>
  <TourMapJourney />

  <section class="orientation reveal" id="how-it-works">
    <div class="container orientation__grid">
      <div class="orientation__item reveal-item">
        <span class="orientation__num">01</span>
        <h3 set:html={hl('Signature Tours', 'Tours')} />
        <p>Full-day trips to Namibia's most iconic destinations — see all ten on the map above.</p>
      </div>
      <div class="orientation__item reveal-item">
        <span class="orientation__num">02</span>
        <h3>Adventures</h3>
        <p>Shorter, activity-based excursions around Swakopmund and Walvis Bay — an hour or an afternoon, not a full day.</p>
        <a class="orientation__link" href="/adventures">See all adventures →</a>
      </div>
      <div class="orientation__item reveal-item">
        <span class="orientation__num">03</span>
        <h3>Combos</h3>
        <p>Pair two experiences into one day — or build something entirely your own when you book.</p>
        <a class="orientation__link" href="/booking#build-your-own">Build a combo →</a>
      </div>
    </div>
  </section>

  <section class="tours-closing reveal">
    <div class="tours-closing__bg" aria-hidden="true"></div>
    <div class="tours-closing__wash" aria-hidden="true"></div>
    <div class="container tours-closing__inner reveal-item">
      <h2 set:html={hl('Ready to book, or still deciding?', 'deciding')} />
      <p>Either way, get in touch — we'll help you build the right day.</p>
      <div class="tours-closing__ctas">
        <a class="btn btn-primary" href="/booking">Start booking</a>
        <a class="btn btn-outline" href="/contact">Ask us a question</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow {
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 600;
    margin-bottom: 0.6rem;
  }

  .section-intro {
    max-width: var(--content-width-narrow);
    margin-bottom: var(--space-xl);
  }

  .section-intro h2 {
    margin: 0 0 var(--space-2xs);
  }

  .section-intro p {
    color: var(--color-text-muted);
    margin: 0;
  }

  .section-intro__hint {
    font-size: 0.85rem;
    font-style: italic;
    margin-top: var(--space-2xs) !important;
  }

  /* ---------- Orientation strip ---------- */
  .orientation {
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-alt);
  }

  .orientation__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-lg);
  }

  .orientation__num {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    color: var(--color-accent-soft);
    margin-bottom: 0.4rem;
  }

  .orientation__item h3 {
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }

  .orientation__item p {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 760px) {
    .orientation__grid { grid-template-columns: 1fr; gap: var(--space-md); }
  }

  .orientation__link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent-strong);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .orientation__link:hover {
    border-color: var(--color-accent-strong);
  }

  /* ---------- Closing ---------- */
  /* Final band in the page's progression — used to be a flat solid
     earth-700 block; now a blurred real photo (the group celebrating in
     the dunes) with a warm translucent wash over it, same oversized
     inset + blur technique as .postcards-block__bg on the home page.
     The wash is lighter than the old flat color but still dark enough
     that the on-dark text tokens below keep their contrast. */
  .tours-closing {
    position: relative;
    z-index: 0;
    overflow: hidden;
    padding-block: var(--space-2xl);
  }

  .tours-closing__bg {
    position: absolute;
    inset: -40px;
    background-image: url('/images/gallery-the-whole-crew.jpg');
    background-size: cover;
    background-position: center;
    filter: blur(5px);
    z-index: -1;
  }

  .tours-closing__wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(107, 58, 44, 0.58);
  }

  .tours-closing__inner {
    max-width: 640px;
    margin-inline: auto;
    text-align: center;
    color: var(--color-text-on-dark);
  }

  .tours-closing__inner h2 {
    margin: 0 0 var(--space-2xs);
    color: var(--color-text-on-dark);
  }

  .tours-closing__inner p {
    color: var(--color-sand-200);
    margin: 0 0 var(--space-lg);
  }

  .tours-closing__ctas {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
