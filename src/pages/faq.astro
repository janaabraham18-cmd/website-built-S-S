---
import BaseLayout from '../layouts/BaseLayout.astro';
import { hl } from '../utils/text';

const bgPhoto = {
  url: 'https://images.unsplash.com/photo-1539527783216-403e0d1b6747?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=2200',
  credit: { name: 'Alan J. Hendry', username: 'imedianamibia' },
};

// Split into two categories, shown as side-by-side columns (see
// .faq-categories below) instead of one long single list — booking
// logistics specific to us on the left, general Namibia trip-prep
// questions on the right. Each category label is a 2-word heading, so
// per the site's one-accent-word rule it's the last word that gets hl().
const faqCategories = [
  {
    label: 'Booking & Planning',
    accentWord: 'Planning',
    items: [
      {
        q: 'Do I need to book in advance?',
        a: "Most tours can be arranged with a few days' notice, but popular dates fill up faster in peak season.",
      },
      {
        q: 'Where do tours depart from?',
        a: "Most tours depart from Swakopmund or Walvis Bay; we'll confirm your pick-up point when we plan your day.",
      },
      {
        q: 'Can tours be combined?',
        a: 'Yes — many guests pair a tour with a shorter adventure. Use Chart Your Own Day on the booking page to build the combination yourself.',
      },
      {
        q: 'How and when do I pay?',
        a: "There's no payment due when you submit a booking request — it's a no-obligation enquiry. We'll confirm availability and payment details with you directly once we've planned out your day (or your Journey).",
      },
      {
        q: 'What if the weather turns, or I need to cancel?',
        a: "Some activities — skydiving and paragliding especially — are weather-dependent, and we'll always reschedule rather than run something unsafe. Get in touch as early as you can if your plans change; we handle cancellations case by case rather than a one-size-fits-all policy.",
      },
      {
        q: 'Do I need a group to book, or can I travel solo?',
        a: 'Most tours and adventures welcome solo travelers — a handful need a minimum headcount to run, which is noted on the tour itself and flagged when you enquire. Self-drive Journeys work for any group size, including one.',
      },
      {
        q: 'Are your tours suitable for children or travelers with mobility needs?',
        a: "It depends on the activity — vehicle-based tours and Journeys are generally easy to adapt, while things like sandboarding, quad biking, or skydiving have their own age and fitness guidelines. Tell us about your group when you enquire and we'll help you find the right fit.",
      },
    ],
  },
  {
    label: 'Travel Essentials',
    accentWord: 'Essentials',
    items: [
      {
        q: 'What should I bring?',
        a: "Comfortable shoes, sun protection, and a camera; we'll flag anything tour-specific when we confirm your booking.",
      },
      {
        q: 'Is tipping expected?',
        a: "Gratuities aren't included in any tour or Journey and are entirely up to you — most guests tip their guide or driver for a day well spent, but it's never expected.",
      },
      {
        q: 'What do I need to bring or arrange for a self-drive Journey?',
        a: "A valid driver's license and a vehicle suited to Namibia's gravel roads — a 4x4 for our camping safaris. We plan the route and book the stops either way; for camping Journeys we can also point you to vehicle and camping-gear hire. Each Journey's own page lists exactly what's included and what isn't.",
      },
      {
        q: 'What currency should I bring?',
        a: "Namibia's currency is the Namibian Dollar, pegged 1:1 to the South African Rand — Rand notes are accepted everywhere too. Cards work fine in Swakopmund and Walvis Bay, but it's worth carrying some cash for tips, fuel, and small stops along the way.",
      },
      {
        q: 'Do I need a visa to visit Namibia?',
        a: "It depends on your passport — many nationalities can enter Namibia visa-free for tourist stays, but requirements change, so check with the Namibian Ministry of Home Affairs or your nearest embassy before you travel. You'll also need a passport valid for at least 6 months beyond your travel dates.",
      },
      {
        q: 'What language do your guides speak?',
        a: "English — it's Namibia's official language, so it's also what you'll hear day-to-day around Swakopmund and Walvis Bay. Let us know when booking if you'd like anything arranged in another language.",
      },
      {
        q: 'Can I bring a drone?',
        a: "Drones are restricted in Namibia's national parks — Etosha, the Skeleton Coast, and Namib-Naukluft among them — and usually need a permit arranged in advance. Let us know if you're planning to fly one so we can advise for the areas your tour or Journey covers.",
      },
    ],
  },
];
---

<BaseLayout
  title="FAQ"
  description="Answers to common questions about booking, departures, and planning a tour with Salt and Sun Tours in Namibia."
>
  <div class="faq-page">
    <div class="faq-page__bg" style={`background-image:url('${bgPhoto.url}')`} aria-hidden="true"></div>
    <div class="faq-page__scrim" aria-hidden="true"></div>

    <header class="faq-header">
      <div class="container">
        <p class="faq-header__eyebrow">Before You Go</p>
        <h1 class="faq-header__heading" set:html={hl('A few things people ask', 'ask')} />
        <p class="faq-header__body">
          The questions that come up most before a booking — if yours isn't
          here, get in touch and we'll answer it directly.
        </p>
      </div>
    </header>

    <section class="faq-section reveal">
      <div class="container">
        <div class="faq-categories reveal-item">
          {
            faqCategories.map((category) => (
              <div class="faq-category">
                <h2 class="faq-category__title" set:html={hl(category.label, category.accentWord)} />
                <div class="faq-list">
                  {category.items.map((item) => (
                    <details class="faq-item">
                      <summary>{item.q}</summary>
                      <p>{item.a}</p>
                    </details>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <p class="faq-more">Have a different question? <a href="/contact">Get in touch</a>.</p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* Same "fully defined" treatment as contact/booking: one continuous
     background photo at full strength behind the whole page. A soft
     gradient (not a boxed card) darkens the top, behind the header copy,
     and clears before the FAQ list starts. */
  .faq-page {
    position: relative;
    z-index: 0;
  }

  .faq-page__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center 60%;
    background-color: var(--color-earth-700);
  }

  .faq-page__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgba(31, 18, 14, 0.7) 0%, rgba(31, 18, 14, 0.3) 40%, rgba(31, 18, 14, 0) 65%);
  }

  .faq-header {
    position: relative;
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .faq-header__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--color-sand-100);
    margin-bottom: var(--space-2xs);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
  }

  .faq-header__heading {
    color: var(--color-text-on-dark);
    margin-bottom: var(--space-md);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
  }

  .faq-header__body {
    font-size: var(--fs-md);
    line-height: var(--lh-normal);
    color: var(--color-sand-200);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.4);
    max-width: var(--content-width-narrow);
    margin: 0;
  }

  .faq-section {
    position: relative;
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .faq-categories {
    max-width: var(--content-width);
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
    gap: var(--space-xl);
  }

  .faq-category__title {
    color: var(--color-text-on-dark);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.45);
    font-size: var(--fs-lg);
    margin: 0 0 var(--space-md);
  }

  .faq-list {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  @media (max-width: 860px) {
    .faq-categories {
      grid-template-columns: 1fr;
      gap: var(--space-2xl);
    }
  }

  .faq-item {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.4rem;
    box-shadow: var(--shadow-sm);
  }

  .faq-item summary {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }

  .faq-item summary::after {
    content: '+';
    float: right;
    font-family: var(--font-body);
    color: var(--color-accent-strong);
  }
  .faq-item[open] summary::after { content: '\2212'; }

  .faq-item p {
    margin: 0.9rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .faq-more {
    text-align: center;
    color: var(--color-text-on-dark);
    text-shadow: 0 1px 4px rgba(58, 35, 28, 0.6);
    margin: 2rem 0 0;
  }
  .faq-more a { color: var(--color-ochre-400); font-weight: 600; }

  @media (max-width: 640px) {
    .faq-item {
      padding: 1rem 1.1rem;
    }
  }
</style>
